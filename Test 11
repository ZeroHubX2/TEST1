        if not (okP and LobbyPackets) then setStatus("Lobby packets not found") return end
        JoinBusy = true
        Joining = true
        task.spawn(function()
            while JoinBusy do
                if ZeroX.Unloaded or Env.AZ_Session ~= SessionId then Joining = false end
                task.wait(0.25)
            end
        end)
        local t0 = os.clock()
        while Joining and not character() and os.clock() - t0 < 15 do task.wait(0.5) end
        if Joining and character() then
            local ok, err = pcall(tryJoinBody)
            if not ok then
                addLog("Join error: " .. tostring(err))
                setStatus("Error, retrying shortly")
            end
        elseif Joining then
            setStatus("No character yet, retrying shortly")
        end
        pcall(steerOff)
        restoreIdentity()
        Joining = false
        JoinBusy = false
    end


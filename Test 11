        connect(hit.MouseLeave, function() hovering = false; knobLook() end)
        connect(hit.InputBegan, function(i)
            if not isPress(i) then return end
            dragging = true
            bubble.Visible = true
            knobLook()
            commit(fromX(i.Position.X), true)
        end)
        connect(UIS.InputChanged, function(i)

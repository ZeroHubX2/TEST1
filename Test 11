        function Lib.SetupWindow(wf, body)
            local fit = Instance.new("UIScale")
            fit.Name = "ZX_Fit"
            fit.Parent = body
            local cascadeScale = wf:FindFirstChildOfClass("UIScale")
            local function maximized() return body.Size.X.Scale > 0 or body.Size.Y.Scale > 0 end
            local function minimized()
                local m = false
                pcall(function() if cw.Minimized then m = true end end)
                return m or (cascadeScale and cascadeScale.Scale < 0.999)
            end
            local function refit()
                if maximized() then fit.Scale = 1 return end
                local vp = viewport()
                local w, h = math.max(body.Size.X.Offset, 1), math.max(body.Size.Y.Offset, 1)
                fit.Scale = math.clamp(math.min((vp.X - 24) / w, (vp.Y - 24) / h, 1), 0.35, 1)
            end
            local function clampPos()
                if maximized() or minimized() then return end
                local vp = viewport()
                local p = body.Position
                local cx, cy = p.X.Scale * vp.X + p.X.Offset, p.Y.Scale * vp.Y + p.Y.Offset
                local hw, hh = body.AbsoluteSize.X / 2, body.AbsoluteSize.Y / 2
                local nx = (hw * 2 >= vp.X) and vp.X / 2 or math.clamp(cx, hw, vp.X - hw)
                local ny = (hh * 2 >= vp.Y) and vp.Y / 2 or math.clamp(cy, hh, vp.Y - hh)
                if math.abs(nx - cx) > 0.5 or math.abs(ny - cy) > 0.5 then
                    body.Position = UDim2.fromOffset(nx, ny)
                end
            end
            local function snapshot()
                if maximized() or minimized() then return false end
                local sz, p = body.Size, body.Position
                Lib.WinState.size = { sz.X.Offset, sz.Y.Offset }
                Lib.WinState.pos = { p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset }
                return true
            end
            local ready = false
            task.delay(1.5, function() ready = true end)
            local function track()
                if ready and snapshot() and Lib.QueueSave then Lib:QueueSave() end
            end
            connect(body:GetPropertyChangedSignal("Size"), function() refit(); track() end)
            connect(body:GetPropertyChangedSignal("Position"), track)
            if workspace.CurrentCamera then
                connect(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"), function()
                    refit()
                    task.defer(clampPos)
                end)
            end
            local function applyNow(data)
                if type(data.__size) == "table" then
                    local w, h = tonumber(data.__size[1]), tonumber(data.__size[2])
                    if w and h then body.Size = UDim2.fromOffset(math.max(w, 420), math.max(h, 280)) end
                end
                if type(data.__pos) == "table" then
                    local a = data.__pos
                    body.Position = UDim2.new(tonumber(a[1]) or 0.5, tonumber(a[2]) or 0, tonumber(a[3]) or 0.5, tonumber(a[4]) or 0)
                end
                if type(data.__btn) == "table" and Lib.PlaceToggleButton then Lib.PlaceToggleButton(data.__btn) end
                refit()
                task.defer(clampPos)
                snapshot()
            end
            Lib.ApplyWindowState = function(data)
                task.delay(0.1, applyNow, data)
            end
            refit()
            task.defer(clampPos)
            snapshot()
            if Lib._pendingWin then
                local d = Lib._pendingWin
                Lib._pendingWin = nil
                Lib.ApplyWindowState(d)
            end
        end

        Lib.FPS, Lib.Ping, Lib.Frames = 0, 0, 0
        local frames, started = 0, os.clock()
        Lib.StartedAt = started
        connect(RunService.RenderStepped, function() frames = frames + 1; Lib.Frames = Lib.Frames + 1 end)
        task.spawn(function()
            local last = os.clock()
            while not Lib.Unloaded do
                task.wait(1)
                local now = os.clock()
                Lib.FPS = math.floor(frames / (now - last) + 0.5)
                frames, last = 0, now
                local ok, ping = pcall(function() return LP:GetNetworkPing() * 1000 end)
                Lib.Ping = ok and math.floor(ping + 0.5) or 0
            end
        end)

        task.spawn(function()
            while not Lib.Unloaded do
                local m = false
                pcall(function() if Lib.GUI and not Lib.GUI.Enabled then m = true end end)
                pcall(function() if cw.Minimized then m = true end end)
                Window.Minimized = m and true or false
                task.wait(0.2)
            end
        end)

        task.spawn(function()
            local gui
            for _ = 1, 40 do
                pcall(function()
                    local inst = rawget(App, "__instance") or App.__instance
                    if typeof(inst) == "Instance" and inst:IsA("ScreenGui") then gui = inst end
                end)
                gui = gui or findNewGui()
                if gui or Lib.Unloaded then break end
                task.wait(0.25)
            end
            if not gui then
                warn("[Zero Hub] Cascade ScreenGui not found")
                return
            end
            Lib.GUI = gui
            pcall(function() gui.DisplayOrder = 1000000 end)

            local function liftMenu(sg)
                if not (sg:IsA("ScreenGui") and sg.Name == "Container") then return end
                task.defer(function()
                    if sg:FindFirstChild("MenuBody") then
                        pcall(function()
                            sg.DisplayOrder = 1000005
                            sg.OnTopOfCoreBlur = true
                            sg.AutoLocalize = false
                            if gui and gui.Parent then
                                sg.Parent = gui
                            end
                            local mb = sg:FindFirstChild("MenuBody")
                            if mb then
                                mb.ZIndex = 100
                                for _, d in ipairs(mb:GetDescendants()) do
                                    if d:IsA("GuiObject") then
                                        d.ZIndex = math.max(d.ZIndex, 100)
                                    end
                                end
                            end
                        end)
                    end
                end)
            end
            for _, cont in ipairs(containers) do
                pcall(function()
                    for _, ch in ipairs(cont:GetChildren()) do liftMenu(ch) end
                    connect(cont.ChildAdded, liftMenu)
                end)
            end

            connect(gui:GetPropertyChangedSignal("Enabled"), function()
                if not gui.Enabled then
                    if Lib._dropdowns then
                        for _, d in ipairs(Lib._dropdowns) do pcall(d.close) end
                    end
                    for _, cont in ipairs(containers) do
                        pcall(function()
                            for _, ch in ipairs(cont:GetChildren()) do
                                if ch:IsA("ScreenGui") and ch.Name == "Container" then
                                    ch.Enabled = false
                                end
                            end
                        end)
                    end
                end
            end)

            local function noLoc(o) pcall(function() o.AutoLocalize = false end) end
            noLoc(gui)
            for _, d in ipairs(gui:GetDescendants()) do noLoc(d) end
            connect(gui.DescendantAdded, noLoc)
            local wf = gui:FindFirstChild("Window")
            local body = wf and wf:FindFirstChild("Body")
            if body then
                safe(Lib.SetupWindow, wf, body)
            else
                warn("[Zero Hub] Cascade window body not found; size/position won't be saved")
            end
            if Lib.OnToggle then pcall(Lib.OnToggle) end
            connect(gui.AncestryChanged, function()
                if not gui.Parent then Lib.Unloaded = true end
            end)
        end)

        return Window
    end

    function Lib:Notify(ncfg)
        pcall(function()
            App:Notification({
                Title = ncfg.Title or "Zero Hub",
                Subtitle = ncfg.Content or "",
                App = "Zero Hub",
                AppIcon = LOGO,
                Duration = ncfg.Duration or 4,
            })
        end)
    end

    function Lib:Destroy()
        if Lib.Unloaded then return end
        Lib.Unloaded = true
        for _, c in ipairs(Lib.Conns) do pcall(function() c:Disconnect() end) end
        Lib.Conns = {}
        pcall(function() App:Destroy() end)
        if Lib.Window then pcall(function() Lib.Window.Cascade:Destroy() end) end
        if Lib.GUI then pcall(function() Lib.GUI:Destroy() end) end
        if Lib.ToggleGui then pcall(function() Lib.ToggleGui:Destroy() end) end
        purgeOldGuis()
    end

    return Lib
end)()


    local function makeSlider(host, min, max, fmt, commit)
        local TEXT, BOX, BOXLINE = Color3.fromRGB(235, 235, 240), Color3.fromRGB(44, 44, 50), Color3.fromRGB(90, 90, 98)
        local holder = inst("Frame", { Name = "ZX_Slider", BackgroundTransparency = 1, Size = UDim2.fromOffset(222, 28) }, nil)

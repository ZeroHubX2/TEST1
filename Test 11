            function tab:AddSlider(id, ocfg)
                local min, max, dec = ocfg.Min, ocfg.Max, ocfg.Rounding or 0
                local title = tostring(ocfg.Title or "")
                local name, unit = title:match("^(.-)%s*%((.-)%)%s*$")
                if not name or name == "" then name, unit = title, nil end
                local r = newRow(cur(), name, ocfg.Description, 130, true)
                local opt = makeOption(id, "Slider", ocfg)
                local function rnd(v)
                    local m = 10 ^ dec
                    return math.floor(v * m + 0.5) / m
                end
                local function fmt(v) return (dec > 0) and string.format("%." .. dec .. "f", v) or tostring(math.floor(v + 0.5)) end
                opt.Value = math.clamp(rnd(tonumber(ocfg.Default) or min), min, max)
                local vb = inst("TextButton", {
                    Name = "Value", Text = "", AutoButtonColor = false, BackgroundColor3 = C.Raise, BackgroundTransparency = 0.3, BorderSizePixel = 0,
                    AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 36),
                }, r.right)
                round(vb, 12)
                pad(vb, 14, 14, 0, 0)
                list(vb, Enum.FillDirection.Horizontal, 5, nil, Enum.VerticalAlignment.Center)
                local vbLine = stroke(vb, 1)
                local box = inst("TextBox", {
                    BackgroundTransparency = 1, FontFace = F.Semi, TextSize = 15, TextColor3 = C.Text, Text = "",
                    ClearTextOnFocus = false, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 36), LayoutOrder = 1,
                }, vb)
                inst("UISizeConstraint", { MinSize = Vector2.new(28, 0) }, box)
                connect(vb.MouseButton1Click, function() box:CaptureFocus() end)
                connect(box.Focused, function()
                    vbLine.Color = accent()
                    vbLine.Transparency = 0
                    pcall(function()
                        box.CursorPosition = #box.Text + 1
                        box.SelectionStart = 1
                    end)
                end)
                if unit and unit ~= "" then
                    text({ Text = unit, FontFace = F.Med, TextSize = 13, TextColor3 = C.Sub, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 36), LayoutOrder = 2 }, vb)
                end
                local area = r.below(36)
                local hit = inst("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Position = UDim2.fromOffset(42, 0), Size = UDim2.new(1, -84, 0, 32) }, area)
                local trk = inst("Frame", {
                    AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 0), Size = UDim2.new(1, -24, 0, 6),
                    BackgroundColor3 = C.Raise, BorderSizePixel = 0,
                }, hit)
                round(trk)
                stroke(trk, 0.9)
                local fill = inst("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = accent(), BorderSizePixel = 0 }, trk)
                round(fill)
                inst("UIGradient", { Color = ColorSequence.new(Color3.fromRGB(120, 120, 120), Color3.new(1, 1, 1)) }, fill)
                local knob = inst("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(20, 20),
                    BackgroundColor3 = C.Bg, BorderSizePixel = 0, ZIndex = 2,
                }, trk)
                round(knob)
                local kring = inst("UIStroke", { Color = accent(), Thickness = 3 }, knob)
                local kdot = inst("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(6, 6),
                    BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 3,
                }, knob)
                round(kdot)
                local bubble = text({
                    Text = "", FontFace = F.Bold, TextSize = 12, TextColor3 = Color3.new(1, 1, 1), BackgroundColor3 = accent(), BackgroundTransparency = 0,
                    AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0, -8), AutomaticSize = Enum.AutomaticSize.X,
                    Size = UDim2.fromOffset(0, 20), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 4, Visible = false,
                }, knob)
                round(bubble, 6)
                pad(bubble, 7, 7, 0, 0)
                local bscale = inst("UIScale", { Scale = 0 }, bubble)
                onAccent(function(c)
                    fill.BackgroundColor3 = c
                    kring.Color = c
                    bubble.BackgroundColor3 = c
                end)
                local tws = {}
                local function render(v, anim)
                    local a = (max > min) and math.clamp((v - min) / (max - min), 0, 1) or 0
                    for _, x in ipairs(tws) do x:Cancel() end
                    table.clear(tws)
                    if anim and Lib.FX then
                        tws[1] = ease(fill, 0.3, { Size = UDim2.fromScale(a, 1) })
                        tws[2] = ease(knob, 0.3, { Position = UDim2.fromScale(a, 0.5) })
                    else
                        fill.Size = UDim2.fromScale(a, 1)
                        knob.Position = UDim2.fromScale(a, 0.5)
                    end
                    if not box:IsFocused() then box.Text = fmt(v) end
                    bubble.Text = fmt(v) .. (unit and unit ~= "" and (" " .. unit) or "")
                end
                local function commit(v, anim)
                    if v == nil then render(opt.Value, anim) return end
                    v = math.clamp(rnd(v), min, max)
                    render(v, anim)
                    if v == opt.Value then return end
                    opt.Value = v
                    opt:_fire()
                end
                local function fromX(x)
                    local a = math.clamp((x - trk.AbsolutePosition.X) / math.max(trk.AbsoluteSize.X, 1), 0, 1)
                    return min + a * (max - min)
                end
                local step = dec > 0 and 10 ^ -dec or 1
                local held = { n = 0 }
                for _, dir in ipairs({ -1, 1 }) do
                    local sb = inst("TextButton", {
                        Name = dir < 0 and "Minus" or "Plus", Text = dir < 0 and "-" or "+", FontFace = F.Bold, TextSize = 20,
                        TextColor3 = C.Text, AutoButtonColor = false, BackgroundColor3 = C.Raise, BackgroundTransparency = 0.3,
                        BorderSizePixel = 0, AnchorPoint = Vector2.new(dir < 0 and 0 or 1, 0.5),
                        Position = UDim2.new(dir < 0 and 0 or 1, 0, 0.5, -2), Size = UDim2.fromOffset(34, 34),
                    }, area)
                    round(sb)
                    connect(sb.InputBegan, function(i)
                        if not isPress(i) then return end
                        held.n = held.n + 1
                        local my = held.n
                        sb.BackgroundColor3 = C.Hover
                        commit(opt.Value + dir * step, true)
                        task.delay(0.4, function()
                            while held.n == my and not Lib.Unloaded do
                                commit(opt.Value + dir * step)
                                task.wait(0.07)
                            end
                        end)
                    end)
                    connect(sb.InputEnded, function(i)
                        if not isPress(i) then return end
                        held.n = held.n + 1
                        sb.BackgroundColor3 = C.Raise
                    end)
                    connect(sb.MouseLeave, function()
                        held.n = held.n + 1
                        sb.BackgroundColor3 = C.Raise
                    end)
                end
                local dragging = false
                connect(hit.InputBegan, function(i)
                    if not isPress(i) then return end
                    dragging = true
                    if Lib.FX then
                        ease(knob, 0.2, { Size = UDim2.fromOffset(26, 26) }, Enum.EasingStyle.Back)
                        bubble.Visible = true
                        ease(bscale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
                    end
                    commit(fromX(i.Position.X), Lib.FX)
                end)
                connect(UIS.InputChanged, function(i)
                    if dragging and isMove(i) then commit(fromX(i.Position.X)) end
                end)
                connect(UIS.InputEnded, function(i)
                    if dragging and isPress(i) then
                        dragging = false
                        ease(knob, 0.25, { Size = UDim2.fromOffset(20, 20) }, Enum.EasingStyle.Back)
                        ease(bscale, 0.15, { Scale = 0 }, Enum.EasingStyle.Quad)
                        task.delay(0.16, function() if not dragging then bubble.Visible = false end end)
                    end
                end)
                connect(box.FocusLost, function()
                    vbLine.Transparency = 1
                    commit(tonumber((box.Text:gsub("[^%d%.%-]", ""))), true)
                end)
                render(opt.Value)
                function opt:SetValue(v)
                    v = math.clamp(rnd(tonumber(v) or self.Value or min), min, max)
                    render(v, true)
                    if v == self.Value then return end
                    self.Value = v
                    self:_fire()
                end
                return opt
            end

            function tab:AddInput(id, ocfg)
                local r = newRow(cur(), ocfg.Title, ocfg.Description, 160, true)
                local opt = makeOption(id, "Input", ocfg)
                local function norm(v)
                    if ocfg.Numeric then
                        local n = tonumber(v)
                        if not n then return nil end
                        if ocfg.Min then n = math.max(ocfg.Min, n) end
                        if ocfg.Max then n = math.min(ocfg.Max, n) end
                        return math.floor(n)
                    end
                    return tostring(v or "")
                end
                opt.Value = norm(ocfg.Default)
                local field = inst("TextBox", {
                    BackgroundColor3 = C.Raise, BackgroundTransparency = 0.3, BorderSizePixel = 0, Size = UDim2.fromOffset(160, 40),
                    FontFace = F.Semi, TextSize = 14, TextColor3 = C.Text, PlaceholderText = ocfg.Placeholder or "", PlaceholderColor3 = C.Dim,
                    Text = opt.Value ~= nil and tostring(opt.Value) or "", ClearTextOnFocus = false, TextTruncate = Enum.TextTruncate.AtEnd,
                }, r.right)
                round(field, 12)
                pad(field, 12, 12, 0, 0)
                local fs = stroke(field, 1)
                connect(field.Focused, function()
                    fs.Color = accent()
                    fs.Transparency = 0
                end)
                connect(field.FocusLost, function()
                    fs.Transparency = 1
                    local nv = norm(field.Text)
                    if nv == nil then nv = opt.Value end
                    field.Text = nv ~= nil and tostring(nv) or ""
                    if nv == opt.Value then return end
                    opt.Value = nv
                    opt:_fire()
                end)
                function opt:SetValue(v)
                    local nv = norm(v)
                    if nv == nil then nv = self.Value end
                    field.Text = nv ~= nil and tostring(nv) or ""
                    if nv == self.Value then return end
                    self.Value = nv
                    self:_fire()
                end
                return opt
            end

            function tab:AddDropdown(id, ocfg)
                local opt = makeOption(id, "Dropdown", ocfg)
                local multi = ocfg.Multi and true or false
                opt.Multi, opt.Values = multi, ocfg.Values or {}
                local r = newRow(cur(), ocfg.Title, ocfg.Description, 170, true)
                local btn = inst("TextButton", {
                    Name = "Dropdown", Text = "", AutoButtonColor = false, BackgroundColor3 = C.Raise, BackgroundTransparency = 0,
                    BorderSizePixel = 0, Size = UDim2.fromOffset(170, 40),
                }, r.right)
                round(btn, 11)
                local bline = stroke(btn, 0.88)
                local bar = inst("Frame", {
                    BackgroundColor3 = accent(), BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 8, 0.5, 0),
                    Size = UDim2.fromOffset(3, 16),
                }, btn)
                round(bar)
                local lbl = text({
                    Text = "", FontFace = F.Semi, TextSize = 14, Position = UDim2.fromOffset(19, 0), Size = UDim2.new(1, -54, 1, 0),
                    TextTruncate = Enum.TextTruncate.AtEnd,
                }, btn)
                local cbg = inst("Frame", {
                    BackgroundColor3 = C.Hover, BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
                    Size = UDim2.fromOffset(24, 24),
                }, btn)
                round(cbg, 7)
                local chev = icon("chevron", 12, cbg, C.Text)
                chev.AnchorPoint = Vector2.new(0.5, 0.5)
                chev.Position = UDim2.fromScale(0.5, 0.5)
                onAccent(function(c) bar.BackgroundColor3 = c end)
                press(btn)
                connect(btn.MouseEnter, function()
                    tw(btn, 0.15, { BackgroundColor3 = C.Hover })
                    tw(bline, 0.15, { Color = accent(), Transparency = 0.5 })
                    tw(bar, 0.15, { Size = UDim2.fromOffset(3, 22) })
                end)
                connect(btn.MouseLeave, function()
                    tw(btn, 0.2, { BackgroundColor3 = C.Raise })
                    if not W.ddOpen or W.ddOpen ~= btn then tw(bline, 0.2, { Color = C.Line, Transparency = 0.88 }) end
                    tw(bar, 0.2, { Size = UDim2.fromOffset(3, 16) })
                end)

                local function has(v)
                    for _, x in ipairs(opt.Values) do if x == v then return true end end
                    return false
                end
                local function toSet(v)
                    local s = {}
                    if type(v) == "table" then
                        for k, x in pairs(v) do
                            if type(k) == "number" then s[x] = true elseif x then s[k] = true end
                        end
                    end
                    return s
                end
                local function normalize(v)
                    if type(v) == "number" then return opt.Values[v] end
                    return v
                end
                local function refresh()
                    if multi then
                        local picked = {}
                        for _, x in ipairs(opt.Values) do if opt.Value[x] then picked[#picked + 1] = tostring(x) end end
                        if #picked == 0 then lbl.Text = "None"
                        elseif #picked == 1 then lbl.Text = picked[1]
                        else lbl.Text = picked[1] .. ", +" .. (#picked - 1) end
                    else
                        lbl.Text = opt.Value ~= nil and tostring(opt.Value) or "-"
                    end
                end
                if multi then
                    opt.Value = toSet(ocfg.Default)
                else
                    opt.Value = normalize(ocfg.Default)
                    if not has(opt.Value) then opt.Value = opt.Values[1] end
                end
                refresh()

                local menuOpen = false
                local function openMenu()
                    local vals = opt.Values
                    local n = #vals
                    local itemH = 40
                    local filter = n > 6
                    local headH = 50
                    local h = headH + (filter and 46 or 0) + math.min(math.max(n, 1), 6) * (itemH + 3) + 10
                    local s = math.max(fit.Scale, 0.01)
                    local w = math.max(btn.AbsoluteSize.X / s, 240)
                    local f = openPopup(btn, w, h)
                    local fullH = f.Size.Y.Offset
                    f.ClipsDescendants = true
                    if Lib.FX then
                        f.Size = UDim2.fromOffset(f.Size.X.Offset, 0)
                        ease(f, 0.35, { Size = UDim2.fromOffset(f.Size.X.Offset, fullH) })
                    end
                    menuOpen = true
                    W.ddOpen = btn
                    ease(chev, 0.3, { Rotation = 180 }, Enum.EasingStyle.Back)
                    tw(cbg, 0.2, { BackgroundColor3 = accent() })
                    tw(bline, 0.2, { Color = accent(), Transparency = 0.2 })
                    Pop.onClose = function()
                        menuOpen = false
                        if W.ddOpen == btn then W.ddOpen = nil end
                        ease(chev, 0.3, { Rotation = 0 }, Enum.EasingStyle.Back)
                        tw(cbg, 0.2, { BackgroundColor3 = C.Hover })
                        tw(bline, 0.25, { Color = C.Line, Transparency = 0.88 })
                        if opt._pendingValues then
                            local pv = opt._pendingValues
                            opt._pendingValues = nil
                            task.defer(function() opt:SetValues(pv) end)
                        end
                    end
                    local head = inst("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, headH), ZIndex = 52 }, f)
                    local hbar = inst("Frame", { BackgroundColor3 = accent(), BorderSizePixel = 0, Position = UDim2.fromOffset(14, 15), Size = UDim2.fromOffset(3, 20), ZIndex = 52 }, head)
                    round(hbar)
                    text({
                        Text = tostring(ocfg.Title or "Select"), FontFace = F.Bold, TextSize = 14, Position = UDim2.fromOffset(25, 9),
                        Size = UDim2.new(1, -110, 0, 18), TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 52,
                    }, head)
                    local cnt = text({
                        Text = "", FontFace = F.Med, TextSize = 12, TextColor3 = C.Sub, Position = UDim2.fromOffset(25, 27),
                        Size = UDim2.new(1, -110, 0, 15), ZIndex = 52,
                    }, head)
                    inst("Frame", { BackgroundColor3 = C.Line, BackgroundTransparency = 0.92, BorderSizePixel = 0, Position = UDim2.new(0, 10, 1, -1), Size = UDim2.new(1, -20, 0, 1), ZIndex = 52 }, head)
                    local items = {}
                    local paintItems
                    local function count()
                        if multi then
                            local k = 0
                            for _, x in ipairs(opt.Values) do if opt.Value[x] then k = k + 1 end end
                            cnt.Text = k .. " of " .. n .. " selected"
                        else
                            cnt.Text = n .. (n == 1 and " option" or " options")
                        end
                    end
                    if multi then
                        local hb = inst("Frame", {
                            BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
                            AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 26), ZIndex = 52,
                        }, head)
                        list(hb, Enum.FillDirection.Horizontal, 6, nil, Enum.VerticalAlignment.Center)
                        for k, lab in ipairs({ "All", "Clear" }) do
                            local qb = inst("TextButton", {
                                Text = lab, FontFace = F.Semi, TextSize = 12, TextColor3 = C.Text, AutoButtonColor = false, BackgroundColor3 = C.Raise,
                                BorderSizePixel = 0, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 26), LayoutOrder = k, ZIndex = 52,
                            }, hb)
                            round(qb, 8)
                            pad(qb, 10, 10, 0, 0)
                            qb.MouseButton1Click:Connect(function()
                                for _, x in ipairs(opt.Values) do opt.Value[x] = (k == 1) or nil end
                                refresh()
                                paintItems(true)
                                count()
                                opt:_fire()
                            end)
                        end
                    end
                    local q
                    if filter then
                        q = inst("TextBox", {
                            BackgroundColor3 = C.Raise, BorderSizePixel = 0, Position = UDim2.fromOffset(10, headH + 6),
                            Size = UDim2.new(1, -20, 0, 34), FontFace = F.Med, TextSize = 13, TextColor3 = C.Text, PlaceholderText = "Filter",
                            PlaceholderColor3 = C.Sub, Text = "", ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 52,
                        }, f)
                        round(q, 9)
                        pad(q, 30, 10, 0, 0)
                        local qi = icon("search", 13, q, C.Sub)
                        qi.AnchorPoint = Vector2.new(0, 0.5)
                        qi.Position = UDim2.new(0, -20, 0.5, 0)
                        qi.ZIndex = 52
                    end
                    local top0 = headH + (filter and 46 or 0) + 4
                    local hl = inst("Frame", {
                        BackgroundColor3 = C.Hover, BorderSizePixel = 0, Size = UDim2.fromOffset(0, itemH), Visible = false, ZIndex = 51,
                    }, f)
                    round(hl, 10)
                    local sc = inst("ScrollingFrame", {
                        BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(6, top0),
                        Size = UDim2.new(1, -12, 1, -(top0 + 6)), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
                        ScrollingDirection = Enum.ScrollingDirection.Y, ScrollBarThickness = 3, ScrollBarImageColor3 = C.Dim, ZIndex = 52,
                    }, f)
                    list(sc, nil, 3)
                    local function moveHl(b)
                        local ps = math.max(f.AbsoluteSize.X / math.max(f.Size.X.Offset, 1), 0.01)
                        local rel = (b.AbsolutePosition - f.AbsolutePosition) / ps
                        local goal = { Position = UDim2.fromOffset(rel.X, rel.Y), Size = UDim2.fromOffset(b.AbsoluteSize.X / ps, itemH) }
                        if not hl.Visible or not Lib.FX then
                            hl.Position, hl.Size = goal.Position, goal.Size
                            hl.Visible = true
                        else
                            ease(hl, 0.2, goal)
                        end
                    end
                    sc.MouseLeave:Connect(function() hl.Visible = false end)
                    paintItems = function(anim)
                        for _, it in ipairs(items) do
                            local on
                            if multi then on = opt.Value[it.v] and true or false else on = opt.Value == it.v end
                            it.on = on
                            local t = anim and 0.18 or 0.01
                            tw(it.box, t, { BackgroundColor3 = on and accent() or C.Raise })
                            tw(it.boxLine, t, { Color = on and accent() or C.Line, Transparency = on and 0 or 0.8 })
                            tw(it.lbl, t, { TextColor3 = on and C.Text or C.Sub })
                            tw(it.b, t, { BackgroundTransparency = on and 0.7 or 1 })
                            it.bar.Visible = on
                            it.check.Visible = on
                            if on and anim then
                                it.check.Size = UDim2.fromOffset(0, 0)
                                ease(it.check, 0.3, { Size = UDim2.fromOffset(11, 11) }, Enum.EasingStyle.Back)
                            else
                                it.check.Size = UDim2.fromOffset(11, 11)
                            end
                        end
                    end
                    for i, v in ipairs(vals) do

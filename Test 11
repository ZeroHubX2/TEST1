            local tried = 0
            for _, pad in ipairs(pads()) do
                if not Joining then break end
                if padBusy(pad.room, pad.hit) then
                    addLog("Join: pad " .. pad.room.Name .. " is taken, skipping")
                else
                    tried = tried + 1
                    WindowRoom = nil
                    setStatus("Teleporting to pad " .. pad.room.Name)
                    local guiWasOpen = queueGuiOpen()
                    local function opened()
                        if leaveForeignRoom() then return false end
                        return WindowRoom ~= nil or (not guiWasOpen and queueGuiOpen())
                    end
                    local function tpTo(cf)
                        local _, hrp = character()
                        if not hrp then return end
                        pcall(function()
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            hrp.CFrame = cf
                        end)
                    end
                    local function tpOnPad()
                        tpTo(CFrame.new(pad.hit.Position))
                        local _, hrp = character()
                        if hrp and firetouchinterest then
                            pcall(firetouchinterest, hrp, pad.hit, 0)
                            task.wait()
                            pcall(firetouchinterest, hrp, pad.hit, 1)
                        end
                    end
                    steerOff()
                    tpOnPad()
                    local tw = os.clock()
                    while Joining and not opened() and os.clock() - tw < 1.5 do task.wait(0.1) end
                    if not opened() and padBusy(pad.room, pad.hit) then
                        setStatus("Pad " .. pad.room.Name .. " was taken, trying another")
                    else
                        if not opened() then
                            setStatus("Re-entering pad " .. pad.room.Name)
                            if pad.outside then tpTo(CFrame.new(pad.outside + Vector3.new(0, 3, 0))) end
                            task.wait(0.3)
                            tpOnPad()
                        end
                        local t0 = os.clock()
                        while Joining and not opened() and os.clock() - t0 < 5 do task.wait(0.2) end
                        if opened() and not WindowRoom then WindowRoom = tonumber(pad.room.Name) or pad.room.Name end

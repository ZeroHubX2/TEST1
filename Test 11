    local function getFloorEnemies(currentFloor, allEnemies)
        if currentFloor == 0 or workspace:GetAttribute("FloodRoof") == true then
            return allEnemies
        end
        local floorMarker = getFloorMarker(currentFloor)
        local floorY = floorMarker and floorMarker.Position.Y

    local function character()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hum and hrp and hum.Health > 0 then return hum, hrp end
    end

    local SteerDir = Vector3.zero
    local SteerConn
    local function steerOn()
        if SteerConn then return end
        SteerConn = RunService.RenderStepped:Connect(function()
            pcall(LocalPlayer.Move, LocalPlayer, SteerDir, false)
        end)
    end
    local function steerOff()
        SteerDir = Vector3.zero
        if SteerConn then SteerConn:Disconnect(); SteerConn = nil end
        pcall(LocalPlayer.Move, LocalPlayer, Vector3.zero, false)
    end

    local function steer(hum, hrp, point, timeout, stop)
        local t0 = os.clock()
        local lastPos, stuckSince = hrp.Position, os.clock()
        while (Joining or Delivering or ShopBusy or TraitBusy) and hum.Parent and hum.Health > 0 and os.clock() - t0 < timeout do
            if stop and stop() then return true end
            local d = point - hrp.Position
            local flat = Vector3.new(d.X, 0, d.Z)
            if flat.Magnitude < 2.5 then return true end
            SteerDir = flat.Unit
            if (hrp.Position - lastPos).Magnitude > 0.5 then
                lastPos, stuckSince = hrp.Position, os.clock()
            elseif os.clock() - stuckSince > 0.6 then
                hum.Jump = true
                stuckSince = os.clock()
            end
            RunService.RenderStepped:Wait()
        end
        return false
    end

    local function walkTo(goal, attempts, stop)
        attempts = attempts or 0
        if stop and stop() then return true end
        local hum, hrp = character()
        if not hum then return false end
        if (hrp.Position - goal).Magnitude < 6 then return true end
        steerOn()
        local ok = false
        local path = PathfindingService:CreatePath({ AgentRadius = 2.5, AgentHeight = 5.5, AgentCanJump = true, WaypointSpacing = 5 })
        local computed = pcall(function() path:ComputeAsync(hrp.Position, goal) end)
        if computed and path.Status == Enum.PathStatus.Success then
            ok = true
            for i, wp in ipairs(path:GetWaypoints()) do
                if not (Joining or Delivering or ShopBusy or TraitBusy) then ok = false break end
                if i > 1 then
                    if wp.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
                    if stop and stop() then break end
                    if not steer(hum, hrp, wp.Position, 4, stop) then ok = false break end
                end
            end
        end
        if ok or not computed or path.Status ~= Enum.PathStatus.Success then
            ok = steer(hum, hrp, goal, 8, stop) or ok
        end
        steerOff()
        if not ok and (Joining or Delivering or ShopBusy or TraitBusy) and attempts < 3 then return walkTo(goal, attempts + 1, stop) end
        return ok
    end

    local function padBusy(room, hit)
        local gui = room:FindFirstChild("RoomGui")
        if gui then
            local title = gui:FindFirstChild("Title", true)
            local players = gui:FindFirstChild("Players", true)
            if title and title:IsA("TextLabel") and title.Text ~= "Start Here" then return true end
            if players and players:IsA("GuiObject") and players.Visible then return true end
        end
        for _, plr in ipairs(Players:GetPlayers()) do
            local r = plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            if r and (r.Position - hit.Position).Magnitude < 14 then return true end
        end
        return false
    end

    local function pads()
        local list = {}
        local rooms = workspace:FindFirstChild("Systems") and workspace.Systems:FindFirstChild("QuqueRooms")
        local _, hrp = character()
        for _, room in ipairs(rooms and rooms:GetChildren() or {}) do
            local hit = room:FindFirstChild("JoinHitbox")
            local outside = room:FindFirstChild("Outside")
            if hit and hit:IsA("BasePart") then
                table.insert(list, {
                    room = room, hit = hit,
                    outside = (outside and outside:IsA("BasePart")) and outside.Position or nil,
                    dist = hrp and (hrp.Position - hit.Position).Magnitude or 0,
                })
            end
        end
        table.sort(list, function(a, b) return a.dist < b.dist end)
        return list
    end

    local function tryJoinBody()
        local s = joinSettings()
        setStatus(string.format("Looking for a pad: %s / %s%s", s.gamemode, s.map, s.gamemode == "Story" and (" Act " .. s.chapter) or ""))
        local tried = 0
        for _, pad in ipairs(pads()) do
            if not Joining then break end
            if padBusy(pad.room, pad.hit) then
                addLog("Join: pad " .. pad.room.Name .. " is taken, skipping")
            else
                tried = tried + 1
                WindowRoom = nil
                setStatus("Walking to pad " .. pad.room.Name)
                local guiWasOpen = queueGuiOpen()
                local function opened() return WindowRoom ~= nil or (not guiWasOpen and queueGuiOpen()) end
                if pad.outside then walkTo(pad.outside, nil, opened) end
                steerOff()
                if not opened() and padBusy(pad.room, pad.hit) then
                    setStatus("Pad " .. pad.room.Name .. " was taken, trying another")
                else
                    if not opened() then
                        setStatus("Stepping onto pad " .. pad.room.Name)
                        walkTo(pad.hit.Position, nil, opened)
                        steerOff()
                    end
                    local t0 = os.clock()
                    while Joining and not opened() and os.clock() - t0 < 5 do task.wait(0.2) end
                    if opened() and not WindowRoom then WindowRoom = tonumber(pad.room.Name) or pad.room.Name end
                    if WindowRoom then
                        s.roomNumber = WindowRoom
                        setStatus("Creating room " .. tostring(WindowRoom))
                        QueueState = nil
                        local pgui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
                        local q = pgui and (pgui:FindFirstChild("UI Animation (Finished)") or pgui:FindFirstChild("UI Animation (Working)"))
                        local quque = q and q:FindFirstChild("Quque")
                        local main = quque and quque:FindFirstChild("MainFrame")
                        local GuiClass
                        pcall(function() GuiClass = require(RS.global.utils.delightUtility).GuiClass end)
                        if main and main.Visible then
                            local mapsList = main:FindFirstChild("MapsList", true)
                            local sf = (mapsList and mapsList:FindFirstChild("ScrollingFrame", true)) or main:FindFirstChild("ScrollingFrame", true)
                            local card = sf and (sf:FindFirstChild(s.map) or sf:FindFirstChild(s.map == "Flood" and "Flood" or s.map))
                            if not card and sf then
                                for _, c in ipairs(sf:GetChildren()) do
                                    if c.Name:lower():find(s.map:lower()) then card = c break end
                                end
                            end
                            if card then
                                local cardBtn = card:FindFirstChild(card.Name) or card:FindFirstChildOfClass("ImageButton") or card
                                local cardObj = (GuiClass and cardBtn) and GuiClass.Get(cardBtn)
                                if cardObj and type(cardObj.Activate) == "function" then
                                    pcall(function() cardObj:Activate() end)
                                end
                                if cardBtn and firesignal then
                                    pcall(firesignal, cardBtn.MouseButton1Down)
                                    task.wait(0.05)
                                    pcall(firesignal, cardBtn.MouseButton1Up)
                                    pcall(firesignal, cardBtn.Activated)
                                end
                            end
                            task.wait(0.2)
                            local diffCont = main:FindFirstChild("Difficulty", true)
                            local diffName = Options.JoinDifficulty and Options.JoinDifficulty.Value or "Easy"
                            local diffCard = diffCont and diffCont:FindFirstChild(diffName, true)
                            if diffCard then
                                local hit = diffCard:FindFirstChild("Hit", true) or diffCard:FindFirstChildOfClass("TextButton") or diffCard:FindFirstChildOfClass("ImageButton")
                                if hit and firesignal then
                                    pcall(firesignal, hit.Activated)
                                    pcall(firesignal, hit.MouseButton1Down)
                                    task.wait(0.05)
                                    pcall(firesignal, hit.MouseButton1Up)
                                end
                            end
                            task.wait(0.2)
                            local sb = main:FindFirstChild("StaerButton", true)
                            local sbBtn = sb and (sb:FindFirstChild("StaerButton") or sb:FindFirstChildOfClass("ImageButton"))
                            local sbObj = (GuiClass and sbBtn) and GuiClass.Get(sbBtn)
                            if sbObj and type(sbObj.Activate) == "function" then
                                pcall(function() sbObj:Activate() end)
                            end
                            if sbBtn and firesignal then
                                pcall(firesignal, sbBtn.MouseButton1Down)
                                task.wait(0.05)
                                pcall(firesignal, sbBtn.MouseButton1Up)
                                pcall(firesignal, sbBtn.Activated)
                            end
                        end
                        pcall(function() LobbyPackets.createQuque:fire(s) end)
                        restoreIdentity()
                        local tc = os.clock()
                        while Joining and QueueState ~= "inQuque" and os.clock() - tc < 4 do
                            if quque and quque:FindFirstChild("StartNow") and quque.StartNow.Visible then break end
                            task.wait(0.2)
                        end
                        if QueueState ~= "inQuque" and not (quque and quque:FindFirstChild("StartNow") and quque.StartNow.Visible) then
                            addLog("Join: the server did not confirm the room (" .. tostring(QueueState) .. ")")
                        end
                        task.wait(0.5)
                        if Options.JoinSkipWait.Value then
                            setStatus("Starting (skip waiting)")
                            local startNow = quque and quque:FindFirstChild("StartNow")
                            if startNow and startNow.Visible then
                                local startObj = (GuiClass and startNow) and GuiClass.Get(startNow)
                                if startObj and type(startObj.Activate) == "function" then
                                    pcall(function() startObj:Activate() end)
                                end
                                if firesignal then
                                    pcall(firesignal, startNow.MouseButton1Down)
                                    task.wait(0.05)
                                    pcall(firesignal, startNow.MouseButton1Up)
                                    pcall(firesignal, startNow.Activated)
                                end
                            end
                            pcall(function() LobbyPackets.startQuqueNow:fire() end)
                            restoreIdentity()
                        else
                            setStatus("Waiting for players")
                        end
                        local tw, limit = os.clock(), Options.JoinSkipWait.Value and 45 or 180
                        while Joining and os.clock() - tw < limit do task.wait(0.5) end
                        break
                    else
                        setStatus("Pad " .. pad.room.Name .. " is busy, trying the next one")
                        if pad.outside then walkTo(pad.outside) end
                    end
                end

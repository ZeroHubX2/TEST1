    local function findActiveLever(currentFloor)
        local world = workspace:FindFirstChild("World")
        if not world then return nil end
        local map = world:FindFirstChild("Map")
        local floorMarker = getFloorMarker(currentFloor)
        local floorY = floorMarker and floorMarker.Position.Y

        for _, d in ipairs(world:GetDescendants()) do
            if d:IsA("ProximityPrompt") and d.Name == "FloodLeverPrompt" and d.Enabled then
                local part = d.Parent
                if part and part:IsA("BasePart") and (not floorY or math.abs(part.Position.Y - floorY) < 50) then
                    return d, part
                end
            end
        end

        if map and floorY then
            local bestLever, bestDistY = nil, 50
            for _, ch in ipairs(map:GetChildren()) do
                if ch.Name == "CONS_LEVER" then
                    local lever = ch:FindFirstChild("LEVER")
                    if lever and lever:IsA("BasePart") then
                        local dy = math.abs(lever.Position.Y - floorY)
                        if dy < bestDistY then
                            bestDistY = dy
                            local prompt = lever:FindFirstChild("FloodLeverPrompt") or lever:FindFirstChildOfClass("ProximityPrompt")
                            bestLever = { prompt = prompt, part = lever }
                        end
                    end
                end
            end
            if bestLever then
                return bestLever.prompt, bestLever.part
            end
        end
        return nil
    end

    local function useLever(hrp, target)
        if not (target and target.leverPrompt) or os.clock() - LastLeverPull < 0.8 then return end
        local prompt = target.leverPrompt
        local part = prompt.Parent or target.leverPart
        if not (part and part:IsA("BasePart")) then return end
        if (hrp.Position - part.Position).Magnitude > (prompt.MaxActivationDistance or 10) + 4 then return end
        LastLeverPull = os.clock()
        addLog("Pulling the gate lever...")
        pcall(function() prompt.HoldDuration = 0 end)
        if fireproximityprompt then
            pcall(fireproximityprompt, prompt)
            pcall(fireproximityprompt, prompt, 0)
        end
        pcall(function()
            prompt:InputHoldBegin()
            task.wait((prompt.HoldDuration or 1) + 0.05)
            prompt:InputHoldEnd()
        end)
    end

    local function isBossImmune()
        local gui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        local bb = gui and gui:FindFirstChild("BossBar")
        if bb and bb.Enabled then
            local header = bb:FindFirstChild("Header", true)
            local tag = header and header:FindFirstChild("Tag", true)
            if tag and tag:IsA("TextLabel") and (tag.Text:find("IMMUNE") or (tag:FindFirstChild("Txt") and tag.Txt.Text:find("IMMUNE"))) then
                return true
            end
        end
        if EnemyStore and EnemyStore.store and EnemyStore.store.state and EnemyStore.store.state.entries then
            for _, entry in pairs(EnemyStore.store.state.entries) do
                local name = read(entry.name)
                if isBoss(name) and read(entry.guardedAt) ~= nil then
                    return true
                end
            end
        end
        local folder = workspace:FindFirstChild("enemies")
        if folder then
            for _, m in ipairs(folder:GetChildren()) do
                for _, desc in ipairs(m:GetDescendants()) do
                    if desc:IsA("TextLabel") and desc.Text:find("IMMUNE") then
                        return true
                    end

local AnimConn, AnimBound
local function applyNoAnim(enabled)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local anim = hum and hum:FindFirstChildOfClass("Animator")
    if enabled and anim and not ZeroX.Unloaded then
        for _, t in ipairs(anim:GetPlayingAnimationTracks()) do
            pcall(function() t:Stop(0) end)
        end
        if AnimBound ~= anim then
            if AnimConn then AnimConn:Disconnect() end
            AnimBound = anim
            AnimConn = anim.AnimationPlayed:Connect(function(t)
                if Options.NoAnim and Options.NoAnim.Value and not ZeroX.Unloaded then
                    pcall(function() t:Stop(0) end)
                end
            end)
        end
    elseif not enabled then
        if AnimConn then AnimConn:Disconnect(); AnimConn = nil end
        AnimBound = nil
    end
end

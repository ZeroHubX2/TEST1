    redeemNow.running = false
    redeemNow.run = function()
        if redeemNow.running then return end
        redeemNow.running = true
        local remote = RS:FindFirstChild("RedeemCode") or RS:WaitForChild("RedeemCode", 5)
        if not remote then
            addLog("RedeemCode remote not found")
            redeemNow.running = false
            return
        end
        local seen, sent = {}, 0
        for _, code in ipairs(redeemNow.codes) do
            if ZeroX.Unloaded then break end
            if not seen[code] then
                seen[code] = true
                local ok = pcall(function()

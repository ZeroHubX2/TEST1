        end
        if Lib.FX then
            ease(c.frame, 0.3, { Position = UDim2.new(1.4, 0, 0, c.frame.Position.Y.Offset), GroupTransparency = 1 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)

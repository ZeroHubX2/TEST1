        local function tp(fn)
            local ok, err = pcall(fn)
            if not ok then ZeroX:Notify({ Title = "Teleport failed", Content = tostring(err), Duration = 4 }) end
        end
        local function rejoin()
            ZeroX:Notify({ Title = "Rejoining", Content = "Joining this server again...", Duration = 3 })
            if #Players:GetPlayers() <= 1 or game.PrivateServerId ~= "" then
                tp(function() TS:Teleport(game.PlaceId, LocalPlayer) end)
            else
                tp(function() TS:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer) end)
            end
        end
        local function hop()
            ZeroX:Notify({ Title = "Server hop", Content = "Looking for another server...", Duration = 3 })
            local Http = game:GetService("HttpService")
            local picks, cursor = {}, nil
            for _ = 1, 3 do
                local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100"
                if cursor then url = url .. "&cursor=" .. cursor end
                local ok, data = pcall(function() return Http:JSONDecode(game:HttpGet(url)) end)
                if not ok or type(data) ~= "table" or type(data.data) ~= "table" then break end
                for _, s in ipairs(data.data) do
                    local playing, maxP = tonumber(s.playing), tonumber(s.maxPlayers)
                    if s.id ~= game.JobId and playing and maxP and playing < maxP then picks[#picks + 1] = s.id end
                end
                cursor = data.nextPageCursor
                if #picks > 0 or not cursor then break end
            end
            if #picks == 0 then
                ZeroX:Notify({ Title = "No other server found", Content = "Joining a new server instead.", Duration = 3 })
                tp(function() TS:Teleport(game.PlaceId, LocalPlayer) end)
                return
            end
            tp(function() TS:TeleportToPlaceInstance(game.PlaceId, picks[math.random(1, #picks)], LocalPlayer) end)
        end
        local function leave()
            ZeroX:Confirm({
                Title = "Leave the game?",
                Content = "Roblox closes this game right away.",
                Button = "Leave",
                Callback = function()
                    if not pcall(function() game:Shutdown() end) then LocalPlayer:Kick("You left the game.") end
                end,
            })
        end

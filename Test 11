    local function hideTip()
        Tip.owner = nil
        Tip.tok = (Tip.tok or 0) + 1
        tipF.Visible = false
    end
    local function showTip(anchor, str)
        if str == nil or str == "" then return end
        Tip.owner = anchor
        Tip.at = os.clock()
        Tip.tok = (Tip.tok or 0) + 1
        local my = Tip.tok
        tipText.Text = str
        tipLine.Color = accent()
        local sc = Lib._fit and Lib._fit.Scale or 1
        tipScale.Scale = sc
        tipF.Position = UDim2.fromOffset(-1000, -1000)
        tipF.Visible = true
        task.defer(function()
            if Tip.tok ~= my then return end
            local vp = viewport()
            local ap, as = anchor.AbsolutePosition, anchor.AbsoluteSize
            local sz = tipF.AbsoluteSize
            local x = math.clamp(ap.X + as.X / 2 - sz.X / 2, 8, math.max(8, vp.X - sz.X - 8))
            local y = ap.Y - sz.Y - 8
            if y < 8 then y = ap.Y + as.Y + 8 end
            tipF.Position = UDim2.fromOffset(x, y)
            if Lib.FX then
                tipScale.Scale = sc * 0.85
                ease(tipScale, 0.22, { Scale = sc }, Enum.EasingStyle.Back)
            end
        end)
        task.delay(5, function() if Tip.tok == my then hideTip() end end)
    end

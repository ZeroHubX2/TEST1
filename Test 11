                    if ocfg.Numeric then
                        local n = tonumber(v)
                        if not n then return nil end
                        if ocfg.Min then n = math.max(ocfg.Min, n) end
                        if ocfg.Max then n = math.min(ocfg.Max, n) end
                        return math.floor(n)
                    end
                    return tostring(v or "")
                end
                opt.Value = norm(ocfg.Default)
                local field
                field = r:Right():TextField({

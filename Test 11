    local RubbleCache = {}
    local function rubbleFace(border, blocker, from)
        local unit = blocker.CFrame.LookVector * Vector3.new(1, 0, 1)
        unit = unit.Magnitude > 0.01 and unit.Unit or Vector3.new(0, 0, 1)

        local att = blocker:FindFirstChild("RubbleBar")
        if att and att:IsA("Attachment") then
            local p = att.WorldPosition
            local face = (((p - blocker.Position) * Vector3.new(1, 0, 1)):Dot(unit) >= 0) and unit or -unit
            return p - face * 5 - Vector3.new(0, 14, 0), face
        end

        local cached = RubbleCache[blocker]
        if cached then return cached.point, cached.face end

        local face = ((from - blocker.Position):Dot(unit) >= 0) and unit or -unit
        local bx, bz = blocker.Position.X, blocker.Position.Z
        local top = blocker.Position.Y + blocker.Size.Y
        local floorHit = workspace:Raycast(Vector3.new(bx, top, bz), Vector3.new(0, -blocker.Size.Y * 3, 0), excludeParams(border))
        local floorY = floorHit and floorHit.Position.Y or (blocker.Position.Y - blocker.Size.Y / 2)

        local depth = blocker.Size.Z / 2
        local rubble = border:FindFirstChild("Rubble")
        if rubble then
            local inc = RaycastParams.new()
            inc.FilterType = Enum.RaycastFilterType.Include
            inc.FilterDescendantsInstances = { rubble }
            local origin = Vector3.new(bx, floorY + 14, bz)
            local hit = workspace:Raycast(origin + face * 150, -face * 300, inc)
            if hit then depth = math.max((hit.Position - origin):Dot(face), depth) end
        end

        local point = Vector3.new(bx, floorY, bz) + face * depth
        RubbleCache[blocker] = { point = point, face = face }
        return point, face
    end

    local function rubbleTarget(from)
        local world = workspace:FindFirstChild("World")
        local map = world and world:FindFirstChild("Map")
        if not map then return nil end
        local best, bestDist
        for _, border in ipairs(map:GetChildren()) do
            local hp = tonumber(border:GetAttribute("RubbleHealth"))
            local blocker = border:FindFirstChild("Blocker")
            if hp and hp > 0 and blocker and blocker:IsA("BasePart") then
                local point, face = rubbleFace(border, blocker, from)
                local d = (point - from).Magnitude
                if not bestDist or d < bestDist then
                    best, bestDist = {
                        part = blocker,
                        name = "rubble",
                        rubble = true,
                        boss = false,
                        health = hp,
                        maxHealth = tonumber(border:GetAttribute("RubbleMaxHealth")) or hp,
                        facePoint = point,
                        face = face,
                    }, d
                end
            end
        end
        return best
    end


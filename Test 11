        local function colCount()
            local w = body.Size.X.Offset - 36
            if w >= 560 then return 2 end
            return 1
        end
        local function relayout(tab)
            if not tab then return end
            local n = colCount()
            for _, g in ipairs(tab.grids or {}) do
                local k = (body.Size.X.Offset - 48 >= 560) and 4 or 2
                g.CellSize = UDim2.new(1 / k, -math.floor(10 * (k - 1) / k + 0.5), 0, 80)
            end
            if tab.ncols ~= n then
                local old = tab.cols or {}
                tab.cols = {}
                for i = 1, n do
                    local col = inst("Frame", {
                        Name = "Column" .. i, BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.Y,
                        Size = UDim2.new(1 / n, -math.floor(12 * (n - 1) / n + 0.5), 0, 0), LayoutOrder = i,
                    }, tab.holder)
                    list(col, nil, 12)
                    tab.cols[i] = col
                end
                for _, card in ipairs(tab.cards) do card.frame.Parent = tab.cols[1] end
                for _, col in ipairs(old) do col:Destroy() end
                tab.ncols = n
            end
            local heights = {}
            for i = 1, n do heights[i] = 0 end
            local s = math.max(fit.Scale, 0.01)
            for idx, card in ipairs(tab.cards) do
                local k = 1
                if card.frame.Visible then
                    for i = 2, n do if heights[i] < heights[k] - 1 then k = i end end
                    local h = card.frame.AbsoluteSize.Y / s
                    if h < 10 then h = 90 + #card.rows * 64 end
                    heights[k] = heights[k] + h + 12
                end
                card.frame.LayoutOrder = idx
                if card.frame.Parent ~= tab.cols[k] then card.frame.Parent = tab.cols[k] end
            end
        end
        local function queue(tab)

local RaidAreas = nil
local function waveNames()
    if not RaidAreas then return nil end
    local area = RaidAreas[tonumber(read(RunStore.store.state.area)) or 1] or RaidAreas[1]
    local w = area and area.waves and area.waves[tonumber(read(RunStore.store.state.wave)) or 0]
    local set = {}
    if not w then return set end
    for _, e in ipairs(w.enemies or {}) do if e.name then set[e.name] = true end end
    if type(w.boss) == "string" then set[w.boss] = true end
    if type(w.clone) == "table" and w.clone.name then set[w.clone.name] = true end
    if type(w.oathKnight) == "string" then set[w.oathKnight] = true end
    for _, e in ipairs(w.oathEnemies or {}) do if e.name then set[e.name] = true end end
    for _, e in ipairs(w.summonEnemies or {}) do if e.name then set[e.name] = true end end
    if type(w.afterimages) == "table" and w.afterimages.name then set[w.afterimages.name] = true end
    return set
end

local function getEnemies()
    local list = {}
    local folder = workspace:FindFirstChild("enemies")
    if not folder then return list end
    local entries = EnemyStore.store.state.entries
    local active = waveNames()
    for _, model in ipairs(folder:GetChildren()) do
        local part = model:FindFirstChild("HumanoidRootPart")
        if part and math.abs(part.Position.Y) > 3000 then part = nil end
        if part then
            local e = entries and (entries[model.Name] or entries[tonumber(model.Name)])
            local name = e and read(e.name)
            local health = e and tonumber(read(e.health))
            local maxHealth = e and tonumber(read(e.maxHealth))
            if health == nil then
                local hum = model:FindFirstChildOfClass("Humanoid")
                health = hum and hum.Health or 1
                maxHealth = hum and hum.MaxHealth or 1
            end
            local skip = name and CloneNames[name] and Options.IgnoreBossClone and Options.IgnoreBossClone.Value
            if not (Stage and Stage.floodEscape) and active and name and isBoss(name) and not active[name] then skip = true end
            if health > 0 and not skip then
                local bossFlag = isBoss(name) or (maxHealth and maxHealth >= 50000) or false
                if not bossFlag then
                    pcall(function()
                        if model:GetAttribute("Boss") == true or model:GetAttribute("boss") == true then
                            bossFlag = true
                        end
                        for _, child in ipairs(model:GetChildren()) do
                            if child:IsA("BillboardGui") then
                                for _, desc in ipairs(child:GetDescendants()) do
                                    if desc:IsA("TextLabel") and desc.Text:find("BOSS") then
                                        bossFlag = true
                                        break
                                    end
                                end
                            end
                        end
                    end)
                end
                table.insert(list, {
                    part = part,
                    name = name,
                    health = health,
                    maxHealth = maxHealth or health,
                    boss = bossFlag,
                    priority = name ~= nil and PriorityNames[name] == true,
                })
            end
        end
    end
    return list
end

local function excludeParams(extra)
    local ignore = { extra }
    if LocalPlayer.Character then table.insert(ignore, LocalPlayer.Character) end
    local enemies = workspace:FindFirstChild("enemies")
    if enemies then table.insert(ignore, enemies) end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = ignore
    return params
end

local RubbleCache = {}
local function rubbleFace(border, blocker, from)
    local unit = blocker.CFrame.LookVector * Vector3.new(1, 0, 1)
    unit = unit.Magnitude > 0.01 and unit.Unit or Vector3.new(0, 0, 1)

    local att = blocker:FindFirstChild("RubbleBar")
    if att and att:IsA("Attachment") then
        local p = att.WorldPosition
        local face = (((p - blocker.Position) * Vector3.new(1, 0, 1)):Dot(unit) >= 0) and unit or -unit
        return p - face * 5 - Vector3.new(0, 14, 0), face
    end

    local cached = RubbleCache[blocker]
    if cached then return cached.point, cached.face end

    local face = ((from - blocker.Position):Dot(unit) >= 0) and unit or -unit
    local bx, bz = blocker.Position.X, blocker.Position.Z
    local top = blocker.Position.Y + blocker.Size.Y
    local floorHit = workspace:Raycast(Vector3.new(bx, top, bz), Vector3.new(0, -blocker.Size.Y * 3, 0), excludeParams(border))
    local floorY = floorHit and floorHit.Position.Y or (blocker.Position.Y - blocker.Size.Y / 2)

    local depth = blocker.Size.Z / 2
    local rubble = border:FindFirstChild("Rubble")
    if rubble then
        local inc = RaycastParams.new()
        inc.FilterType = Enum.RaycastFilterType.Include
        inc.FilterDescendantsInstances = { rubble }
        local origin = Vector3.new(bx, floorY + 14, bz)
        local hit = workspace:Raycast(origin + face * 150, -face * 300, inc)
        if hit then depth = math.max((hit.Position - origin):Dot(face), depth) end
    end

    local point = Vector3.new(bx, floorY, bz) + face * depth
    RubbleCache[blocker] = { point = point, face = face }
    return point, face
end

local function rubbleTarget(from)
    local world = workspace:FindFirstChild("World")
    local map = world and world:FindFirstChild("Map")
    if not map then return nil end
    local best, bestDist
    for _, border in ipairs(map:GetChildren()) do
        local hp = tonumber(border:GetAttribute("RubbleHealth"))
        local blocker = border:FindFirstChild("Blocker")
        if hp and hp > 0 and blocker and blocker:IsA("BasePart") then
            local point, face = rubbleFace(border, blocker, from)
            local d = (point - from).Magnitude
            if not bestDist or d < bestDist then
                best, bestDist = {
                    part = blocker,
                    name = "rubble",
                    rubble = true,
                    boss = false,
                    health = hp,
                    maxHealth = tonumber(border:GetAttribute("RubbleMaxHealth")) or hp,
                    facePoint = point,
                    face = face,
                }, d
            end
        end
    end
    return best
end

local function targetDistance(target, from)
    if target.rubble then
        local d = target.facePoint - from
        return Vector3.new(d.X, 0, d.Z).Magnitude
    end
    return (target.part.Position - from).Magnitude
end


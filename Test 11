    LastStatsAt = os.clock()
    local fps, ping = ZeroX.FPS or 0, ZeroX.Ping or 0
    Stats:Set("fps", fps, fps >= 55 and "Smooth" or (fps >= 30 and "OK" or "Low"), fps >= 55 and UC.Good or (fps >= 30 and UC.Warn or UC.Bad))
    Stats:Set("ping", ping .. " ms", ping < 120 and "Good" or (ping < 250 and "Fair" or "High"), ping < 120 and UC.Good or (ping < 250 and UC.Warn or UC.Bad))
    Stats:Set("players", #Players:GetPlayers() .. " / " .. Players.MaxPlayers, "In server")
    local t = math.floor(os.clock() - (ZeroX.StartedAt or os.clock()))
    Stats:Set("session", string.format("%02d:%02d", math.floor(t / 60), t % 60), "Since load")
    if os.clock() - LastGraphAt >= 0.5 then
        local now, fr = os.clock(), ZeroX.Frames or 0
        local gfps = fps
        if LastGraphAt > 0 and fr >= LastGraphFrames then gfps = (fr - LastGraphFrames) / (now - LastGraphAt) end
        LastGraphAt, LastGraphFrames = now, fr
        FpsGraph:Push(gfps, fps .. " FPS")
    end
end


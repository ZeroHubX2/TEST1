            if not quiet then ZeroX:Notify({ Title = "Shop", Content = "packets.buyMaterial module not found", Duration = 3 }) end
            return false
        end

        local currentMoney = getPlayerMoney()
        local totalCost = (price or 0) * amount
        if currentMoney < totalCost then
            if not quiet then
                ZeroX:Notify({
                    Title = "Not Enough Coins!",
                    Content = string.format("Need $%s, but you only have $%s (Short $%s)", formatNumber(totalCost), formatNumber(currentMoney), formatNumber(totalCost - currentMoney)),
                    Duration = 4
                })
            end
            return false
        end

        buying = true
        local reqId = math.random(1, 65535)
        local okFire = pcall(function()
            packets.buyMaterial:fire({
                itemId = tostring(itemId),
                amount = amount,
                requestId = reqId
            })
        end)
        pcall(function() if restoreIdentity then restoreIdentity() end end)
        buying = false

        if okFire then
            addLog(string.format("Shop: Purchased %s (ID %s) x%d for $%s", tostring(itemName), tostring(itemId), amount, formatNumber(totalCost)))
            if not quiet then
                ZeroX:Notify({
                    Title = "Purchase Successful!",
                    Content = string.format("Bought %s x%d (-$%s)", tostring(itemName), amount, formatNumber(totalCost)),
                    Duration = 3
                })
            end
            return true
        else
            if not quiet then
                ZeroX:Notify({ Title = "Shop", Content = "Error occurred while sending purchase request", Duration = 3 })
            end
            return false
        end
    end


    soloigris = true, shadowking = true, chrollo = true, uzuki = true,
    spiritedkaonashi = true, spiritedkaonashiclone = true, spiritedkaonashi2 = true,
    pucci = true, meruem = true, soloigrisshadow = true, gaku = true,
    takamura = true, hisoka = true,
    ["crimson knight"] = true, ["shadow king"] = true, ["grimoire thief"] = true,

        function W.fitTabs()
            local s2 = math.max(fit.Scale, 0.01)
            local avail = tabsBar.AbsoluteSize.X / s2 - 6
            local pills, other, natural = {}, 0, 0
            for _, ch in ipairs(tabsRow:GetChildren()) do
                if ch:IsA("TextButton") and ch.Name == "Tab" then
                    pills[#pills + 1] = ch
                    local lb = ch:FindFirstChildWhichIsA("TextLabel")
                    natural = natural + 13 + 17 + 7 + (lb and textWidth(lb.Text, 15) or 60) + 15
                elseif ch:IsA("GuiObject") then
                    other = other + ch.Size.X.Offset
                end
            end
            local n = #pills
            if n == 0 then return end
            local items = n + (#tabsRow:GetChildren() - n - 1)
            local gaps = math.max(items - 1, 0) * 4
            local fill = natural + other + gaps <= avail
            for _, pl in ipairs(pills) do
                if fill then
                    pl.AutomaticSize = Enum.AutomaticSize.None
                    pl.Size = UDim2.fromOffset(math.floor((avail - other - gaps) / n), 38)
                else
                    pl.AutomaticSize = Enum.AutomaticSize.X
                    pl.Size = UDim2.fromOffset(0, 38)
                end
            end
        end

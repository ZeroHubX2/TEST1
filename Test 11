            function tab:AddDropdown(id, ocfg)
                local opt = makeOption(id, "Dropdown", ocfg)
                local multi = ocfg.Multi and true or false
                opt.Multi, opt.Values = multi, ocfg.Values or {}
                local r = newRow(cur(), ocfg.Title, ocfg.Description, 170)
                local btn = inst("TextButton", {
                    Name = "Dropdown", Text = "", AutoButtonColor = false, BackgroundColor3 = C.Raise, BackgroundTransparency = 0.3,
                    BorderSizePixel = 0, Size = UDim2.fromOffset(170, 42),
                }, r.right)
                round(btn, 13)
                local lbl = text({
                    Text = "", FontFace = F.Semi, TextSize = 15, Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -46, 1, 0),
                    TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd,
                }, btn)
                local chev = icon("chevron", 14, btn, C.Sub)
                chev.AnchorPoint = Vector2.new(1, 0.5)
                chev.Position = UDim2.new(1, -16, 0.5, 0)
                press(btn)
                connect(btn.MouseEnter, function() btn.BackgroundColor3 = C.Hover end)
                connect(btn.MouseLeave, function() btn.BackgroundColor3 = C.Raise end)

                local function has(v)
                    for _, x in ipairs(opt.Values) do if x == v then return true end end
                    return false
                end
                local function toSet(v)
                    local s = {}
                    if type(v) == "table" then
                        for k, x in pairs(v) do
                            if type(k) == "number" then s[x] = true elseif x then s[k] = true end
                        end
                    end
                    return s
                end
                local function normalize(v)
                    if type(v) == "number" then return opt.Values[v] end
                    return v
                end
                local function refresh()
                    if multi then
                        local picked = {}
                        for _, x in ipairs(opt.Values) do if opt.Value[x] then picked[#picked + 1] = tostring(x) end end
                        if #picked == 0 then lbl.Text = "None"
                        elseif #picked == 1 then lbl.Text = picked[1]
                        else lbl.Text = picked[1] .. ", +" .. (#picked - 1) end
                    else
                        lbl.Text = opt.Value ~= nil and tostring(opt.Value) or "-"
                    end
                end
                if multi then
                    opt.Value = toSet(ocfg.Default)
                else
                    opt.Value = normalize(ocfg.Default)
                    if not has(opt.Value) then opt.Value = opt.Values[1] end
                end
                refresh()

                local menuOpen = false
                local function openMenu()
                    local vals = opt.Values
                    local n = #vals
                    local itemH = 40
                    local filter = n > 8
                    local h = math.min(math.max(n, 1), 7) * (itemH + 2) + 12 + (filter and 48 or 0)
                    local s = math.max(fit.Scale, 0.01)
                    local w = math.max(btn.AbsoluteSize.X / s, 230)
                    local f = openPopup(btn, w, h)
                    menuOpen = true
                    ease(chev, 0.25, { Rotation = 180 })
                    Pop.onClose = function()
                        menuOpen = false
                        ease(chev, 0.25, { Rotation = 0 })
                        if opt._pendingValues then
                            local pv = opt._pendingValues
                            opt._pendingValues = nil
                            task.defer(function() opt:SetValues(pv) end)
                        end
                    end
                    local q
                    if filter then
                        q = inst("TextBox", {
                            BackgroundColor3 = C.Raise, BackgroundTransparency = 0.3, BorderSizePixel = 0, Position = UDim2.fromOffset(8, 8),
                            Size = UDim2.new(1, -16, 0, 38), FontFace = F.Med, TextSize = 14, TextColor3 = C.Text, PlaceholderText = "Search",
                            PlaceholderColor3 = C.Sub, Text = "", ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left,
                        }, f)
                        round(q, 10)
                        pad(q, 12, 12, 0, 0)
                    end
                    local sc = inst("ScrollingFrame", {
                        BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(6, filter and 52 or 6),
                        Size = UDim2.new(1, -12, 1, filter and -58 or -12), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
                        ScrollingDirection = Enum.ScrollingDirection.Y, ScrollBarThickness = 3, ScrollBarImageColor3 = C.Dim,
                    }, f)
                    list(sc, nil, 2)
                    local items = {}
                    local function paintItems()
                        for _, it in ipairs(items) do
                            local on
                            if multi then on = opt.Value[it.v] and true or false else on = opt.Value == it.v end
                            it.check.Visible = on
                            it.lbl.TextColor3 = on and C.Text or C.Sub
                        end
                    end
                    for i, v in ipairs(vals) do
                        local b = inst("TextButton", {
                            Text = "", AutoButtonColor = false, BackgroundColor3 = C.Hover, BackgroundTransparency = 1, BorderSizePixel = 0,
                            Size = UDim2.new(1, -4, 0, itemH), LayoutOrder = i,
                        }, sc)
                        round(b, 10)
                        local l = text({
                            Text = tostring(v), FontFace = F.Semi, TextSize = 14, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -44, 1, 0),
                            TextTruncate = Enum.TextTruncate.AtEnd,
                        }, b)
                        local ck = icon("check", 14, b, accent())
                        ck.AnchorPoint = Vector2.new(1, 0.5)
                        ck.Position = UDim2.new(1, -12, 0.5, 0)
                        local it = { v = v, b = b, lbl = l, check = ck, key = string.lower(tostring(v)) }
                        items[#items + 1] = it
                        b.MouseEnter:Connect(function() b.BackgroundTransparency = 0.4 end)
                        b.MouseLeave:Connect(function() b.BackgroundTransparency = 1 end)
                        b.MouseButton1Click:Connect(function()
                            if multi then
                                opt.Value[v] = (not opt.Value[v]) or nil
                                refresh()
                                paintItems()
                                opt:_fire()
                            else
                                closePopup()
                                if v == opt.Value then return end
                                opt.Value = v
                                refresh()
                                opt:_fire()
                            end
                        end)
                    end
                    if q then
                        q:GetPropertyChangedSignal("Text"):Connect(function()
                            local s2 = string.lower(q.Text)
                            for _, it in ipairs(items) do it.b.Visible = s2 == "" or it.key:find(s2, 1, true) ~= nil end
                        end)
                    end
                    paintItems()
                end
                connect(btn.MouseButton1Click, function()
                    if menuOpen then closePopup() else openMenu() end
                end)
                opt._closeMenu = function() if menuOpen then closePopup() end end

                if multi then
                    function opt:SetValue(v)
                        self.Value = toSet(v)
                        refresh()
                        self:_fire()
                    end
                    function opt:SetValues(newValues)
                        if type(newValues) ~= "table" then return end
                        if menuOpen then
                            self._pendingValues = newValues
                            return
                        end
                        self.Values = newValues
                        refresh()
                    end
                    return opt
                end

                function opt:SetValue(v)
                    self.Value = normalize(v)
                    refresh()
                    self:_fire()
                end

                function opt:SetValues(newValues)
                    if type(newValues) ~= "table" or #newValues == 0 then return end
                    local cur2 = self.Values
                    local same = (cur2 and #cur2 == #newValues)
                    if same then
                        for i = 1, #newValues do
                            if cur2[i] ~= newValues[i] then same = false break end
                        end
                    end
                    if same then return end
                    if menuOpen then
                        self._pendingValues = newValues
                        return
                    end
                    self.Values = newValues
                    local matched = nil
                    if self.Value then
                        local curStr = tostring(self.Value)
                        local curLower = curStr:lower()
                        if curLower:find("equipped") or curLower:find("active") or curLower:find("first") then
                            for _, o in ipairs(newValues) do
                                if o:lower():find("equipped") or o:lower():find("active") or o:lower():find("first") then matched = o break end
                            end
                        end
                        if not matched then
                            local sNum = curStr:match("^Slot%s*(%d+):")
                            if sNum then
                                for _, o in ipairs(newValues) do
                                    if o:find("^Slot%s*" .. sNum .. ":") then matched = o break end
                                end
                            end
                        end
                        if not matched then
                            local cid = curStr:match("%(([%w_]+)%)")
                            if cid then
                                for _, o in ipairs(newValues) do
                                    if o:find("%(" .. cid .. "%)") then matched = o break end
                                end
                            end
                        end
                        if not matched then
                            for _, o in ipairs(newValues) do
                                if o == curStr then matched = o break end
                            end
                        end
                    end
                    self.Value = matched or newValues[1]
                    refresh()
                end
                return opt
            end


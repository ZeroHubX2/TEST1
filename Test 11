        local ring = inst("UIStroke", { Color = Color3.new(0, 0, 0), Transparency = 0.7, Thickness = 1 }, knob)
        local bubble = inst("TextLabel", {
            Name = "Bubble", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0, -6),
            Size = UDim2.fromOffset(0, 20), AutomaticSize = Enum.AutomaticSize.X,
            BackgroundColor3 = Color3.fromRGB(30, 30, 36), BackgroundTransparency = 0.05, BorderSizePixel = 0,
            TextColor3 = TEXT, FontFace = MONO, TextSize = 12, Text = "", Visible = false, ZIndex = 5,
        }, knob)
        round(bubble, UDim.new(0, 6))
        inst("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6) }, bubble)
        local box = inst("TextBox", {
            Name = "Value", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
            Size = UDim2.fromOffset(52, 24), BackgroundColor3 = BOX, BackgroundTransparency = 0.15, BorderSizePixel = 0,
            TextColor3 = TEXT, FontFace = MONO, TextSize = 13, Text = "", ClearTextOnFocus = false,
        }, holder)
        round(box, UDim.new(0, 6))
        local boxLine = inst("UIStroke", { Color = BOXLINE, Transparency = 0.5, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, box)

        local function paint()
            local c = accentColor()
            grad.Color = ColorSequence.new(c:Lerp(Color3.new(1, 1, 1), 0.22), c)
            ring.Color = c
        end
        paint()
        table.insert(accentHooks, paint)

        local fillTw, knobTw
        local function render(v, anim)
            local a = (max > min) and math.clamp((v - min) / (max - min), 0, 1) or 0
            if fillTw then fillTw:Cancel() end
            if knobTw then knobTw:Cancel() end
            fillTw, knobTw = nil, nil
            if anim then
                fillTw = tw(fill, 0.22, { Size = UDim2.fromScale(a, 1) })
                knobTw = tw(knob, 0.22, { Position = UDim2.fromScale(a, 0.5) })
            else
                fill.Size = UDim2.fromScale(a, 1)
                knob.Position = UDim2.fromScale(a, 0.5)
            end
            bubble.Text = fmt(v)
            if not box:IsFocused() then box.Text = fmt(v) end
        end
        local function fromX(x)
            local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
            return min + a * (max - min)
        end
        local dragging, hovering = false, false
        local function knobLook()
            local sz = dragging and 20 or (hovering and 18 or 16)
            tw(knob, 0.2, { Size = UDim2.fromOffset(sz, sz) }, Enum.EasingStyle.Back)
            tw(ring, 0.2, { Transparency = (dragging or hovering) and 0.15 or 0.7, Thickness = dragging and 2 or 1 })
            tw(track, 0.2, { BackgroundTransparency = (dragging or hovering) and 0.2 or 0.35 })
        end

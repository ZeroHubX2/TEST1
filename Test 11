                        }, b)
                        local num = text({
                            Text = string.format("%02d", i), FontFace = F.Mono, TextSize = 11, TextColor3 = C.Dim, AnchorPoint = Vector2.new(1, 0.5),
                            Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(30, 16), TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 53,
                        }, b)
                        local it = { v = v, b = b, lbl = l, check = ck, box = box, boxLine = boxLine, bar = bar, key = string.lower(tostring(v)) }
                        items[#items + 1] = it
                        if Lib.FX and i <= 12 then
                            l.TextTransparency = 1
                            num.TextTransparency = 1
                            l.Position = UDim2.fromOffset(60, 0)
                            box.Size = UDim2.fromOffset(0, 0)

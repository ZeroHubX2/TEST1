    local function ripple(b, pos)
        if not Lib.FX or not b.Parent then return end
        local ap, as = b.AbsolutePosition, b.AbsoluteSize
        local px, py = pos.X + inset.X, pos.Y + inset.Y
        local r = inst("Frame", {
            Name = "Ripple", AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, ZIndex = b.ZIndex + 1,
            Position = UDim2.fromScale(math.clamp((px - ap.X) / math.max(as.X, 1), 0, 1), math.clamp((py - ap.Y) / math.max(as.Y, 1), 0, 1)),
            Size = UDim2.fromScale(0, 0), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.72,
        }, b)
        round(r)
        inst("UIAspectRatioConstraint", { AspectRatio = 1, DominantAxis = Enum.DominantAxis.Width }, r)
        b.ClipsDescendants = true
        ease(r, 0.5, { Size = UDim2.fromScale(2.4, 0), BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
        task.delay(0.52, function() pcall(function() r:Destroy() end) end)
    end
    local function press(b)
        local sc = inst("UIScale", {}, b)
        connect(b.InputBegan, function(i)
            if not isPress(i) or not Lib.FX then return end
            ease(sc, 0.1, { Scale = 0.96 }, Enum.EasingStyle.Quad)
            ripple(b, i.Position)
        end)
        connect(b.InputEnded, function(i)
            if isPress(i) then ease(sc, 0.3, { Scale = 1 }, Enum.EasingStyle.Back) end
        end)
        connect(b.MouseLeave, function()
            if sc.Scale < 1 then ease(sc, 0.2, { Scale = 1 }) end
        end)
        return sc
    end
    local function glow(st, base)
        local g = inst("UIGradient", {
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.85), NumberSequenceKeypoint.new(0.42, 0.6),
                NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(0.58, 0.6), NumberSequenceKeypoint.new(1, 0.85),
            }),
        }, st)
        local e = { st = st, g = g, base = base }
        function e.paint()
            if Lib.FX then
                st.Color = accent()
                st.Transparency = 0
                g.Enabled = true
            else
                st.Color = C.Line
                st.Transparency = base
                g.Enabled = false
            end
        end
        table.insert(Lib._glows, e)
        table.insert(Lib._spin, g)
        onAccent(e.paint)
        return e
    end

    -- Rarity lookup: built-in table first, then discovered from the game's own character modules
    local RARITY_RANK = { epic = 1, legendary = 2, mythic = 3, arcane = 4, lyth = 5 }
    local RARITY_NAME = { "Epic", "Legendary", "Mythic", "Arcane", "LYTH" }
    joinNow.dynRarity = nil
    local function rarityFromValue(v)
        if type(v) == "string" then
            local k = normName(v)
            if RARITY_RANK[k] then return RARITY_NAME[RARITY_RANK[k]] end
        end
        return nil
    end
    local function buildDynRarity()
        local map = {}
        local function scan(t, depth, seen)
            if depth > 3 or type(t) ~= "table" or seen[t] then return end
            seen[t] = true
            for k, v in pairs(t) do
                if type(k) == "string" and type(v) == "table" then
                    local rar = rarityFromValue(rawget(v, "rarity")) or rarityFromValue(rawget(v, "Rarity"))
                    if rar then
                        map[normName(k)] = rar
                        local dn = rawget(v, "displayName") or rawget(v, "DisplayName") or rawget(v, "name") or rawget(v, "Name")
                        if type(dn) == "string" then map[normName(dn)] = rar end
                    else
                        scan(v, depth + 1, seen)
                    end
                end
            end
        end
        pcall(function()
            for _, m in ipairs(RS:GetDescendants()) do
                if m:IsA("ModuleScript") then
                    local ln = m.Name:lower()
                    if (ln:find("character") or ln:find("roster") or ln:find("summon") or ln:find("gacha"))
                        and not ln:find("packet") and not ln:find("store") and not ln:find("controller") then
                        local ok, mod = pcall(require, m)
                        if ok and type(mod) == "table" then scan(mod, 0, {}) end
                    end
                end
            end
        end)
        return map
    end
    joinNow.rarityOf = function(id, entry)
        local n = normName(id)
        for key, rar in pairs(joinNow.rarity) do
            if normName(key) == n then return rar end
        end
        if type(entry) == "table" then
            local r = rarityFromValue(rawget(entry, "rarity")) or rarityFromValue(rawget(entry, "Rarity"))
            if r then return r end
        end
        if not joinNow.dynRarity then joinNow.dynRarity = buildDynRarity() end
        return joinNow.dynRarity[n]
    end

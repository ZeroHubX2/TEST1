local FloorCache = {}
local function zoneFloor(part)
    local cached = FloorCache[part]
    if cached then return cached end
    local p, s = part.Position, part.Size
    local params = excludeParams(part.Parent)
    local origin = Vector3.new(p.X, p.Y + s.Y / 2, p.Z)
    local bottom = p.Y - s.Y / 2 - 60
    local lowest
    local passes = (Stage and Stage.raidExit) and 8 or 1
    for _ = 1, passes do
        local hit = workspace:Raycast(origin, Vector3.new(0, bottom - origin.Y, 0), params)
        if not hit then break end
        lowest = hit.Position.Y
        origin = hit.Position - Vector3.new(0, 0.5, 0)
        if origin.Y <= bottom then break end
    end
    local goal = Vector3.new(p.X, (lowest or p.Y) + 4, p.Z)
    FloorCache[part] = goal
    return goal
end

local function goalFor(target)
    if target.point then return target.point end
    if target.waypoint then
        return zoneFloor(target.part)
    end
    if target.rubble then
        return target.facePoint + target.face * math.clamp(Options.Distance.Value, 2, 6) + Vector3.new(0, 3, 0)
    end
    local tp = target.part.Position
    local mode = Options.PositionMode.Value
    local h = Options.Height.Value
    local d = Options.Distance.Value
    if mode == "Behind" then
        return (target.part.CFrame * CFrame.new(0, 0, d)).Position + Vector3.new(0, h, 0)
    elseif mode == "Orbit" then
        local a = math.rad(OrbitAngle)
        return tp + Vector3.new(math.cos(a) * d, h, math.sin(a) * d)
    end
    return tp + Vector3.new(0, h, 0)
end


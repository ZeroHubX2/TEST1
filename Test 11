        local function applySearch(tab)
            local q = string.lower(W.query or "")
            for _, card in ipairs(tab.cards) do
                local cardHit = q ~= "" and card.search:find(q, 1, true) ~= nil
                local any = false
                for _, r in ipairs(card.rows) do
                    local m = q == "" or cardHit or r.search:find(q, 1, true) ~= nil
                    r.frame.Visible = m
                    if m then any = true end
                end
                card.frame.Visible = q == "" or any or cardHit
            end
            relayout(tab)
        end

        local function select(tab)
            if W.active == tab then return end
            if W.active then
                W.active.page.Visible = false
                W.active.paint(false)
            end
            W.active = tab
            tab.page.Visible = true
            tab.paint(true)
            task.defer(function()
                W.moveIndicator(tab, W.indReady)
                if W.indReady then task.delay(0.3, W.shine) end
                W.indReady = true
            end)
            if Lib.FX then
                tab.stack.Position = UDim2.fromOffset(22, 44)
                tab.stackScale.Scale = 0.95
                ease(tab.stack, 0.55, { Position = UDim2.fromOffset(22, 0) }, Enum.EasingStyle.Back)
                ease(tab.stackScale, 0.55, { Scale = 1 }, Enum.EasingStyle.Back)
                for i, card in ipairs(tab.cards) do
                    if i > 10 then break end
                    card.scale.Scale = 0.92
                    card.frame.Rotation = (i % 2 == 0) and 1.6 or -1.6
                    task.delay((i - 1) * 0.05, function()
                        ease(card.scale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
                        ease(card.frame, 0.5, { Rotation = 0 }, Enum.EasingStyle.Back)
                    end)
                end
                local ty, dy = titleL.Position.Y.Offset, descL.Position.Y.Offset
                titleL.TextTransparency, descL.TextTransparency = 1, 1
                titleL.Position = UDim2.fromOffset(42, ty)
                descL.Position = UDim2.fromOffset(42, dy)
                ease(titleL, 0.35, { Position = UDim2.fromOffset(24, ty), TextTransparency = 0 })
                task.delay(0.06, function() ease(descL, 0.35, { Position = UDim2.fromOffset(24, dy), TextTransparency = 0 }) end)
            end
            if tab.greeting then
                local hr = tonumber(os.date("%H")) or 12
                local g = hr < 5 and "Good night" or hr < 12 and "Good morning" or hr < 18 and "Good afternoon" or "Good evening"
                titleL.Text = g .. ", " .. tostring(LP.DisplayName)
            else
                titleL.Text = tostring(tab.Title or "")
            end
            descL.Text = tostring(tab.Desc or "")
            if Lib.FX then
                W.typeTok = (W.typeTok or 0) + 1
                local my = W.typeTok
                local full = utf8.len(titleL.Text) or #titleL.Text
                titleL.MaxVisibleGraphemes = 0
                titleL.TextColor3 = accent()
                task.spawn(function()
                    local steps = math.clamp(full, 1, 40)
                    for i2 = 1, steps do
                        if W.typeTok ~= my then return end
                        titleL.MaxVisibleGraphemes = math.ceil(full * i2 / steps)
                        task.wait(0.014)
                    end
                    if W.typeTok ~= my then return end
                    titleL.MaxVisibleGraphemes = -1
                    tw(titleL, 0.35, { TextColor3 = C.Text })
                end)
            else
                titleL.MaxVisibleGraphemes = -1
                titleL.TextColor3 = C.Text
            end
            closePopup()
            hideTip()
            applySearch(tab)
            task.defer(function()
                local s = math.max(fit.Scale, 0.01)
                local cx = tabsBar.CanvasPosition.X
                local left = (tab.pill.AbsolutePosition.X - tabsBar.AbsolutePosition.X) / s + cx
                local pw = tab.pill.AbsoluteSize.X / s
                local view = tabsBar.AbsoluteWindowSize.X / s
                if left < cx + 8 or left + pw > cx + view - 8 then
                    W.scrollTabs(left + pw / 2 - view / 2, true)
                end
            end)
            task.delay(0.2, function()
                if W.active == tab and not Lib.Unloaded then relayout(tab) end
            end)
        end


    local function pickTarget(from)
        if Stage.floodEscape then
            return floodEscapeTarget(from)
        end
        local enemies = getEnemies()
        learnFrom(enemies)
        local priority = {}
        for _, e in ipairs(enemies) do if e.priority then table.insert(priority, e) end end
        if #priority > 0 then
            enemies = priority
        else
            local spot = ariseSpot(from)
            if spot then return spot, nil end
        end
        local bossImmune = isBossImmune()
        local minionsFirstOn = Stage.minionsFirst or (Options.MinionsFirst and Options.MinionsFirst.Value) or bossImmune
        if minionsFirstOn and #enemies > 1 then
            local guards = {}
            for _, e in ipairs(enemies) do if not e.boss then table.insert(guards, e) end end
            if #guards > 0 and (#guards < #enemies or bossImmune) then enemies = guards end
        end
        if #enemies == 0 then
            if Stage.raidExit then
                local exit = exitTarget()
                if exit then return exit, nil end
            end
            if Stage.rubble then
                local rubble = rubbleTarget(from)
                if rubble then return rubble, rubble end
            end
            if Stage.idleCentre then
                local c = centreTarget()
                if c then return c, nil end
            end
            if Stage.nextArea then
                local area = areaTarget()
                if area then return area, nil end
            end
            return nil, nil
        end
        local nearest, nearestDist
        for _, e in ipairs(enemies) do
            local d = (e.part.Position - from).Magnitude
            if not nearestDist or d < nearestDist then nearest, nearestDist = e, d end
        end
        local mode = Options.TargetMode.Value
        local best, bestScore
        for _, e in ipairs(enemies) do
            local dist = (e.part.Position - from).Magnitude
            local score
            if mode == "Lowest HP" then
                score = e.health
            elseif mode == "Boss First" and not bossImmune then
                score = (e.boss and 0 or 1e6) + dist
            else
                score = dist
            end
            if not bestScore or score < bestScore then
                best, bestScore = e, score
            end
        end
        return best, nearest
    end


local function isBoss(name)
    if not name then return false end
    local lower = tostring(name):lower()
    if BossLookup[lower] then return true end
    local cfg = EnemyConstants and EnemyConstants.enemiesByName and (EnemyConstants.enemiesByName[name] or EnemyConstants.enemiesByName[lower])
    if cfg ~= nil and cfg.boss ~= nil and cfg.boss ~= false then return true end
    if lower:find("boss") or lower:find("king") or lower:find("igris") or lower:find("meruem")
        or lower:find("pucci") or lower:find("chrollo") or lower:find("hisoka")
        or lower:find("takamura") or lower:find("uzuki") or lower:find("gaku")
        or lower:find("knight") or lower:find("thief") or lower:find("priest")
        or lower:find("jester") or lower:find("faceless") or lower:find("shade") then
        return true
    end
    return false
end


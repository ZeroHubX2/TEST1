local function pickFateBlessing()
    if Options.AutoPickBlessing and not Options.AutoPickBlessing.Value then return end
    local offer = LocalPlayer:GetAttribute("FateOffer")
    local offerStr = type(offer) == "string" and offer or ""

    local gui = LocalPlayer:FindFirstChildOfClass("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("FateBlessings")
    local picker = gui and gui:FindFirstChild("Picker")
    local pickerOpen = picker and (picker.Visible or (gui:IsA("ScreenGui") and gui.Enabled and picker.Visible))

    if offerStr == "" and not pickerOpen then
        LastHandledOffer = ""
        return
    end

    if offerStr ~= "" and offerStr == LastHandledOffer and os.clock() - LastBlessingPickAt < 1.5 then
        return
    end

    local candidates = {}
    if offerStr ~= "" then
        for id in string.gmatch(offerStr, "[^,]+") do
            local clean = id:match("^%s*(.-)%s*$")
            if clean and clean ~= "" then
                table.insert(candidates, clean)
            end
        end
    end

    local priorityCategory = (Options.BlessingPriority and Options.BlessingPriority.Value) or "Damage"
    local scoreMap = FateBlessingScores[priorityCategory] or FateBlessingScores.Damage

    local bestId = nil
    local bestScore = -1
    if #candidates > 0 then
        for _, id in ipairs(candidates) do
            local s = scoreMap[id] or 1
            if s > bestScore then
                bestScore = s
                bestId = id
            end
        end
    end

    local remote = RS:FindFirstChild("FateBlessingPick")
    if not remote then
        pcall(function() remote = RS:WaitForChild("FateBlessingPick", 1) end)
    end

    if bestId and remote and remote:IsA("RemoteEvent") then
        remote:FireServer(bestId)
        LastBlessingPickAt = os.clock()
        LastHandledOffer = offerStr
        addLog("Mirror blessing picked: " .. tostring(bestId))
    end

    if picker and pickerOpen then
        local list = picker:FindFirstChild("Holder") and picker.Holder:FindFirstChild("List")
        if list then
            for _, card in ipairs(list:GetChildren()) do
                if card:IsA("ImageButton") and card.Visible and card.Name:find("Offer") then
                    pcall(function()
                        if firesignal then
                            firesignal(card.Activated)
                        end
                        local pickBtn = card:FindFirstChild("PickButton", true)
                        if pickBtn and firesignal then
                            firesignal(pickBtn.Activated)
                        end
                    end)
                    if not bestId then
                        LastBlessingPickAt = os.clock()
                        addLog("Mirror blessing card clicked: " .. tostring(card.Name))
                        break
                    end
                end
            end
        end
    end
end


            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(48, 26),
            BackgroundColor3 = C.Raise, BorderSizePixel = 0,
        }, hit)
        round(trk)
        local tline = stroke(trk, 0.85)
        local tgrad = inst("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(150, 150, 150)), Rotation = 0, Enabled = false }, trk)
        local knob = inst("Frame", {
            AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 4, 0.5, 0), Size = UDim2.fromOffset(18, 18),
            BackgroundColor3 = Color3.fromRGB(120, 120, 132), BorderSizePixel = 0, ZIndex = 2,
        }, trk)
        round(knob)
        local kc = icon("check", 10, knob, accent())
        kc.AnchorPoint = Vector2.new(0.5, 0.5)
        kc.Position = UDim2.fromScale(0.5, 0.5)
        kc.ZIndex = 3
        local sw = { Value = on and true or false }
        local function paint(anim)
            local pos = sw.Value and UDim2.new(1, -22, 0.5, 0) or UDim2.new(0, 4, 0.5, 0)
            local col = sw.Value and accent() or C.Raise
            local kcol = sw.Value and Color3.new(1, 1, 1) or Color3.fromRGB(120, 120, 132)
            tgrad.Enabled = sw.Value
            kc.ImageColor3 = accent()
            if anim then
                if Lib.FX then knob.Size = UDim2.fromOffset(26, 18) end
                ease(knob, 0.35, { Position = pos, Size = UDim2.fromOffset(18, 18), BackgroundColor3 = kcol }, Enum.EasingStyle.Back)
                tw(trk, 0.2, { BackgroundColor3 = col })
                tw(tline, 0.2, { Color = sw.Value and accent() or C.Line, Transparency = sw.Value and 0.4 or 0.85 })
                kc.Size = UDim2.fromOffset(0, 0)
                kc.Visible = sw.Value
                if sw.Value then ease(kc, 0.3, { Size = UDim2.fromOffset(10, 10) }, Enum.EasingStyle.Back) end
            else
                knob.Position = pos
                knob.BackgroundColor3 = kcol
                trk.BackgroundColor3 = col
                tline.Color = sw.Value and accent() or C.Line
                tline.Transparency = sw.Value and 0.4 or 0.85
                kc.Visible = sw.Value
                kc.Size = UDim2.fromOffset(10, 10)
            end
        end
        function sw.set(v)
            v = v and true or false
            if v == sw.Value then return end
            sw.Value = v
            paint(true)
        end
        onAccent(function() paint(false) end)

            function tab:AddDropdown(id, ocfg)
                local opt = makeOption(id, "Dropdown", ocfg)
                local multi = ocfg.Multi and true or false
                opt.Multi, opt.Values = multi, ocfg.Values

                if multi then

                    local set = {}
                    if type(ocfg.Default) == "table" then
                        for k, x in pairs(ocfg.Default) do
                            if type(k) == "number" then set[x] = true elseif x then set[k] = true end
                        end
                    end
                    opt.Value = set
                    local switches = {}
                    for _, name in ipairs(ocfg.Values) do
                        local r = row()
                        stack(r, ocfg.Title .. ":  " .. name, nil)
                        switches[name] = r:Right():Toggle({
                            Value = set[name] and true or false,
                            ValueChanged = function(_, v)
                                v = v and true or false
                                if (opt.Value[name] and true or false) == v then return end
                                opt.Value[name] = v or nil
                                opt:_fire()
                            end,
                        })
                    end
                    function opt:SetValue(v)
                        local ns = {}
                        if type(v) == "table" then
                            for k, x in pairs(v) do
                                if type(k) == "number" then ns[x] = true elseif x then ns[k] = true end
                            end
                        end
                        self.Value = ns
                        for name, sw in pairs(switches) do setProp(sw, "Value", ns[name] and true or false) end
                        self:_fire()
                    end
                    function opt:SetValues(newValues) self.Values = newValues end
                    return opt
                end

                local r = row()
                stack(r, ocfg.Title, ocfg.Description)
                local function normalize(v)
                    if type(v) == "number" then return opt.Values[v] end
                    return v
                end
                local function has(list, v)
                    for _, x in ipairs(list) do if x == v then return true end end
                    return false
                end
                opt.Value = normalize(ocfg.Default)
                if not has(opt.Values, opt.Value) then opt.Value = opt.Values[1] end

                local function idx(v)
                    for i, x in ipairs(opt.Values) do if x == v then return i end end
                    return nil
                end

                local pop
                pop = r:Right():PopUpButton({
                    Options = opt.Values,
                    Value = idx(opt.Value),
                    ValueChanged = function(_, i)
                        if opt._updating then return end
                        local v = i
                        if type(i) == "number" then v = opt.Values[i] end
                        if v == nil or v == opt.Value then return end
                        opt.Value = v
                        opt:_fire()
                        task.defer(function()
                            if opt._closeMenu then opt._closeMenu() end
                        end)
                    end,
                })

                local btn = pop.Structures and (pop.Structures.Body.__instance or pop.Structures.Body)
                local menu = pop.Structures and pop.Structures.Menu
                local cont = pop.Structures and pop.Structures.MenuContainer
                local menuBody = pop.Structures and pop.Structures.MenuBody

                local function closeMenu()
                    pcall(function() pop.Expanded = false end)
                    pcall(function()
                        if cont then
                            cont.Parent = nil
                        end
                        if menuBody then
                            menuBody.GroupTransparency = 1
                        end
                    end)
                    if opt._pendingValues then
                        local pv = opt._pendingValues
                        opt._pendingValues = nil
                        task.defer(function()
                            opt:SetValues(pv)
                        end)
                    end
                end
                opt._closeMenu = closeMenu
                table.insert(Lib._dropdowns, { pop = pop, close = closeMenu })

                local _repositioning = false
                local function repositionMenu()
                    if _repositioning or not pop.Expanded then return end
                    if not (btn and menu and cont and cont.Parent) then return end
                    _repositioning = true
                    pcall(function()
                        local cam = workspace.CurrentCamera
                        local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
                        local bPos = btn.AbsolutePosition
                        local bSize = btn.AbsoluteSize
                        local mSize = menu.AbsoluteSize
                        local cPos = cont.AbsolutePosition

                        local mWidth = math.max(mSize.X, bSize.X, 200)
                        local mHeight = math.max(mSize.Y, 20)

                        local targetX = bPos.X + bSize.X - mWidth
                        targetX = math.clamp(targetX, 10, math.max(10, vp.X - mWidth - 10))

                        local targetY = bPos.Y + bSize.Y + 4
                        if targetY + mHeight > vp.Y - 10 then
                            targetY = math.max(10, bPos.Y - mHeight - 4)
                        end

                        menu.Position = UDim2.fromOffset(math.floor(targetX - cPos.X), math.floor(targetY - cPos.Y))
                    end)
                    _repositioning = false
                end

                if btn and typeof(btn) == "Instance" then
                    connect(btn:GetPropertyChangedSignal("AbsolutePosition"), repositionMenu)
                    connect(btn:GetPropertyChangedSignal("AbsoluteSize"), repositionMenu)
                end
                if menu and typeof(menu) == "Instance" then
                    connect(menu:GetPropertyChangedSignal("AbsoluteSize"), repositionMenu)
                    connect(menu:GetPropertyChangedSignal("Position"), function()
                        if pop.Expanded and not _repositioning then
                            repositionMenu()
                        end
                    end)
                end

                task.spawn(function()
                    local lastExp = false
                    while not Lib.Unloaded do
                        local exp = pop.Expanded == true
                        if exp ~= lastExp then
                            lastExp = exp
                            if exp then
                                pcall(function()
                                    if cont then
                                        if Lib.GUI and cont.Parent ~= Lib.GUI then
                                            cont.Parent = Lib.GUI
                                        end
                                        cont.Enabled = true
                                        cont.OnTopOfCoreBlur = true
                                        cont.DisplayOrder = (Lib.GUI and Lib.GUI.DisplayOrder or 1000000) + 5
                                    end
                                    if menuBody then menuBody.ZIndex = 100 end
                                    if menu then menu.ZIndex = 100 end
                                    for _, itm in ipairs(pop.Structures.Options or {}) do
                                        pcall(function()
                                            itm.ZIndex = 101
                                            local lbl = itm:FindFirstChild("Label")
                                            if lbl then lbl.ZIndex = 102 end
                                        end)
                                    end
                                end)
                                task.defer(repositionMenu)
                                task.delay(0.04, repositionMenu)
                            else
                                task.delay(0.25, function()
                                    if not pop.Expanded then closeMenu() end
                                end)
                            end
                        end
                        task.wait(0.05)
                    end
                end)

                function opt:SetValue(v)
                    self.Value = normalize(v)
                    opt._updating = true
                    setProp(pop, "Value", idx(self.Value))
                    opt._updating = false
                    self:_fire()
                end

                function opt:SetValues(newValues)
                    if type(newValues) ~= "table" or #newValues == 0 then return end

                    local cur = self.Values
                    local same = (cur and #cur == #newValues)
                    if same then
                        for i = 1, #newValues do
                            if cur[i] ~= newValues[i] then same = false; break end
                        end
                    end
                    if same then return end

                    if pop.Expanded then
                        self._pendingValues = newValues
                        return
                    end

                    self.Values = newValues
                    self._updating = true

                    setProp(pop, "Options", newValues)

                    local matched = nil
                    if self.Value then
                        local curStr = tostring(self.Value)
                        local curLower = curStr:lower()
                        if curLower:find("equipped") or curLower:find("active") or curLower:find("first") then
                            for _, o in ipairs(newValues) do
                                if o:lower():find("equipped") or o:lower():find("active") or o:lower():find("first") then matched = o; break end
                            end
                        end
                        if not matched then
                            local sNum = curStr:match("^Slot%s*(%d+):")
                            if sNum then
                                for _, o in ipairs(newValues) do
                                    if o:find("^Slot%s*" .. sNum .. ":") then matched = o; break end
                                end
                            end
                        end
                        if not matched then
                            local cid = curStr:match("%(([%w_]+)%)")
                            if cid then
                                for _, o in ipairs(newValues) do
                                    if o:find("%(" .. cid .. "%)") then matched = o; break end
                                end
                            end
                        end
                        if not matched then
                            for _, o in ipairs(newValues) do
                                if o == curStr then matched = o; break end
                            end
                        end
                    end

                    self.Value = matched or newValues[1]
                    local targetIdx = idx(self.Value) or 1
                    setProp(pop, "Value", targetIdx)
                    self._updating = false
                end
                return opt
            end


    function Lib:CreateWindow(cfg)
        local RunService = game:GetService("RunService")
        local LP = game:GetService("Players").LocalPlayer
        if cfg.ConfigFolder then Lib.Folder = cfg.ConfigFolder end
        Lib.ToggleKey = cfg.ToggleKey or Enum.KeyCode.RightControl
        local baseSub = cfg.SubTitle or ""

        local saved = Lib:ReadConfig("config") or {}
        local isMobile = UIS.TouchEnabled and not UIS.KeyboardEnabled
        local defW, defH = cfg.Width or 640, cfg.Height or 440
        if isMobile then defW, defH = cfg.MobileWidth or 580, cfg.MobileHeight or 380 end
        local winSize = UDim2.fromOffset(defW, defH)
        if type(saved.__size) == "table" and tonumber(saved.__size[1]) and tonumber(saved.__size[2]) then
            local sw, sh = tonumber(saved.__size[1]), tonumber(saved.__size[2])
            -- on mobile, ignore a saved size that is just the old desktop default
            if not (isMobile and sw == 640 and sh == 440) then
                winSize = UDim2.fromOffset(math.max(sw, 420), math.max(sh, 280))
            end
        end
        local winPos = UDim2.fromScale(0.5, 0.5)
        if type(saved.__pos) == "table" then
            local a = saved.__pos
            winPos = UDim2.new(tonumber(a[1]) or 0.5, tonumber(a[2]) or 0, tonumber(a[3]) or 0.5, tonumber(a[4]) or 0)
        end
        local cw = App:Window({
            Title = cfg.Title or "Zero Hub",
            Subtitle = baseSub,
            Size = winSize,
            Position = winPos,
            Draggable = true,
            Resizable = true,
            CanExit = true,
            CanMinimize = true,
            CanZoom = true,
            Dropshadow = true,
            UIBlur = false,
            Searching = true,
        })

        local Window = { Minimized = false, Tabs = {}, Cascade = cw }
        Lib.Window = Window
        local curSection
        local lastProfile

        function Window:AddSection(title)
            curSection = cw:Section({ Title = title, Expanded = true, Disclosure = true })
        end
        function Window:SetProfile(line)
            if line == lastProfile then return end
            lastProfile = line
            setProp(cw, "Subtitle", (baseSub ~= "" and (baseSub .. "  ·  ") or "") .. tostring(line))
        end

        function Window:AddTab(tcfg)
            if not curSection then Window:AddSection("Main") end
            local ctl = curSection:Tab({ Title = tcfg.Title, Icon = symbol(tcfg.Icon), Selected = #Window.Tabs == 0 })
            local tab = { Cascade = ctl, Title = tcfg.Title, Desc = tcfg.Description }
            table.insert(Window.Tabs, tab)
            local form

            local function group(title, sub)
                local ps = ctl:PageSection({ Title = title, Subtitle = sub })
                form = ps:Form()
            end
            local function row()
                if not form then group(tab.Title, tab.Desc) end
                return form:Row()
            end
            local function setTitle(ts, s)
                if not ts then return end
                local str = tostring(s or "")
                pcall(function() ts.Title = str end)
            end

            local function setDesc(ts, s)
                if not ts then return end
                local str = tostring(s or "")
                pcall(function() ts.Subtitle = str end)
            end

            local function stack(r, title, desc)
                return r:Left():TitleStack({ Title = title or "", Subtitle = desc })
            end

            function tab:AddSection(title) group(title, nil) end

            function tab:AddParagraph(pcfg)
                local r = row()
                local ts = stack(r, pcfg.Title, tostring(pcfg.Content or ""))
                local targetTitle = tostring(pcfg.Title or "")

                local p = { Instance = ts, Title = pcfg.Title }
                function p:SetDesc(txt)
                    local str = tostring(txt or "")
                    setDesc(ts, str)
                    pcall(function()
                        local conts = {}
                        pcall(function()
                            local gh = gethui and gethui()
                            if typeof(gh) == "Instance" then table.insert(conts, gh) end
                        end)
                        pcall(function()
                            local cg = game:GetService("CoreGui")
                            if typeof(cg) == "Instance" then table.insert(conts, cg) end
                        end)
                        for _, cont in ipairs(conts) do
                            if typeof(cont) == "Instance" then
                                for _, d in ipairs(cont:GetDescendants()) do
                                    if d:IsA("TextLabel") and d.Name == "Subtitle" then
                                        local parent = d.Parent
                                        local t = parent and parent:FindFirstChild("Title")
                                        if t and t.Text == targetTitle then
                                            d.Text = str
                                            d.Visible = true
                                        end
                                    end
                                end
                            end
                        end
                    end)
                end
                function p:SetTitle(txt)
                    local str = tostring(txt or "")
                    setTitle(ts, str)
                    targetTitle = str
                    p.Title = str
                end
                return p
            end

            function tab:AddButton(bcfg)
                local r = row()
                local ts = stack(r, bcfg.Title, bcfg.Description)
                r:Right():Button({
                    Label = bcfg.ButtonText or "Run",
                    State = bcfg.State or "Secondary",
                    Pushed = function()
                        if bcfg.Callback then task.spawn(safe, bcfg.Callback) end
                    end,
                })
                return { SetTitle = function(_, s) setTitle(ts, s) end, SetDesc = function(_, s) setDesc(ts, s) end }
            end

            function tab:AddToggle(id, ocfg)
                local r = row()
                stack(r, ocfg.Title, ocfg.Description)
                local opt = makeOption(id, "Toggle", ocfg)
                opt.Value = ocfg.Default and true or false
                local ctl2 = r:Right():Toggle({
                    Value = opt.Value,
                    ValueChanged = function(_, v)
                        v = v and true or false
                        if v == opt.Value then return end
                        opt.Value = v
                        opt:_fire()
                    end,
                })
                function opt:SetValue(v)
                    v = v and true or false
                    if v == self.Value then return end
                    self.Value = v
                    setProp(ctl2, "Value", v)
                    self:_fire()
                end
                return opt
            end

            function tab:AddSlider(id, ocfg)
                local r = row()
                local min, max, dec = ocfg.Min, ocfg.Max, ocfg.Rounding or 0
                local opt = makeOption(id, "Slider", ocfg)
                local function round(v)
                    local m = 10 ^ dec
                    return math.floor(v * m + 0.5) / m
                end
                local function fmt(v) return (dec > 0) and string.format("%." .. dec .. "f", v) or tostring(math.floor(v)) end
                opt.Value = math.clamp(round(tonumber(ocfg.Default) or min), min, max)
                local host
                pcall(function()
                    host = r.Structures.RightAccessories
                    if type(host) == "table" then host = host.__instance end
                end)
                if typeof(host) == "Instance" then
                    stack(r, ocfg.Title, ocfg.Description)
                    local ui
                    local function commit(v, anim)
                        if v == nil then ui.render(opt.Value, false) return end
                        v = math.clamp(round(v), min, max)
                        ui.render(v, anim)
                        if v == opt.Value then return end
                        opt.Value = v
                        opt:_fire()
                    end
                    ui = makeSlider(host, min, max, fmt, commit)
                    ui.render(opt.Value, false)
                    function opt:SetValue(v)
                        v = math.clamp(round(tonumber(v) or self.Value or min), min, max)
                        ui.render(v, true)
                        if v == self.Value then return end
                        self.Value = v
                        self:_fire()
                    end
                    return opt
                end

                local ts = stack(r, ocfg.Title .. ":  " .. fmt(opt.Value), ocfg.Description)
                local ctl2 = r:Right():Slider({
                    Minimum = min,
                    Maximum = max,
                    Value = opt.Value,
                    ValueChanged = function(_, v)
                        v = math.clamp(round(tonumber(v) or opt.Value), min, max)
                        if v == opt.Value then return end
                        opt.Value = v
                        setProp(ts, "Title", ocfg.Title .. ":  " .. fmt(v))
                        opt:_fire()
                    end,
                })
                function opt:SetValue(v)
                    v = math.clamp(round(tonumber(v) or self.Value or min), min, max)
                    if v == self.Value then return end
                    self.Value = v
                    setProp(ctl2, "Value", v)
                    setProp(ts, "Title", ocfg.Title .. ":  " .. fmt(v))
                    self:_fire()
                end
                return opt
            end

            function tab:AddInput(id, ocfg)

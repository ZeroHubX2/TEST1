    Lib.AutoSave = false
    local function fsOk() return writefile and readfile and isfile end
    function Lib:EnsureFolder(path)
        path = path or Lib.Folder
        if not (makefolder and isfolder) then return end
        local acc = ""
        for part in path:gmatch("[^/]+") do
            acc = acc == "" and part or (acc .. "/" .. part)
            if not isfolder(acc) then pcall(makefolder, acc) end
        end
    end
    function Lib:Path(file) return Lib.Folder .. "/" .. file end

    local function collect()
        local data = { __theme = Lib.AccentName, __autosave = Lib.AutoSave }
        if Lib.WinState then
            data.__size, data.__pos, data.__btn = Lib.WinState.size, Lib.WinState.pos, Lib.WinState.btn
        end
        data.__status = Lib.StatusPos
        for id, opt in pairs(Lib.Options) do
            if not opt.NoSave then
                if opt.Type == "Dropdown" and opt.Multi then
                    local arr = {}
                    for k, v in pairs(opt.Value) do if v then table.insert(arr, k) end end
                    data[id] = arr
                elseif opt.Type ~= "Button" then
                    data[id] = opt.Value
                end
            end
        end
        return data
    end
    function Lib:SaveConfig(name)
        if not fsOk() then return false, "executor has no file API" end
        Lib:EnsureFolder()
        local ok, err = pcall(writefile, Lib:Path((name or "config") .. ".json"), HttpService:JSONEncode(collect()))
        return ok, err
    end
    function Lib:ReadConfig(name, path)
        if not fsOk() then return nil, "executor has no file API" end
        path = path or Lib:Path((name or "config") .. ".json")
        if not isfile(path) then return nil, "no saved config" end
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
        if not ok or type(data) ~= "table" then return nil, "config is corrupt" end
        return data
    end
    function Lib:ApplyConfig(data)
        Lib._loading = true
        if data.__theme then
            Lib:SetAccent(data.__theme)
            local a = Lib.Options.Accent
            if a then a:SetValue(data.__theme) end
        end
        if Lib.ApplyWindowState then
            pcall(Lib.ApplyWindowState, data)
        else
            Lib._pendingWin = data
        end
        if type(data.__status) == "table" and tonumber(data.__status[1]) and tonumber(data.__status[2]) then
            Lib.StatusPos = { tonumber(data.__status[1]), tonumber(data.__status[2]) }
        end
        for id, v in pairs(data) do
            local opt = Lib.Options[id]
            if opt and not opt.NoSave and opt.SetValue then pcall(opt.SetValue, opt, v) end
        end
        Lib._loading = false
    end
    function Lib:LoadConfig(name, path)
        local data, err = Lib:ReadConfig(name, path)
        if not data then return false, err end
        Lib:ApplyConfig(data)
        return true
    end

    local saveToken = 0
    function Lib:QueueSave()
        if not Lib.AutoSave or Lib._loading or Lib.Unloaded then return end
        saveToken = saveToken + 1
        local my = saveToken
        task.delay(1, function()
            if my == saveToken and Lib.AutoSave and not Lib.Unloaded then Lib:SaveConfig("config") end
        end)
    end


                        self.Value = toSet(v)
                        refresh()
                        self:_fire()
                    end
                    function opt:SetValues(newValues)
                        if type(newValues) ~= "table" then return end
                        if menuOpen then
                            self._pendingValues = newValues
                            return
                        end
                        self.Values = newValues
                        refresh()
                    end
                    return opt
                end

                function opt:SetValue(v)
                    self.Value = normalize(v)
                    refresh()
                    self:_fire()
                end

                function opt:SetValues(newValues)
                    if type(newValues) ~= "table" or #newValues == 0 then return end
                    local cur2 = self.Values
                    local same = (cur2 and #cur2 == #newValues)
                    if same then
                        for i = 1, #newValues do
                            if cur2[i] ~= newValues[i] then same = false break end
                        end
                    end
                    if same then return end
                    if menuOpen then
                        self._pendingValues = newValues
                        return
                    end
                    self.Values = newValues
                    local matched = nil
                    if self.Value then
                        local curStr = tostring(self.Value)
                        local curLower = curStr:lower()
                        if curLower:find("equipped") or curLower:find("active") or curLower:find("first") then
                            for _, o in ipairs(newValues) do
                                if o:lower():find("equipped") or o:lower():find("active") or o:lower():find("first") then matched = o break end
                            end
                        end
                        if not matched then
                            local sNum = curStr:match("^Slot%s*(%d+):")
                            if sNum then
                                for _, o in ipairs(newValues) do
                                    if o:find("^Slot%s*" .. sNum .. ":") then matched = o break end
                                end
                            end
                        end
                        if not matched then
                            local cid = curStr:match("%(([%w_]+)%)")
                            if cid then
                                for _, o in ipairs(newValues) do
                                    if o:find("%(" .. cid .. "%)") then matched = o break end
                                end
                            end
                        end
                        if not matched then
                            for _, o in ipairs(newValues) do
                                if o == curStr then matched = o break end
                            end
                        end
                    end
                    self.Value = matched or newValues[1]
                    refresh()
                end
                return opt
            end


    local function hideTip()
        Tip.owner = nil
        Tip.tok = (Tip.tok or 0) + 1
        tipF.Visible = false
    end
    local function showTip(anchor, str)
        if str == nil or str == "" then return end
        Tip.owner = anchor
        Tip.at = os.clock()
        Tip.tok = (Tip.tok or 0) + 1
        local my = Tip.tok
        tipText.Text = str
        tipLine.Color = accent()
        local sc = Lib._fit and Lib._fit.Scale or 1
        tipScale.Scale = sc
        local function place()
            local vp = viewport()
            local ap, as = anchor.AbsolutePosition - overlay.AbsolutePosition, anchor.AbsoluteSize
            local half = tipF.AbsoluteSize.X / 2
            local x = math.clamp(ap.X + as.X / 2, half + 8, math.max(half + 8, vp.X - half - 8))
            if ap.Y - tipF.AbsoluteSize.Y - 10 < 4 then
                tipF.AnchorPoint = Vector2.new(0.5, 0)
                tipF.Position = UDim2.fromOffset(x, ap.Y + as.Y + 6)
            else
                tipF.AnchorPoint = Vector2.new(0.5, 1)
                tipF.Position = UDim2.fromOffset(x, ap.Y - 6)
            end
        end
        tipF.AnchorPoint = Vector2.new(0.5, 1)
        place()
        tipF.Visible = true
        if Lib.FX then
            tipScale.Scale = sc * 0.85
            ease(tipScale, 0.22, { Scale = sc }, Enum.EasingStyle.Back)
        end
        task.spawn(function()
            for _ = 1, 20 do
                if Tip.tok ~= my then return end
                pcall(place)
                task.wait()
            end
        end)
        task.delay(5, function() if Tip.tok == my then hideTip() end end)
    end

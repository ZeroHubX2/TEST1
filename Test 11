    local function queueGuiOpen()
        local gui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        local q = gui and (gui:FindFirstChild("Quque") or gui:FindFirstChild("Quque", true))
        local main = q and q:FindFirstChild("MainFrame")

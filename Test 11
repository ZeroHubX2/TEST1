    function Lib:ToggleUI()
        if Lib._folding then return end
        if gui.Enabled then
            closePopup()
            hideTip()
            if Lib.FX and Lib._fold then
                Lib._fold(false, function()
                    gui.Enabled = false
                    if Lib.OnToggle then pcall(Lib.OnToggle) end
                end)
                return
            end
            gui.Enabled = false
        else

    local function trialsTick()
        if not Stage.trials then return end
        local info = trialsInfo()
        if not info then return end
        local e = stageEntry()
        if info.cleared > (tonumber(e.best) or 0) then
            e.best = info.cleared
            saveStages()
        end
        local prev = TrialsLastCleared or info.cleared
        TrialsLastCleared = info.cleared
        if Options.StopAtFloor.Value and not TrialsLeaving then
            local target = tonumber(Options.StopFloor.Value)
            if target and prev < target and info.cleared >= target then
                leaveToLobby(string.format("Trials: floor %d cleared (target %d)", info.cleared, target))
            end
        end
    end

    local function describeStage()
        local lines = { string.format("%s  ·  %s", Stage.name, Stage.kind) }
        local does = {}
        if Stage.rubble then table.insert(does, "breaks rubble") end
        if Stage.nextArea then table.insert(does, "walks to the next area") end
        if Stage.idleCentre then table.insert(does, "returns to the centre between waves") end
        if Stage.raidExit then table.insert(does, "takes the elevator once it opens") end
        table.insert(lines, "When no enemies are left it " .. (#does > 0 and table.concat(does, ", ") or "waits") .. ".")
        if Stage.trials then
            local info = trialsInfo()
            if info then
                table.insert(lines, string.format("Floor %d now  ·  cleared %d  ·  best %d  ·  +%d this session", info.room, info.cleared, info.best, info.session))
                if Options.StopAtFloor.Value then
                    local target = tonumber(Options.StopFloor.Value)
                    if target and info.cleared >= target then
                        table.insert(lines, string.format("Leave at floor %d: already past it, so it won't trigger. Set a higher floor.", target))
                    elseif target then
                        table.insert(lines, string.format("Leaves to the lobby after floor %d (%d to go).", target, math.max(target - info.cleared, 0)))
                    end
                else
                    table.insert(lines, "Climbing: no floor lock.")
                end
            end
        end
        if Stage.idleCentre then
            local c, src = stageCentre()
            if c then table.insert(lines, string.format("Centre: %d, %d, %d (%s)", c.X, c.Y, c.Z, src)) end
        end
        if Stage.minionsFirst then table.insert(lines, "Boss guards are cleared before the boss.") end
        if Stage.mirrorBlessing then table.insert(lines, "Mirror blessings are picked automatically between waves.") end
        if next(PriorityNames) then table.insert(lines, "Oath knights are killed first.") end
        if next(CloneNames) then
            table.insert(lines, "Boss clone: " .. ((Options.IgnoreBossClone and Options.IgnoreBossClone.Value) and "ignored" or "fought"))
        end
        if Stage.arise then
            local have, slots = LocalPlayer:GetAttribute("AriseShadows"), LocalPlayer:GetAttribute("AriseSlots")
            table.insert(lines, string.format("Arise: %s  ·  shadows %s/%s", (Options.AutoArise and Options.AutoArise.Value) and "auto" or "off", tostring(have or 0), tostring(slots or "?")))
        end
        if Stage.raidExit then
            table.insert(lines, "Segment: " .. tostring(workspace:GetAttribute("Segment") or "?") .. "  ·  elevator " .. (workspace:GetAttribute("RaidExitOpen") == true and "open" or "closed"))
        end
        if Stage.floodEscape then
            local fl = tonumber(workspace:GetAttribute("FloodFloor")) or 0
            local ph = tostring(workspace:GetAttribute("FloodPhase") or "fight")
            local gt = tonumber(workspace:GetAttribute("FloodGate")) or 0
            table.insert(lines, string.format("Flood: Floor %d/11  ·  Phase %s  ·  Gate %d%%", fl, ph, math.floor(gt * 100)))
        end
        if not Stage.known then table.insert(lines, "New map: using the default " .. Stage.kind .. " behaviour.") end
        return table.concat(lines, "\n")
    end


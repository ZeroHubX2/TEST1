    local LearnedCentre, LearnedSamples = nil, 0
    local function learnFrom(enemies)
        if not Stage.idleCentre or #enemies == 0 then return end
        local sum = Vector3.zero
        for _, e in ipairs(enemies) do sum = sum + e.part.Position end
        local avg = sum / #enemies
        LearnedSamples = math.min(LearnedSamples + 1, 200)
        LearnedCentre = LearnedCentre and LearnedCentre:Lerp(avg, 1 / LearnedSamples) or avg
    end

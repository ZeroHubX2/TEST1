                        return v.X >= a.X and v.X <= a.X + sz.X and v.Y >= a.Y and v.Y <= a.Y + sz.Y
                    end
                    if inside(pos) or inside(pos + inset) then doCancel() end
                end))
            end)

            local TOTAL = 5
            local t0 = os.clock()
            task.spawn(function()
                while not (ZeroX.Unloaded or Env.AZ_Session ~= SessionId) and not cancelled do
                    local el = os.clock() - t0
                    if el >= TOTAL then break end
                    local alpha = math.clamp(el / TOTAL, 0, 1)
                    fill.Size = UDim2.fromScale(alpha, 1)
                    count.Text = "Entering stage in " .. math.ceil(TOTAL - el) .. "s..."
                    task.wait(0.04)
                end
                if not cancelled then
                    fill.Size = UDim2.fromScale(1, 1)
                    ZeroX.SkipJoinDelay = true -- the countdown already counted as the delay
                end
                if not cancelled then release() end
                for _, c in ipairs(extra) do pcall(function() c:Disconnect() end) end
                pcall(function()
                    local t1 = TS:Create(sc, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.88 })
                    local t2 = TS:Create(dim, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 })
                    t1:Play()
                    t2:Play()
                    t1.Completed:Wait()
                end)
                pcall(function()
                    if isStandaloneGui then
                        host:Destroy()
                    else
                        dim:Destroy()
                        if cascadeGui then cascadeGui.DisplayOrder = 1000000 end
                    end
                end)
            end)
        end)
        if not ok then release() end
    end)

    local Account, LevelProg, MilestoneCfg
    pcall(function() Account = require(RS.global.stores.accountNamespace) end)
    pcall(function() LevelProg = require(RS.global.utils.levelProgression) end)
    pcall(function() MilestoneCfg = require(RS.assets.config.levelMilestoneConfig) end)
    restoreIdentity()

    local ReqId = 0
    local function nextReq()
        ReqId = ReqId % 65535 + 1
        return ReqId
    end

    local function fire(name, payload)
        local ok = pcall(function() LobbyPackets[name]:fire(payload) end)
        restoreIdentity()
        return ok
    end

    local function nodeTrue(map, key)
        local v
        pcall(function()
            local e = map.entries and map.entries[key]
            if e == nil and map.get then e = map:get(key) end
            if type(e) == "table" and e.get then v = e:get() else v = e end
        end)
        return v == true
    end

    local function readyIn(section)
        local list = {}
        pcall(function()
            for key in pairs(section.completed.entries) do
                if nodeTrue(section.completed, key) and not nodeTrue(section.claimed, key) then table.insert(list, key) end
            end
        end)
        return list
    end

    local function playerLevel(acc)
        local lvl = LocalPlayer:GetAttribute("Level")
        pcall(function()
            local xp = acc.state.currencies.xp.current
            if type(xp) == "table" and xp.get then xp = xp:get() end
            lvl = LevelProg.getProgress(xp).level
        end)
        return tonumber(lvl) or 0
    end

    local MilestonePending = {}
    local function readyMilestones(acc)
        local list = {}
        if not (MilestoneCfg and MilestoneCfg.order) then return list end
        local lvl = playerLevel(acc)
        for _, m in ipairs(MilestoneCfg.order) do
            if m <= lvl and not nodeTrue(acc.state.claimedLevelMilestones, tostring(m)) then table.insert(list, m) end
        end
        return list
    end

    local function snapshot()
        local acc = Account and Account.getLocalPlayerAccount()
        if not acc then return nil end
        return {
            acc = acc,
            milestones = readyMilestones(acc),
            quests = readyIn(acc.state.quests),
            achievements = readyIn(acc.state.achievements),
            level = playerLevel(acc),
        }
    end

    local LastQuestClaim, LastAchClaim = 0, 0
    local function claimRewards(force)
        local snap = snapshot()
        if not snap then return end
        if force or Options.ClaimMilestones.Value then
            for _, m in ipairs(snap.milestones) do
                if not MilestonePending[m] or os.clock() - MilestonePending[m] > 8 then
                    MilestonePending[m] = os.clock()
                    fire("claimLevelMilestone", { level = m, requestId = nextReq() })
                    addLog("Quest: claimed level " .. m .. " milestone")
                    task.wait(0.4)
                end
            end
        end
        if (force or Options.ClaimQuests.Value) and #snap.quests > 0 and os.clock() - LastQuestClaim > 6 then
            LastQuestClaim = os.clock()
            fire("claimQuestRewards", { requestId = nextReq() })
            addLog("Quest: claimed " .. #snap.quests .. " quest reward(s)")
        end
        if (force or Options.ClaimAchievements.Value) and #snap.achievements > 0 and os.clock() - LastAchClaim > 6 then
            LastAchClaim = os.clock()
            fire("claimAchievementRewards", { requestId = nextReq() })
            addLog("Quest: claimed " .. #snap.achievements .. " achievement(s)")
        end
    end
    claimNow.fn = function() task.spawn(claimRewards, true) end

    local function deliveryText()
        local runs = string.format("%d / %d runs today", Delivery.dailyCount, Delivery.dailyLimit)
        local where = Delivery.targetLabel ~= "" and (" to " .. Delivery.targetLabel) or ""
        local state = ({
            none = "No package",
            carrying = "Carrying a package" .. where,
            delivered = "Delivered" .. where .. ", pay waiting",
            capped = "Daily limit reached",
        })[Delivery.status] or Delivery.status
        return runs, state
    end

    local DeliveryNote = "Idle"
    local function setDelivery(note)
        DeliveryNote = note
        local runs, state = deliveryText()
        local text = runs .. "\n" .. state .. "\n" .. note
        onUi(function() DeliveryStatus:SetDesc(text) end)
    end

    if LobbyPackets and LobbyPackets.deliveryState then
        pcall(function()
            LobbyPackets.deliveryState:on(function(data)
                if type(data) == "table" then
                    Delivery = data
                    DeliverySeen = true
                    if data.reason and data.reason ~= "" then addLog("Delivery: " .. tostring(data.reason)) end
                end
            end)
        end)
    end

    local function heiyun()
        local npcs = workspace:FindFirstChild("Systems") and workspace.Systems:FindFirstChild("NPCS")
        local h = npcs and npcs:FindFirstChild("Heiyun")
        return h and h:FindFirstChild("HumanoidRootPart")
    end

    local function nearHeiyun()
        local _, hrp = character()
        local h = heiyun()
        return hrp and h and (hrp.Position - h.Position).Magnitude < 35
    end

    local function teleportArea(name)
        local _, hrp = character()
        if not hrp then return false end
        local from = hrp.Position
        fire("teleportToArea", name)
        local t0 = os.clock()
        while os.clock() - t0 < 4 do
            task.wait(0.2)
            local _, h2 = character()
            if h2 and (h2.Position - from).Magnitude > 15 then
                task.wait(0.4)
                return true
            end
        end
        return false
    end
    questTp.fn = function() task.spawn(teleportArea, "Quests") end

    local function deliveryTarget()
        local systems = workspace:FindFirstChild("Systems")
        if not systems or Delivery.target == "" then return nil end
        local npc = (systems:FindFirstChild("NPCS") and systems.NPCS:FindFirstChild(Delivery.target))
            or (systems:FindFirstChild("ScatteredNPCS") and systems.ScatteredNPCS:FindFirstChild(Delivery.target))
        local r = npc and npc:FindFirstChild("HumanoidRootPart")
        return r and r:IsA("BasePart") and r.Position or nil
    end

    local function waitStatus(want, timeout)
        local t0 = os.clock()
        while Delivery.status ~= want and os.clock() - t0 < timeout do task.wait(0.15) end
        return Delivery.status == want
    end

    local function deliveryStep()
        if Delivery.status == "none" then
            if not nearHeiyun() then
                setDelivery("Teleporting to Heiyun")
                teleportArea("Quests")
            end
            setDelivery("Taking a package")
            fire("deliveryAction", { action = "request", requestId = nextReq() })
            if not waitStatus("carrying", 5) and Delivery.status == "none" then
                setDelivery("Heiyun did not hand over a package")
                task.wait(3)
            end
        elseif Delivery.status == "carrying" then
            local goal = deliveryTarget()
            if not goal then
                setDelivery("Drop-off not found, asking again")
                fire("deliveryAction", { action = "refresh", requestId = nextReq() })
                task.wait(2)
                return
            end
            setDelivery("Walking to " .. (Delivery.targetLabel ~= "" and Delivery.targetLabel or Delivery.target))
            local arrived = function() return Delivery.status ~= "carrying" end
            walkTo(goal, nil, arrived)
            local hum, hrp = character()
            if hum and Delivery.status == "carrying" then
                steerOn()
                steer(hum, hrp, goal, 3, arrived)
            end
            steerOff()
            if not waitStatus("delivered", 3) and Delivery.status == "carrying" then
                setDelivery("Not delivered yet, retrying the walk")
                task.wait(1)
            end
        elseif Delivery.status == "delivered" then
            setDelivery("Teleporting back for the pay")
            if not nearHeiyun() then teleportArea("Quests") end
            fire("deliveryAction", { action = "claim", requestId = nextReq() })
            if waitStatus("none", 5) or Delivery.status == "capped" then
                addLog(string.format("Delivery: run %d / %d done", Delivery.dailyCount, Delivery.dailyLimit))
            end
        else
            task.wait(1)
        end
    end

    -- Shop opener: walk to Yuji, open the Shop tab of the Crafting UI; if the UI is not loaded,
    -- walk away and come back, and repeat
    do
        local ShopCancel = false
        local function shopBtn()
            local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
            local b = pg
            for _, n in ipairs({ "UI Animation (Finished)", "Crafting", "SurfaceGui", "MainFrame", "Body", "Tabs", "Shop" }) do
                b = b and b:FindFirstChild(n)
            end
            return b
        end
        local function yujiPos()
            local sys = workspace:FindFirstChild("Systems")
            local npcs = sys and sys:FindFirstChild("NPCS")
            local npc = npcs and npcs:FindFirstChild("Yuji")
            if not npc then return nil end
            local part = npc:FindFirstChild("HumanoidRootPart")
                or (npc:IsA("Model") and npc.PrimaryPart)
                or (npc:IsA("BasePart") and npc)
                or npc:FindFirstChildWhichIsA("BasePart", true)
            return part and part.Position or nil
        end
        local function pressGui(btn)
            local hit = btn:IsA("GuiButton") and btn or btn:FindFirstChildWhichIsA("GuiButton", true) or btn
            local GuiClass
            pcall(function() GuiClass = require(RS.global.utils.delightUtility).GuiClass end)
            restoreIdentity()
            local done = false
            local obj = GuiClass and GuiClass.Get(hit)
            if obj and type(obj.Activate) == "function" then
                pcall(function() if setthreadidentity then setthreadidentity(2) end end)
                done = pcall(function() obj:Activate() end)
                restoreIdentity()
            end
            if not done and firesignal then
                pcall(firesignal, hit.MouseButton1Down)
                task.wait(0.05)
                pcall(firesignal, hit.MouseButton1Up)
                pcall(firesignal, hit.MouseButton1Click)
                pcall(firesignal, hit.Activated)
            end
        end
        local function say(t)
            addLog("Shop: " .. t)
            if ZeroX.ShopSetStatus then ZeroX.ShopSetStatus(t) end
        end
        ZeroX.ShopStop = function() ShopCancel = true end

        -- one pass: walk to Yuji, wait for the UI, walk away and back if it does not load (up to 6 tries)
        local function walkUntilLoaded()
            for attempt = 1, 6 do
                if ShopCancel or ZeroX.Unloaded then return false end
                if shopBtn() then return true end
                local pos = yujiPos()
                if not pos then
                    say("Yuji not found (try " .. attempt .. "), waiting")
                    task.wait(2)
                else
                    say("Walking to Yuji (try " .. attempt .. ")")
                    walkTo(pos, nil, function() return ShopCancel or shopBtn() ~= nil end)
                    local t0 = os.clock()
                    while not shopBtn() and not ShopCancel and os.clock() - t0 < 4 do task.wait(0.25) end
                    if shopBtn() then return true end
                    if ShopCancel then return false end
                    say("UI still not loaded, walking away and back")
                    local _, hrp = character()
                    local dir = hrp and Vector3.new(hrp.Position.X - pos.X, 0, hrp.Position.Z - pos.Z) or Vector3.zero
                    if dir.Magnitude < 1 then dir = Vector3.new(1, 0, 0) end
                    walkTo(pos + dir.Unit * 45, nil, function() return ShopCancel end)
                end
            end
            return shopBtn() ~= nil
        end

        -- stays on for AFK: keeps the shop UI loaded and presses the Shop tab again whenever the UI is reloaded
        local ShopLoop = false
        ZeroX.ShopOpen = function()
            if ShopLoop then
                if ShopCancel then
                    -- switched off and on again while the old loop is still ending
                    task.spawn(function()
                        while ShopLoop do task.wait(0.1) end
                        if Options.AutoOpenShop.Value then ZeroX.ShopOpen() end
                    end)
                end
                return
            end
            ShopLoop = true
            ShopCancel = false
            task.spawn(function()
                local lastBtn
                say("Auto open shop is on")
                while not ShopCancel and not ZeroX.Unloaded and Options.AutoOpenShop.Value do
                    if Joining or Delivering then
                        task.wait(1)
                    else
                        local btn = shopBtn()
                        if btn and btn == lastBtn then
                            task.wait(2)
                        elseif btn then
                            task.wait(0.3)
                            pressGui(btn)
                            lastBtn = btn
                            say("Shop tab pressed, watching")
                            task.wait(1)
                        else
                            lastBtn = nil
                            ShopBusy = true
                            walkUntilLoaded()
                            ShopBusy = false
                            steerOff()
                            if not shopBtn() and not ShopCancel then
                                say("Could not load the shop UI, retrying in 5s")
                                task.wait(5)
                            end
                        end
                    end
                end
                steerOff()
                ShopBusy = false
                ShopLoop = false
                say("Stopped")
            end)
        end
        -- saved config with the switch on (AFK after a rejoin): start it once the lobby code is ready
        task.delay(3, function()
            if not ZeroX.Unloaded and Options.AutoOpenShop.Value then ZeroX.ShopOpen() end
        end)
    end

    local function deliveryOn()
        return Options.AutoDelivery.Value or Options.AutoDeliveryFast.Value
    end

    -- Fast mode: no walking, just teleports (RISKY)
    local function fastTp(pos)
        local _, hrp = character()
        if not hrp then return false end
        hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
        hrp.AssemblyLinearVelocity = Vector3.zero
        return true
    end
    local function fastWait(want, timeout)
        local t0 = os.clock()
        while Delivery.status ~= want and os.clock() - t0 < timeout and Options.AutoDeliveryFast.Value do task.wait() end
        return Delivery.status == want
    end
    local function fastPause()
        local d = tonumber(Options.FastDeliveryDelay.Value) or 0
        task.wait(d > 0 and d or 0)
    end
    local function toHeiyunFast()
        local h = heiyun()
        if h then fastTp(h.Position) elseif not nearHeiyun() then teleportArea("Quests") end
        fastPause()
    end
    local function deliveryStepFast()
        local st = Delivery.status
        if st == "none" then
            if not nearHeiyun() then toHeiyunFast() end
            setDelivery("Fast: taking a package")
            fire("deliveryAction", { action = "request", requestId = nextReq() })
            if not fastWait("carrying", 3) and Delivery.status == "none" then
                setDelivery("Fast: no package, retrying")
                task.wait(0.4)
            end
        elseif st == "carrying" then
            local goal = deliveryTarget()
            if not goal then
                fire("deliveryAction", { action = "refresh", requestId = nextReq() })
                task.wait(0.3)
                return
            end
            setDelivery("Fast: jumping to " .. (Delivery.targetLabel ~= "" and Delivery.targetLabel or Delivery.target))
            local t0 = os.clock()
            while Delivery.status == "carrying" and os.clock() - t0 < 3 and Options.AutoDeliveryFast.Value do
                fastTp(goal)
                task.wait(0.05)
            end
            fastWait("delivered", 1.5)
        elseif st == "delivered" then
            setDelivery("Fast: back for the pay")
            toHeiyunFast()
            fire("deliveryAction", { action = "claim", requestId = nextReq() })
            if fastWait("none", 3) or Delivery.status == "capped" then
                addLog(string.format("Delivery (fast): run %d / %d done", Delivery.dailyCount, Delivery.dailyLimit))
            end
        else
            task.wait(0.2)
        end
    end

    Options.AutoDelivery:OnChanged(function(v)
        if not v then
            Delivering = false
            steerOff()
        elseif Options.AutoDeliveryFast.Value then
            task.defer(function() Options.AutoDeliveryFast:SetValue(false) end)
        end
    end)
    Options.AutoDeliveryFast:OnChanged(function(v)
        if not v then
            Delivering = false
            steerOff()
            return
        end
        addLog("Auto delivery Fast ON (risky)")
        ZeroX:Notify({ Title = "Warning: Fast delivery is risky", Content = "It teleports repeatedly and very fast. The server may flag or ban the account. Switch it off if you are not sure.", Duration = 10 })
        if Options.AutoDelivery.Value then
            task.defer(function() Options.AutoDelivery:SetValue(false) end)
        end
    end)

    task.spawn(function()
        fire("deliveryAction", { action = "refresh", requestId = nextReq() })
        local lastRewards = 0
        while not ZeroX.Unloaded do
            if os.clock() - lastRewards > 3 then
                lastRewards = os.clock()
                pcall(claimRewards, false)
                local snap = snapshot()
                if snap then
                    local text = string.format("Level %d\nMilestones ready: %d\nQuests ready: %d\nAchievements ready: %d",
                        snap.level, #snap.milestones, #snap.quests, #snap.achievements)
                    onUi(function() QuestStatus:SetDesc(text) end)
                end
            end
            if deliveryOn() and not Joining then
                if deliveryDone() then
                    Delivering = false
                    setDelivery("Done for today")
                    task.wait(2)
                else
                    Delivering = true
                    local ok, err = pcall(Options.AutoDeliveryFast.Value and deliveryStepFast or deliveryStep)
                    if not ok then
                        addLog("Delivery error: " .. tostring(err))
                        task.wait(2)
                    end
                    Delivering = false
                end
            else
                if DeliveryNote ~= "Idle" and not deliveryOn() then setDelivery("Idle") end
                task.wait(0.5)
            end
            task.wait(Options.AutoDeliveryFast.Value and 0 or 0.1)
        end
    end)
end

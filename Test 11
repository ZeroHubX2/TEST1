    local function ripple(b, pos)
        if not Lib.FX or not b.Parent then return end
        local ap, as = b.AbsolutePosition, b.AbsoluteSize
        local px, py = pos.X + inset.X, pos.Y + inset.Y
        local r = inst("Frame", {
            Name = "Ripple", AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, ZIndex = b.ZIndex + 1,
            Position = UDim2.fromScale(math.clamp((px - ap.X) / math.max(as.X, 1), 0, 1), math.clamp((py - ap.Y) / math.max(as.Y, 1), 0, 1)),
            Size = UDim2.fromScale(0, 0), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.72,
        }, b)
        round(r)
        inst("UIAspectRatioConstraint", { AspectRatio = 1, DominantAxis = Enum.DominantAxis.Width }, r)
        b.ClipsDescendants = true
        ease(r, 0.5, { Size = UDim2.fromScale(2.4, 0), BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
        task.delay(0.52, function() pcall(function() r:Destroy() end) end)
    end
    local function press(b)

        Lib.WinState = {}
        local function refit()
            local vp = viewport()
            local w, h = math.max(body.Size.X.Offset, 1), math.max(body.Size.Y.Offset, 1)
            Lib._baseScale = math.clamp(math.min((vp.X - 24) / w, (vp.Y - 24) / h, 1), 0.35, 1)
            if not Lib._animWin then fit.Scale = Lib._baseScale end
        end
        local function clampPos()
            local vp = viewport()
            local p = body.Position
            local cx, cy = p.X.Scale * vp.X + p.X.Offset, p.Y.Scale * vp.Y + p.Y.Offset
            local hw, hh = body.AbsoluteSize.X / 2, body.AbsoluteSize.Y / 2
            local nx = (hw * 2 >= vp.X) and vp.X / 2 or math.clamp(cx, hw, vp.X - hw)
            local ny = (hh * 2 >= vp.Y) and vp.Y / 2 or math.clamp(cy, hh, vp.Y - hh)
            if math.abs(nx - cx) > 0.5 or math.abs(ny - cy) > 0.5 then
                body.Position = UDim2.fromOffset(nx, ny)
            end
        end
        local function snapshot()
            local sz, p = body.Size, body.Position
            Lib.WinState.size = { sz.X.Offset, sz.Y.Offset }
            Lib.WinState.pos = { p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset }
        end
        task.delay(1.5, function() W.ready = true end)
        local function track()
            if not W.ready or Lib._folding then return end
            snapshot()
            if Lib.QueueSave then Lib:QueueSave() end
        end
        connect(body:GetPropertyChangedSignal("Size"), function()
            refit()
            layoutHeader()
            if W.active then queue(W.active) end
            track()
        end)
        connect(body:GetPropertyChangedSignal("Position"), track)
        if workspace.CurrentCamera then
            connect(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"), function()
                refit()
                task.defer(clampPos)
            end)
        end
        Lib.ApplyWindowState = function(data)
            task.delay(0.1, function()
                if type(data.__size) == "table" then
                    local w, h = tonumber(data.__size[1]), tonumber(data.__size[2])
                    if w and h then body.Size = UDim2.fromOffset(math.max(w, 420), math.max(h, 280)) end
                end
                if type(data.__pos) == "table" then
                    local a = data.__pos
                    body.Position = UDim2.new(tonumber(a[1]) or 0.5, tonumber(a[2]) or 0, tonumber(a[3]) or 0.5, tonumber(a[4]) or 0)
                end
                if type(data.__btn) == "table" and Lib.PlaceToggleButton then Lib.PlaceToggleButton(data.__btn) end
                refit()
                task.defer(clampPos)
                snapshot()
            end)
        end

        local function dragFrom(handle)
            connect(handle.InputBegan, function(i)
                if not isPress(i) then return end
                W.drag = { m = i.Position, p = body.Position }
            end)
        end
        dragFrom(head)
        dragFrom(avatar)
        dragFrom(brand)
        connect(grip.InputBegan, function(i)
            if not isPress(i) then return end
            W.size = { m = i.Position, w = body.Size.X.Offset, h = body.Size.Y.Offset, p = body.Position }
        end)
        connect(UIS.InputChanged, function(i)
            if not isMove(i) then return end
            if W.drag then
                local d = i.Position - W.drag.m
                local p = W.drag.p
                body.Position = UDim2.new(p.X.Scale, p.X.Offset + d.X, p.Y.Scale, p.Y.Offset + d.Y)
            elseif W.size then
                local d = i.Position - W.size.m
                local s = math.max(fit.Scale, 0.01)
                local nw = math.max(W.size.w + d.X / s, 420)
                local nh = math.max(W.size.h + d.Y / s, 280)
                local p = W.size.p
                body.Size = UDim2.fromOffset(nw, nh)
                body.Position = UDim2.new(p.X.Scale, p.X.Offset + (nw - W.size.w) * s / 2, p.Y.Scale, p.Y.Offset + (nh - W.size.h) * s / 2)
            end
        end)
        connect(UIS.InputEnded, function(i)
            if not isPress(i) then return end
            if W.drag then
                W.drag = nil
                task.defer(clampPos)
            end
            W.size = nil
        end)

        connect(saveBtn.MouseButton1Click, function()
            local ok, err = Lib:SaveConfig("config")
            Lib:Notify({ Title = ok and "Config saved" or "Could not save", Content = ok and Lib:Path("config.json") or tostring(err), Duration = 3 })
        end)
        connect(closeBtn.MouseButton1Click, function()
            Lib:Confirm({
                Title = "Close " .. Lib.Name .. "?",
                Content = cfg.CloseNote or "The window closes and every feature stops.",
                Button = "Close",
                Callback = function() Lib:Destroy() end,
            })
        end)

        connect(UIS.InputBegan, function(i, gp)
            if gp or Lib._binding then return end
            if i.KeyCode == Lib.ToggleKey then Lib:ToggleUI() end
        end)

        do
            local SIZE = 54
            local b = inst("ImageButton", {
                Name = "Toggle", AutoButtonColor = false, Image = "", Size = UDim2.fromOffset(SIZE, SIZE),
                Position = UDim2.fromOffset(20, math.floor(viewport().Y / 2 - SIZE / 2)),
                BackgroundColor3 = C.Bg, BackgroundTransparency = 0.05, BorderSizePixel = 0,
            }, top)
            round(b)
            glow(stroke(b, 0.3), 0.3)
            press(b)
            local logo = inst("ImageLabel", {
                BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
                Size = UDim2.new(1, -8, 1, -8), Image = LOGO_ID, ScaleType = Enum.ScaleType.Crop,
            }, b)
            round(logo)
            local logoText = text({
                Name = "LogoText", Size = UDim2.fromScale(1, 1), FontFace = F.Bold, Text = tostring(cfg.LogoText or string.upper(string.sub(Lib.Name, 1, 2))), TextSize = 18,
                TextXAlignment = Enum.TextXAlignment.Center, Visible = false,
            }, b)
            task.spawn(function()
                local t = 0
                while not logo.IsLoaded and t < 8 do
                    task.wait(0.25)
                    t = t + 0.25
                end
                if not logo.IsLoaded then
                    logo.Visible = false
                    logoText.Visible = true
                end
            end)
            Lib.OnToggle = function()
                logo.ImageTransparency = gui.Enabled and 0 or 0.45
            end
            local function clampBtn(x, y)
                local vp = viewport()
                return math.clamp(x, 0, math.max(vp.X - SIZE, 0)), math.clamp(y, 0, math.max(vp.Y - SIZE, 0))
            end
            Lib.PlaceToggleButton = function(p)
                local x, y = clampBtn(tonumber(p[1]) or 20, tonumber(p[2]) or 200)
                b.Position = UDim2.fromOffset(x, y)
                Lib.WinState.btn = { x, y }
            end
            local dragging, moved, startMouse, startPos = false, false, nil, nil
            connect(b.InputBegan, function(i)
                if isPress(i) then
                    dragging, moved, startMouse, startPos = true, false, i.Position, Vector2.new(b.Position.X.Offset, b.Position.Y.Offset)
                end
            end)
            connect(UIS.InputChanged, function(i)
                if not dragging or not isMove(i) then return end
                local d = i.Position - startMouse
                if not moved and d.Magnitude > 6 then moved = true end
                if moved then
                    local x, y = clampBtn(startPos.X + d.X, startPos.Y + d.Y)
                    b.Position = UDim2.fromOffset(x, y)
                end
            end)
            connect(UIS.InputEnded, function(i)
                if not dragging or not isPress(i) then return end
                dragging = false
                if moved then
                    Lib.WinState.btn = { b.Position.X.Offset, b.Position.Y.Offset }
                    if Lib.QueueSave then Lib:QueueSave() end
                else
                    Lib:ToggleUI()
                end
            end)
            if type(saved.__btn) == "table" then Lib.PlaceToggleButton(saved.__btn) end
        end

        do
            local H = 38
            local sb = inst("Frame", {
                Name = "StatusBar", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8),
                Size = UDim2.fromOffset(200, H), BackgroundColor3 = C.Bg, BorderSizePixel = 0, ClipsDescendants = true,
            }, top)
            surface(sb, 0.12, 0)
            round(sb)
            glow(stroke(sb, 0.88), 0.88)
            pad(sb, 5, 14, 0, 0)
            list(sb, Enum.FillDirection.Horizontal, 8, nil, Enum.VerticalAlignment.Center)
            Lib._statusBar = sb
            local sbScale = inst("UIScale", {}, sb)
            local lg = inst("ImageLabel", {
                BackgroundColor3 = C.Raise, BorderSizePixel = 0, Image = LOGO_ID, ScaleType = Enum.ScaleType.Crop,
                Size = UDim2.fromOffset(H - 10, H - 10), LayoutOrder = 1,
            }, sb)
            round(lg)
            local act = text({ Text = "", RichText = true, FontFace = F.Bold, TextSize = 12, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, H), LayoutOrder = 2 }, sb)
            local function chip(parent, order)
                local c = inst("Frame", {
                    BackgroundColor3 = C.Raise, BackgroundTransparency = 0.25, BorderSizePixel = 0,
                    AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, H - 12), LayoutOrder = order,
                }, parent)
                round(c)
                pad(c, 10, 12, 0, 0)
                list(c, Enum.FillDirection.Horizontal, 7, nil, Enum.VerticalAlignment.Center)
                local dot = inst("Frame", { BackgroundColor3 = accent(), BorderSizePixel = 0, Size = UDim2.fromOffset(6, 6), LayoutOrder = 1 }, c)
                round(dot)
                local l = text({ Text = "", FontFace = F.Semi, TextSize = 12, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, H - 12), LayoutOrder = 2 }, c)
                return l, dot
            end
            local stats = inst("Frame", { BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, H), LayoutOrder = 3 }, sb)
            list(stats, Enum.FillDirection.Horizontal, 6, nil, Enum.VerticalAlignment.Center)
            local S = {}
            S.fps, S.fpsDot = chip(stats, 1)
            S.ping, S.pingDot = chip(stats, 2)
            S.clock, S.clockDot = chip(stats, 3)
            S.run, S.runDot = chip(stats, 4)
            local function tick()
                if Lib.Unloaded then return end
                local count = 0
                for _, t in ipairs(Lib._toggles) do
                    if t.opt.Value and not Lib.StatusIgnore[t.id] then count = count + 1 end
                end
                local col = accent()
                act.Text = 'ACTIVE  <font color="' .. string.format("#%02x%02x%02x", math.floor(col.R * 255), math.floor(col.G * 255), math.floor(col.B * 255)) .. '">' .. count .. "</font>"
                local fps, ping = Lib.FPS or 0, Lib.Ping or 0
                S.fps.Text = fps .. " FPS"
                S.fpsDot.BackgroundColor3 = fps >= 55 and C.Good or (fps >= 30 and C.Warn or C.Bad)
                S.ping.Text = ping .. " ms"
                S.pingDot.BackgroundColor3 = ping < 120 and C.Good or (ping < 250 and C.Warn or C.Bad)
                S.clock.Text = os.date("%H:%M")
                S.clockDot.BackgroundColor3 = col
                local t = math.floor(os.clock() - (Lib.StartedAt or os.clock()))
                S.run.Text = string.format("Run %02d:%02d:%02d", math.floor(t / 3600), math.floor(t / 60) % 60, t % 60)
                S.runDot.BackgroundColor3 = col
                local vp = viewport()
                local sc = math.clamp(tonumber(Lib.StatusScale) or 1, 0.5, 1.5)
                sbScale.Scale = sc
                local w = 5 + 14 + (H - 10) + 8 + act.AbsoluteSize.X / sc + 8 + stats.AbsoluteSize.X / sc
                sb.Size = UDim2.fromOffset(w, H)
                local half, hh = w * sc / 2, H * sc
                local x, y
                if type(Lib.StatusPos) == "table" then
                    x, y = tonumber(Lib.StatusPos[1]) or vp.X / 2, tonumber(Lib.StatusPos[2]) or 8
                else
                    local insetL, insetR, insetY, insetH = 0, 0, 0, 0
                    pcall(function()
                        local r = game:GetService("GuiService").TopbarInset
                        insetL, insetR, insetY, insetH = r.Min.X, r.Max.X, r.Min.Y, r.Height
                    end)
                    local left = math.max(insetL + 8, 8)
                    local right = (insetR > left + 100) and (insetR - 8) or (vp.X - 8)
                    x = math.clamp(vp.X / 2, left + half, math.max(left + half, right - half))
                    y = insetH > 0 and math.floor(insetY + (insetH - hh) / 2) or 8
                end
                x = math.clamp(x, half, math.max(half, vp.X - half))
                y = math.clamp(y, 0, math.max(vp.Y - hh, 0))
                sb.Position = UDim2.fromOffset(x, y)
                local bp, bs = body.AbsolutePosition, body.AbsoluteSize
                local over = gui.Enabled and not W.sbDrag and x + half > bp.X and x - half < bp.X + bs.X and y + hh > bp.Y and y < bp.Y + bs.Y
                sb.Visible = Lib.StatusOn and not over
            end
            sb.Active = true
            connect(sb.InputBegan, function(i)
                if not isPress(i) then return end
                W.sbDrag = { m = i.Position, p = Vector2.new(sb.Position.X.Offset, sb.Position.Y.Offset) }
            end)
            connect(UIS.InputChanged, function(i)
                if not W.sbDrag or not isMove(i) then return end
                local d = i.Position - W.sbDrag.m
                if d.Magnitude < 4 and not W.sbDrag.moved then return end
                W.sbDrag.moved = true
                Lib.StatusPos = { W.sbDrag.p.X + d.X, W.sbDrag.p.Y + d.Y }
                tick()
            end)
            connect(UIS.InputEnded, function(i)
                if not W.sbDrag or not isPress(i) then return end
                local moved = W.sbDrag.moved
                W.sbDrag = nil
                if moved then
                    Lib.StatusPos = { sb.Position.X.Offset, sb.Position.Y.Offset }
                    if Lib.QueueSave then Lib:QueueSave() end
                end
            end)
            Lib._statusTick = tick
            if type(saved.__status) == "table" and tonumber(saved.__status[1]) and tonumber(saved.__status[2]) then
                Lib.StatusPos = { tonumber(saved.__status[1]), tonumber(saved.__status[2]) }
            end
            task.spawn(function()
                while not Lib.Unloaded do
                    pcall(tick)
                    task.wait(0.5)
                end
            end)
        end

        Lib.FPS, Lib.Ping, Lib.Frames = 0, 0, 0
        local frames, started = 0, os.clock()
        Lib.StartedAt = started
        local stamps = {}
        connect(RunService.RenderStepped, function()
            frames = frames + 1
            Lib.Frames = Lib.Frames + 1
            local now = os.clock()
            stamps[#stamps + 1] = now
            while stamps[1] and stamps[1] < now - 1 do table.remove(stamps, 1) end
        end)
        task.spawn(function()
            local pingItem
            pcall(function() pingItem = game:GetService("Stats").Network.ServerStatsItem["Data Ping"] end)
            while not Lib.Unloaded do
                task.wait(0.1)
                Lib.FPS = #stamps
                local ok, ping = pcall(function() return pingItem and pingItem:GetValue() or LP:GetNetworkPing() * 1000 end)
                Lib.Ping = ok and math.floor((tonumber(ping) or 0) + 0.5) or 0
            end
        end)
        task.spawn(function()
            while not Lib.Unloaded do
                Window.Minimized = not gui.Enabled
                task.wait(0.2)
            end
        end)

        layoutHeader()
        refit()
        task.defer(clampPos)
        snapshot()
        if Lib._pendingWin then
            local d = Lib._pendingWin
            Lib._pendingWin = nil
            Lib.ApplyWindowState(d)
        end
        Lib._fold = function(open, done)
            Lib._folding = true
            local vp = viewport()
            local sc = Lib._baseScale or fit.Scale
            local w, h = body.Size.X.Offset * sc, body.Size.Y.Offset * sc
            local p = body.Position
            local cx, cy = p.X.Scale * vp.X + p.X.Offset, p.Y.Scale * vp.Y + p.Y.Offset
            local savedPos = p
            local holder = inst("Frame", {
                Name = "Fold", BackgroundTransparency = 1, ClipsDescendants = true, AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromOffset(cx, cy), Size = UDim2.fromOffset(w + 6, open and 0 or h + 6), ZIndex = 2,
            }, gui)
            body.Parent = holder
            body.Position = UDim2.fromScale(0.5, 0.5)
            local function line(y, tr, lw)
                local l = inst("Frame", {
                    BackgroundColor3 = accent(), BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.fromOffset(cx, y), Size = UDim2.fromOffset(lw, 2), BackgroundTransparency = tr, ZIndex = 3,
                }, gui)
                inst("UIGradient", {
                    Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.15, 0), NumberSequenceKeypoint.new(0.85, 0), NumberSequenceKeypoint.new(1, 1),
                    }),
                }, l)
                return l
            end
            local top = line(open and cy or cy - h / 2, open and 0 or 1, open and 0 or w)
            local bot = line(open and cy or cy + h / 2, open and 0 or 1, open and 0 or w)
            local finished = false
            local function finish()
                if finished then return end
                finished = true
                body.Parent = gui
                body.Position = savedPos
                pcall(function() holder:Destroy() end)
                pcall(function() top:Destroy() end)
                pcall(function() bot:Destroy() end)
                Lib._folding = false
                if done then pcall(done) end
            end
            if open then
                ease(top, 0.26, { Size = UDim2.fromOffset(w, 2) }, Enum.EasingStyle.Quart)
                ease(bot, 0.26, { Size = UDim2.fromOffset(w, 2) }, Enum.EasingStyle.Quart)
                task.delay(0.24, function()
                    ease(holder, 0.5, { Size = UDim2.fromOffset(w + 6, h + 6) }, Enum.EasingStyle.Quint)
                    ease(top, 0.5, { Position = UDim2.fromOffset(cx, cy - h / 2), BackgroundTransparency = 1 }, Enum.EasingStyle.Quint)
                    ease(bot, 0.5, { Position = UDim2.fromOffset(cx, cy + h / 2), BackgroundTransparency = 1 }, Enum.EasingStyle.Quint)
                    task.delay(0.52, finish)
                end)
            else
                ease(holder, 0.32, { Size = UDim2.fromOffset(w + 6, 0) }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
                ease(top, 0.32, { Position = UDim2.fromOffset(cx, cy), BackgroundTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
                ease(bot, 0.32, { Position = UDim2.fromOffset(cx, cy), BackgroundTransparency = 0 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
                task.delay(0.3, function()
                    ease(top, 0.2, { Size = UDim2.fromOffset(0, 2) }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
                    ease(bot, 0.2, { Size = UDim2.fromOffset(0, 2) }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
                    task.delay(0.22, finish)
                end)
            end
            task.delay(1.5, finish)
        end
        Lib.OnToggle()
        if Lib.FX then task.defer(function() Lib._fold(true) end) end
        connect(gui.AncestryChanged, function()
            if not gui.Parent then Lib.Unloaded = true end
        end)

        return Window
    end

    function Lib:Notify(ncfg)
        pcall(function()
            Lib._toastN = (Lib._toastN or 0) + 1
            local holder = inst("Frame", {
                Name = "Toast", BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.Y,
                Size = UDim2.fromOffset(300, 0), LayoutOrder = Lib._toastN,
            }, nil)
            local f = inst("Frame", {
                BackgroundColor3 = C.Bg, BackgroundTransparency = 0.04, BorderSizePixel = 0, AutomaticSize = Enum.AutomaticSize.Y,
                Size = UDim2.fromOffset(300, 0), Position = UDim2.fromOffset(Lib.FX and 340 or 0, 0),
            }, holder)
            round(f, 16)
            stroke(f, 0.6, accent())
            pad(f, 16, 16, 12, 10)
            list(f, nil, 3)
            text({
                Text = tostring(ncfg.Title or Lib.Name), FontFace = F.Bold, TextSize = 14, TextWrapped = true,
                AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.fromScale(1, 0), LayoutOrder = 1,
            }, f)
            local content = tostring(ncfg.Content or "")
            if content ~= "" then
                text({
                    Text = content, FontFace = F.Med, TextSize = 13, TextColor3 = C.Sub, TextWrapped = true,
                    AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.fromScale(1, 0), LayoutOrder = 2,
                }, f)
            end
            inst("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 4), LayoutOrder = 3 }, f)
            local track = inst("Frame", { BackgroundColor3 = C.Track, BackgroundTransparency = 0.3, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 3), LayoutOrder = 4 }, f)
            round(track)
            local bar = inst("Frame", { BackgroundColor3 = accent(), BorderSizePixel = 0, Size = UDim2.fromScale(1, 1) }, track)
            round(bar)
            holder.Parent = toasts
            local all = {}
            for _, ch in ipairs(toasts:GetChildren()) do
                if ch:IsA("Frame") then all[#all + 1] = ch end
            end
            table.sort(all, function(x, y) return x.LayoutOrder < y.LayoutOrder end)
            for i = 1, #all - 4 do all[i]:Destroy() end
            local dur = tonumber(ncfg.Duration) or 4
            if Lib.FX then ease(f, 0.45, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back) end
            TweenService:Create(bar, TweenInfo.new(dur, Enum.EasingStyle.Linear), { Size = UDim2.fromScale(0, 1) }):Play()
            task.delay(dur, function()
                if Lib.FX and holder.Parent then
                    ease(f, 0.28, { Position = UDim2.fromOffset(340, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
                    task.wait(0.3)
                end
                pcall(function() holder:Destroy() end)
            end)
        end)
    end

    function Lib:Destroy()
        if Lib.Unloaded then return end
        Lib.Unloaded = true
        for _, c in ipairs(Lib.Conns) do pcall(function() c:Disconnect() end) end
        Lib.Conns = {}
        pcall(function() gui:Destroy() end)
        pcall(function() top:Destroy() end)
        if Lib.OnDestroy then pcall(Lib.OnDestroy) end
    end

    return Lib
end)()

Env.__ZeroXUI = Library
print("[ZeroHub UI] v" .. tostring(Library.Version) .. " loaded")
return Library

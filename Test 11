                end)
                if ok then sent = sent + 1 end
                task.wait(math.max(0.2, tonumber(Options.RedeemDelay.Value) or 0.6))
            end
        end
        addLog("Redeem codes: sent " .. sent .. " of " .. #redeemNow.codes)
        ZeroX:Notify({ Title = "Codes", Content = "Sent " .. sent .. " codes to the game", Duration = 4 })
        redeemNow.running = false
    end

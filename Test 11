        if cb then pcall(cb) end
    end
    connect(catcher.MouseButton1Click, closePopup)
    local function openPopup(anchor, w, h)
        closePopup()
        local s = Lib._fit and Lib._fit.Scale or 1
        local vp = viewport()
        local f = inst("Frame", {
            Name = "Popup", BackgroundColor3 = Color3.fromRGB(18, 18, 22), BorderSizePixel = 0,
            Size = UDim2.fromOffset(w, h), ZIndex = 51, Active = true,
        }, nil)
        if anchor then
            local ap, as = anchor.AbsolutePosition, anchor.AbsoluteSize
            local down, up = vp.Y - 10 - (ap.Y + as.Y + 6), ap.Y - 16
            local below = h * s <= down or down >= up
            h = math.min(h, math.max((below and down or up) / s, 60))
            w = math.min(w, (vp.X - 16) / s)
            f.Size = UDim2.fromOffset(w, h)
            local x = math.clamp(ap.X + as.X, w * s + 8, math.max(w * s + 8, vp.X - 8))
            f.AnchorPoint = Vector2.new(1, below and 0 or 1)
            f.Position = UDim2.fromOffset(x, below and (ap.Y + as.Y + 6) or (ap.Y - 6))
        else
            f.AnchorPoint = Vector2.new(0.5, 0.5)
            f.Position = UDim2.fromScale(0.5, 0.5)
        end
        round(f, 16)
        stroke(f, 0.88)
        local pscale = inst("UIScale", { Scale = s }, f)
        f.Parent = overlay
        Pop.frame = f
        overlay.Visible = true
        if Lib.FX then
            pscale.Scale = s * 0.88
            ease(pscale, 0.25, { Scale = s }, Enum.EasingStyle.Back)
        end
        return f
    end

    local function makeSwitch(parent, on, changed)
        local hit = inst("TextButton", { Name = "Switch", Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.fromOffset(54, 36) }, parent)
        local trk = inst("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(48, 26),
            BackgroundColor3 = C.Raise, BorderSizePixel = 0,
        }, hit)
        round(trk)
        local tline = stroke(trk, 0.85)
        local tgrad = inst("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(150, 150, 150)), Rotation = 0, Enabled = false }, trk)
        local knob = inst("Frame", {
            AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 4, 0.5, 0), Size = UDim2.fromOffset(18, 18),
            BackgroundColor3 = Color3.fromRGB(120, 120, 132), BorderSizePixel = 0, ZIndex = 2,
        }, trk)
        round(knob)
        local kc = icon("check", 10, knob, accent())
        kc.AnchorPoint = Vector2.new(0.5, 0.5)
        kc.Position = UDim2.fromScale(0.5, 0.5)
        kc.ZIndex = 3
        local sw = { Value = on and true or false }
        local function paint(anim)
            local pos = sw.Value and UDim2.new(1, -22, 0.5, 0) or UDim2.new(0, 4, 0.5, 0)
            local col = sw.Value and accent() or C.Raise
            local kcol = sw.Value and Color3.new(1, 1, 1) or Color3.fromRGB(120, 120, 132)
            tgrad.Enabled = sw.Value
            kc.ImageColor3 = accent()
            if anim then
                if Lib.FX then knob.Size = UDim2.fromOffset(26, 18) end
                ease(knob, 0.35, { Position = pos, Size = UDim2.fromOffset(18, 18), BackgroundColor3 = kcol }, Enum.EasingStyle.Back)
                tw(trk, 0.2, { BackgroundColor3 = col })
                tw(tline, 0.2, { Color = sw.Value and accent() or C.Line, Transparency = sw.Value and 0.4 or 0.85 })
                kc.Size = UDim2.fromOffset(0, 0)
                kc.Visible = sw.Value
                if sw.Value then ease(kc, 0.3, { Size = UDim2.fromOffset(10, 10) }, Enum.EasingStyle.Back) end
            else
                knob.Position = pos
                knob.BackgroundColor3 = kcol
                trk.BackgroundColor3 = col
                tline.Color = sw.Value and accent() or C.Line
                tline.Transparency = sw.Value and 0.4 or 0.85
                kc.Visible = sw.Value
                kc.Size = UDim2.fromOffset(10, 10)
            end
        end
        function sw.set(v)
            v = v and true or false
            if v == sw.Value then return end
            sw.Value = v
            paint(true)
        end
        onAccent(function() paint(false) end)
        connect(hit.MouseButton1Click, function()
            sw.Value = not sw.Value
            paint(true)
            if sw.Value and Lib.FX then
                local ring = inst("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(18, 18),
                    BackgroundTransparency = 1, ZIndex = 3,
                }, trk)
                round(ring)
                local rs = inst("UIStroke", { Color = accent(), Thickness = 2 }, ring)
                ease(ring, 0.45, { Size = UDim2.fromOffset(46, 46) }, Enum.EasingStyle.Quad)
                ease(rs, 0.45, { Transparency = 1, Thickness = 0.5 }, Enum.EasingStyle.Quad)
                task.delay(0.47, function() pcall(function() ring:Destroy() end) end)
            end
            changed(sw.Value)
        end)
        return sw
    end


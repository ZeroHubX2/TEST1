        Description = "Only on your screen: the profile card, profile page, player list and the name above your character show discord.gg/22RuqrckH. Other players still see your real name.",
        Default = false,
    })
    do
        local NAME_TEXT = "discord.gg/22RuqrckH"
        local USER_TEXT = "@discord.gg/22RuqrckH"
        local original = {}
        local watched = {}
        local function replacement(t)
            if t == LocalPlayer.DisplayName or t == LocalPlayer.Name then return NAME_TEXT end
            if t == "@" .. LocalPlayer.Name or t == "@" .. LocalPlayer.DisplayName then return USER_TEXT end
            return nil
        end
        local function enabled()
            return Options.HideName and Options.HideName.Value and not ZeroX.Unloaded
        end
        local function apply(o)
            if not enabled() then return end
            local new = replacement(o.Text)
            if new then
                original[o] = o.Text
                pcall(function() o.Text = new end)
            end
        end
        local function consider(o)
            if not (o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox")) then return end
            if watched[o] then return end
            if not replacement(o.Text) then return end
            watched[o] = o:GetPropertyChangedSignal("Text"):Connect(function() apply(o) end)
            apply(o)
        end
        local function scanTarget(root)
            if not root then return end
            for _, d in ipairs(root:GetDescendants()) do
                if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                    consider(d)
                end
            end
        end
        local function scan()
            if LocalPlayer.Character then scanTarget(LocalPlayer.Character) end
            local pgui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
            if pgui then
                scanTarget(pgui:FindFirstChild("LobbyHUD", true))
                scanTarget(pgui:FindFirstChild("HUD", true))
                scanTarget(pgui:FindFirstChild("Profile", true))
                scanTarget(pgui:FindFirstChild("Waiting", true))
                for _, folderName in ipairs({ "UI Animation (Working)", "UI Animation (Finished)" }) do
                    local f = pgui:FindFirstChild(folderName)
                    if f then
                        scanTarget(f:FindFirstChild("LobbyHUD", true))
                        scanTarget(f:FindFirstChild("Profile", true))
                        scanTarget(f:FindFirstChild("HUD", true))
                        scanTarget(f:FindFirstChild("Waiting", true))
                    end
                end
            end
            local coreList
            pcall(function() coreList = game:GetService("CoreGui"):FindFirstChild("PlayerList") end)
            if coreList then scanTarget(coreList) end
        end
        local function restore()
            for o, c in pairs(watched) do pcall(function() c:Disconnect() end) end
            watched = {}
            for o, txt in pairs(original) do
                pcall(function() if o.Parent and replacement(txt) then o.Text = txt end end)
            end
            original = {}
        end
        Options.HideName:OnChanged(function(on)
            if on then scan() else restore() end
        end)
        local function hookRoot(root)
            if not root then return end
            table.insert(ZeroX.Conns, root.DescendantAdded:Connect(function(d)
                if enabled() then task.defer(consider, d) end
            end))
        end
        pcall(function()
            local coreList = game:GetService("CoreGui"):WaitForChild("PlayerList", 5)
            if coreList then hookRoot(coreList) end
        end)
        local pgui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if pgui then hookRoot(pgui) end
        if LocalPlayer.Character then hookRoot(LocalPlayer.Character) end
        table.insert(ZeroX.Conns, LocalPlayer.CharacterAdded:Connect(function(char)
            hookRoot(char)
            if enabled() then task.defer(scan) end
        end))
        if enabled() then task.defer(scan) end
    end

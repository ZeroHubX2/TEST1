                NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(0.58, 0.6), NumberSequenceKeypoint.new(1, 0.85),
            }),
        }, st)
        local e = { st = st, g = g, base = base }
        function e.paint()
            if Lib.FX then
                st.Color = accent()
                st.Transparency = 0
                g.Enabled = true
            else

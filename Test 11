local function purgeOldGuis()
    local containers = {}
    pcall(function() if gethui then table.insert(containers, gethui()) end end)
    pcall(function() table.insert(containers, game:GetService("CoreGui")) end)
    pcall(function()
        local lp = game:GetService("Players").LocalPlayer
        if lp and lp:FindFirstChildOfClass("PlayerGui") then
            table.insert(containers, lp:FindFirstChildOfClass("PlayerGui"))
        end
    end)
    for _, cont in ipairs(containers) do
        pcall(function()
            local toDestroy = {}
            for _, ch in ipairs(cont:GetDescendants()) do
                if ch:IsA("ScreenGui") and (ch.Name == "Cascade" or ch.Name == "ZX_Toggle" or ch.Name == "ZeroWhiteScreen" or ch.Name == "ZX_AutoJoinSplash" or ch.Name == "Container") then
                    table.insert(toDestroy, ch)
                end
            end
            for _, ch in ipairs(cont:GetChildren()) do
                if ch:IsA("ScreenGui") and (ch.Name == "Cascade" or ch.Name == "ZX_Toggle" or ch.Name == "ZeroWhiteScreen" or ch.Name == "ZX_AutoJoinSplash" or ch.Name == "Container") then
                    table.insert(toDestroy, ch)
                end
            end
            for _, ch in ipairs(toDestroy) do
                pcall(function() ch.Enabled = false end)
                pcall(function() ch:Destroy() end)
            end
        end)
    end
    if Env.Options then table.clear(Env.Options) end
end

local function getTraitCharacterOptions()
    restoreIdentity()
    local opts = { "Equipped Slot 1 (Active)" }
    local RS = game:GetService("ReplicatedStorage")
    local acc, charsMod, traitMod
    pcall(function() acc = require(RS.global.stores.accountNamespace) end)
    pcall(function() charsMod = require(RS.global.constants.characters) end)
    pcall(function() traitMod = require(RS.assets.config.Traits.traitConfig) end)
    local charsByName = charsMod and charsMod.charactersByName
    local store = acc and acc.getLocalPlayerAccount()
    local state = store and store.state
    if not state then return opts end

    local traitMap = {}
    if type(traitMod) == "table" then
        for _, tr in ipairs(traitMod) do
            if tr.Id then traitMap[tr.Id] = tr end
        end
    end

    local function val(x)
        if type(x) == "table" and x.current ~= nil then return x.current end
        if type(x) == "table" and x.get then
            local ok, r = pcall(x.get, x)
            if ok then return r end
        end
        return x
    end

    local eqSlot1Idx = val(state.EquippedCharacterSlots and state.EquippedCharacterSlots.Slot1)
    local eqSlot1Data = eqSlot1Idx and state.UnlockedCharacters and state.UnlockedCharacters["Slot" .. tostring(eqSlot1Idx)]
    local eqSlot1Cid = (eqSlot1Data and val(eqSlot1Data.Character)) or val(state.character)
    if eqSlot1Cid and eqSlot1Cid ~= "" then
        local def = charsByName and charsByName[eqSlot1Cid]
        local dname = def and def.displayName or eqSlot1Cid
        local cdata = state.CharactersData and state.CharactersData[eqSlot1Cid]
        local tid = cdata and cdata.TraitData and val(cdata.TraitData.Trait)
        local tobj = tid and traitMap[tid]
        local trName = tobj and tobj.Name or (tid == 0 and "None" or tostring(tid or "None"))
        opts[1] = string.format("Equipped Slot 1: %s (%s) [%s]", dname, eqSlot1Cid, trName)
    end

    local slotEntries = {}
    if state.UnlockedCharacters then
        for slotKey, slotData in pairs(state.UnlockedCharacters) do
            local sNum = tonumber(slotKey:match("^Slot(%d+)"))
            if sNum and type(slotData) == "table" then
                local isUnlocked = val(slotData.Unlocked)
                local cid = val(slotData.Character)
                if isUnlocked and type(cid) == "string" and cid ~= "" and cid ~= "_order" and cid ~= "_dirty" then
                    local def = charsByName and charsByName[cid]
                    local dname = def and def.displayName or cid
                    local cdata = state.CharactersData and state.CharactersData[cid]
                    local tid = cdata and cdata.TraitData and val(cdata.TraitData.Trait)
                    local tobj = tid and traitMap[tid]
                    local trName = tobj and tobj.Name or (tid == 0 and "None" or tostring(tid or "None"))
                    local trRar = tobj and tobj.Rarity or "None"
                    table.insert(slotEntries, {
                        slot = sNum,
                        label = string.format("Slot %d: %s (%s) - %s [%s]", sNum, dname, cid, trName, trRar),
                    })
                end
            end
        end
    end
    table.sort(slotEntries, function(a, b) return a.slot < b.slot end)
    for _, e in ipairs(slotEntries) do
        table.insert(opts, e.label)
    end
    return opts
end

local function getTargetTraitCharInfo(selected)
    restoreIdentity()
    local RS = game:GetService("ReplicatedStorage")
    local acc, charsMod
    pcall(function() acc = require(RS.global.stores.accountNamespace) end)
    pcall(function() charsMod = require(RS.global.constants.characters) end)
    local charsByName = charsMod and charsMod.charactersByName
    local store = acc and acc.getLocalPlayerAccount()
    local state = store and store.state
    if not state then return nil, nil end

    local function val(x)
        if type(x) == "table" and x.current ~= nil then return x.current end
        if type(x) == "table" and x.get then
            local ok, r = pcall(x.get, x)
            if ok then return r end
        end
        return x
    end

    local selStr = tostring(selected or "")
    local selLower = selStr:lower()

    if selStr == "" or selLower:find("equipped") or selLower:find("active") or selLower:find("first") then
        local slotIdx = val(state.EquippedCharacterSlots and state.EquippedCharacterSlots.Slot1)
        local slotData = slotIdx and state.UnlockedCharacters and state.UnlockedCharacters["Slot" .. tostring(slotIdx)]
        local cid = (slotData and val(slotData.Character)) or val(state.character)
        if type(cid) == "string" and cid ~= "" then
            local def = charsByName and charsByName[cid]
            local dname = def and def.displayName or cid
            return cid, dname
        end
        return nil, nil
    end

    local cid = selStr:match("%(([%w_]+)%)")
    if cid and cid ~= "" then
        if (state.CharactersData and state.CharactersData[cid]) or (charsByName and charsByName[cid]) then
            local def = charsByName and charsByName[cid]
            local dname = def and def.displayName or cid
            return cid, dname
        end
    end

    local sNum = tonumber(selStr:match("Slot%s*(%d+)"))
    if sNum and state.UnlockedCharacters then
        local slotData = state.UnlockedCharacters["Slot" .. tostring(sNum)]
        local cid2 = slotData and val(slotData.Character)
        if type(cid2) == "string" and cid2 ~= "" then
            local def = charsByName and charsByName[cid2]
            local dname = def and def.displayName or cid2
            return cid2, dname
        end
    end

    return nil, nil
end


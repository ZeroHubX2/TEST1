            end
        end)
        for _, cont in ipairs(containers) do
            pcall(function()
                local toDestroy = {}
                for _, ch in ipairs(cont:GetDescendants()) do
                    if ch:IsA("ScreenGui") and (ch.Name == "Cascade" or ch.Name == "ZeroXUI" or ch.Name == "ZX_Toggle" or ch.Name == "ZeroWhiteScreen" or ch.Name == "ZX_AutoJoinSplash" or ch.Name == "Container") then

                    ValueChanged = function(_, v)
                        local nv = norm(v)
                        if nv == nil then nv = opt.Value end
                        local shown = nv ~= nil and tostring(nv) or ""
                        if tostring(v) ~= shown then setProp(field, "Value", shown) end
                        if nv == opt.Value then return end
                        opt.Value = nv
                        opt:_fire()
                    end,
                })
                function opt:SetValue(v)
                    local nv = norm(v)
                    if nv == nil then nv = self.Value end

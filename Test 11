    if not floorY then return allEnemies end
    local list = {}
    for _, e in ipairs(allEnemies) do
        if e.boss or isBoss(e.name) or math.abs(e.part.Position.Y - floorY) < 65 then
            table.insert(list, e)
        end
    end
    return #list > 0 and list or allEnemies
end

local function floodEscapeTarget(from)
    local currentFloor = tonumber(workspace:GetAttribute("FloodFloor")) or 0
    local phase = workspace:GetAttribute("FloodPhase") or "fight"
    local leverAt = workspace:GetAttribute("FloodLeverAt")
    local gatePct = tonumber(workspace:GetAttribute("FloodGate")) or 0
    local isRoof = (workspace:GetAttribute("FloodRoof") == true) or (from.Y > 650) or (currentFloor >= 11 and from.Y > 645)

    local allEnemies = getEnemies()
    learnFrom(allEnemies)
    local floorEnemies = getFloorEnemies(currentFloor, allEnemies)
    local bossImmune = isBossImmune()

    if isRoof then
        if #allEnemies > 0 then

            if bossImmune then
                local minionTarget, bestMinionDist = nil, nil
                for _, e in ipairs(allEnemies) do
                    if not e.boss and not isBoss(e.name) then
                        local d = (e.part.Position - from).Magnitude
                        if not bestMinionDist or d < bestMinionDist then
                            minionTarget, bestMinionDist = e, d
                        end
                    end
                end
                if minionTarget then
                    return minionTarget, minionTarget
                end
            end

            local bossTarget, bestBossScore = nil, nil
            for _, e in ipairs(allEnemies) do
                if e.boss or isBoss(e.name) then
                    local dist = (e.part.Position - from).Magnitude
                    local score = (e.health or 1e6) + dist * 0.1
                    if not bestBossScore or score < bestBossScore then
                        bossTarget, bestBossScore = e, score
                    end
                end
            end
            if bossTarget then
                return bossTarget, bossTarget
            end

            local nearest, nearestDist = nil, nil
            for _, e in ipairs(allEnemies) do
                local d = (e.part.Position - from).Magnitude
                if not nearestDist or d < nearestDist then
                    nearest, nearestDist = e, d
                end
            end
            return nearest, nearest
        else

            local roofMarker = getFloorMarker(12)
            local pos = roofMarker and roofMarker.Position or Vector3.new(-215, 678.6, -71)
            return { point = pos + Vector3.new(0, 4, 0), name = "Roof Boss Stage (Waiting)", waypoint = true }, nil
        end
    end

    local bossTarget, bestBossScore = nil, nil
    for _, e in ipairs(allEnemies) do
        if e.boss or isBoss(e.name) then
            local dist = (e.part.Position - from).Magnitude
            local score = (e.health or 1e6) + dist * 0.1
            if not bestBossScore or score < bestBossScore then
                bossTarget, bestBossScore = e, score
            end
        end
    end

    if bossTarget then

        if bossImmune then
            local minionTarget, bestMinionDist = nil, nil
            for _, e in ipairs(allEnemies) do
                if not e.boss and not isBoss(e.name) then
                    local d = (e.part.Position - from).Magnitude
                    if not bestMinionDist or d < bestMinionDist then
                        minionTarget, bestMinionDist = e, d
                    end
                end
            end
            if minionTarget then
                return minionTarget, minionTarget
            end
        end
        return bossTarget, bossTarget
    end

    local activePrompt, leverPart
    if phase == "block" and leverAt ~= nil then
        activePrompt, leverPart = findActiveLever(currentFloor)
    end
    if activePrompt and activePrompt.Enabled and leverPart then
        return {
            point = leverPart.Position + Vector3.new(0, 2, 0),
            name = "Floor " .. currentFloor .. " Lever",
            waypoint = true,
            leverPrompt = activePrompt,
            leverPart = leverPart,
        }, nil
    end
    if phase == "block" and typeof(leverAt) == "Vector3" then
        return { point = leverAt + Vector3.new(0, 2, 0), name = "Floor " .. currentFloor .. " Lever", waypoint = true }, nil
    end

    local world = workspace:FindFirstChild("World")
    local mapObjs = world and world:FindFirstChild("MapObjects")
    local gateZone = mapObjs and mapObjs:FindFirstChild("FloodGateZone")
    if (phase == "block" or gateZone) and phase ~= "drain" and gatePct < 1 then
        local zoneCenter = gateZone and gateZone.Position
        if not zoneCenter then
            local fl = getFloorMarker(currentFloor)
            zoneCenter = fl and fl.Position or from
        end

        local bestEnemy, bestDist = nil, nil
        for _, e in ipairs(floorEnemies) do
            local d = (e.part.Position - zoneCenter).Magnitude
            if not bestDist or d < bestDist then
                bestEnemy = e
                bestDist = d
            end
        end

        if bestEnemy then
            local enemyDistFromZone = (bestEnemy.part.Position - zoneCenter).Magnitude

            if gatePct >= 0.95 or enemyDistFromZone > 20 then
                return bestEnemy, bestEnemy
            else

                local flat = (bestEnemy.part.Position - zoneCenter) * Vector3.new(1, 0, 1)
                local offset = flat.Magnitude > 0.1 and (flat.Unit * math.min(flat.Magnitude, 10)) or Vector3.zero
                local standPoint = zoneCenter + offset + Vector3.new(0, 3.5, 0)
                return {
                    part = bestEnemy.part,
                    point = standPoint,
                    name = bestEnemy.name,
                    boss = bestEnemy.boss,
                    health = bestEnemy.health,
                    maxHealth = bestEnemy.maxHealth,
                    gateDefend = true,
                }, bestEnemy
            end
        else
            return {
                point = zoneCenter + Vector3.new(0, 3.5, 0),
                name = "Gate Circle (Holding)",
                waypoint = true,
            }, nil
        end
    end

    if phase == "drain" or gatePct >= 1 then
        local nextFloor = currentFloor + 1
        local marker = getFloorMarker(nextFloor)
        if marker then
            local targetPos = marker.Position + Vector3.new(0, 3.5, 0)
            return {
                point = targetPos,
                name = (nextFloor > 11 and "Roof Boss Stage" or ("Climbing to Floor " .. nextFloor)),
                waypoint = true,
            }, nil
        end
    end

    if #floorEnemies > 0 then
        local nearest, nearestDist = nil, nil
        for _, e in ipairs(floorEnemies) do
            local d = (e.part.Position - from).Magnitude
            if not nearestDist or d < nearestDist then nearest, nearestDist = e, d end
        end
        local mode = Options.TargetMode.Value
        local best, bestScore = nil, nil
        for _, e in ipairs(floorEnemies) do
            local dist = (e.part.Position - from).Magnitude
            local score = (e.boss and 0 or 1e6) + (mode == "Lowest HP" and e.health or dist)
            if not bestScore or score < bestScore then best, bestScore = e, score end
        end
        return best or nearest, nearest
    end

    local marker = getFloorMarker(currentFloor > 0 and currentFloor or 1)
    if marker then
        local fallbackPos = (currentFloor == 0 and Vector3.new(-115, 3.5, 300)) or (marker.Position + Vector3.new(0, 3.5, 0))
        return { point = fallbackPos, name = (currentFloor == 0 and "Parking Waiting" or ("Floor " .. currentFloor)), waypoint = true }, nil
    end

    return nil, nil
end


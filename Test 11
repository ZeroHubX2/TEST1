    -- Auto Trait Worker Thread
    task.spawn(function()
        local rollCount = 0
        while not ZeroX.Unloaded do
            if Options.AutoTrait and Options.AutoTrait.Value then
                local okLoop, errLoop = pcall(function()
                    local targetChar, dname = getTargetTraitCharInfo(Options.TraitSlot and Options.TraitSlot.Value)
                    if not targetChar then
                        traitNow.say("Error: Target character not found")
                        Options.AutoTrait:SetValue(false)
                        return
                    end

                    -- Check currency before rolling
                    local store = AccountStore and AccountStore.getLocalPlayerAccount()
                    local st = store and store.state
                    local rerolls = (st and st.currencies and val(st.currencies.traitRerolls)) or 0
                    if rerolls <= 0 then
                        traitNow.say("Stopped: Out of Trait Reroll tokens!")
                        ZeroX:Notify({ Title = "Auto Trait Stopped", Content = "Out of Trait Reroll tokens!", Duration = 8 })
                        Options.AutoTrait:SetValue(false)
                        return
                    end

                    -- Check if current trait already matches
                    if rollCount == 0 and st and st.CharactersData and st.CharactersData[targetChar] then
                        local cdata = st.CharactersData[targetChar]
                        local curTid = cdata.TraitData and val(cdata.TraitData.Trait)
                        local curMatch = curTid and traitNow.checkMatch(curTid)
                        if curMatch then
                            traitNow.say(string.format("Already has %s! Stopping.", curMatch))
                            ZeroX:Notify({ Title = "Auto Trait", Content = string.format("%s already has %s!", dname, curMatch), Duration = 8 })
                            Options.AutoTrait:SetValue(false)
                            return
                        end
                    end

                    local res, err = rollOnce(targetChar)
                    if not Options.AutoTrait.Value then return end

                    if not res then
                        addLog("Trait reroll timed out, retrying...")
                        traitNow.say("Server timeout, retrying...")
                        task.wait(1)
                        return
                    end

                    if not res.success then
                        local reason = (res.reason and res.reason ~= "") and res.reason or "Failed"
                        addLog("Trait reroll stopped: " .. reason)
                        traitNow.say("Stopped: " .. reason)
                        ZeroX:Notify({ Title = "Auto Trait Stopped", Content = reason, Duration = 8 })
                        Options.AutoTrait:SetValue(false)
                        return
                    end

                    rollCount = rollCount + 1
                    local tobj = traitMap[res.traitId]
                    local trName = tobj and tobj.Name or tostring(res.traitId)
                    local trRar = tobj and tobj.Rarity or "Unknown"

                    traitNow.say(string.format("[%s] | Rolls: %d | Got: %s [%s] | Tokens: %d",
                        dname, rollCount, trName, trRar, math.max(0, rerolls - 1)))
                    pcall(traitNow.refresh)
                    task.delay(0.2, function() pcall(traitNow.refresh) end)

                    -- Check if target trait/rarity reached
                    local hit = traitNow.checkMatch(res.traitId)
                    if hit then
                        addLog(string.format("Auto Trait finished: %s rolled %s [%s] after %d rolls", dname, trName, trRar, rollCount))
                        Options.AutoTrait:SetValue(false)
                        ZeroX:Notify({
                            Title = "🎉 Trait Reroll Success!",
                            Content = string.format("%s got %s [%s] in %d rolls!", dname, trName, trRar, rollCount),
                            Duration = 10
                        })
                        traitNow.say(string.format("SUCCESS! Got %s [%s] in %d rolls", trName, trRar, rollCount))
                        rollCount = 0
                        return
                    end
                end)

                if not okLoop then
                    addLog("Trait loop error: " .. tostring(errLoop))
                    traitNow.say("Loop error: " .. tostring(errLoop))
                    task.wait(1)
                end

                local delayTime = math.max(0.1, tonumber(Options.TraitDelay and Options.TraitDelay.Value) or 0.5)
                task.wait(delayTime)
            else
                rollCount = 0
                task.wait(0.5)
            end
        end
    end)


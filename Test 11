    local function sfx(key, vol)
        if not Lib.SoundOn or Lib.Unloaded then return end
        local def = SFX[key]
        if not def then return end
        local now = os.clock()
        if sfxLast[key] and now - sfxLast[key] < 0.05 then return end
        sfxLast[key] = now
        pcall(function()
            local snd = sfxCache[key]
            if not snd then
                snd = Instance.new("Sound")
                snd.Name = key
                snd.SoundId = def[1]
                snd.PlaybackSpeed = def[2] or 1
                snd.Parent = sfxFolder or game:GetService("SoundService")
                sfxCache[key] = snd
            end
            snd.Volume = math.clamp((tonumber(Lib.Volume) or 0.5) * (vol or 1) * (def[3] or 1) * 1.6, 0, 3)
            game:GetService("SoundService"):PlayLocalSound(snd)
        end)
    end

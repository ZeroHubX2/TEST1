task.spawn(function()
    while not isClosed() do
        local ok, err = pcall(function()
            local _, hum, hrp = getCharacter()
            local st = runState()

            RunActive = st.status == "active"
            if hrp and Options.AutoFarm.Value and st.status == "active" then
                local prev = Target and Target.part
                Target, AimTarget = pickTarget(hrp.Position)
                local charName = currentCharacterName()
                if charName ~= AimSkillsFor then
                    AimSkills, AimSkillsFor = aimSlotsFor(charName), charName
                end
                if Target and Target.part ~= prev and Target.boss then
                    addLog("Boss target: " .. displayName(Target.name))
                end
                failsafeTick(hum, hrp)
                combatTick(hrp)
                useExit(hrp, Target)
                useArise(hrp, Target)
                useLever(hrp, Target)
            elseif hrp and Options.AutoFarm.Value then
                local nextTarget = (Stage.idleCentre and centreTarget())
                    or (Stage.nextArea and areaTarget())
                    or centreTarget()
                    or areaTarget()
                Target, AimTarget = nextTarget, nil
                Retreating = false
                setAttack(false)
            else
                Target, AimTarget = nil, nil
                Retreating = false
                setAttack(false)
            end

            trialsTick()
            pickFateBlessing()
            runTick(st)
            statusTick(st, hum)
        end)
        restoreIdentity()
        if not ok then addLog("Error: " .. tostring(err)) end
        task.wait(0.05)
    end
    cleanup()
end)


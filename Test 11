    -- Real-time countdown & auto refresh loop
    task.spawn(function()
        local lastDay = nil
        local lastRefreshClock = 0

        while not ZeroX.Unloaded do
            pcall(function()
                if getModules() then
                    local now = workspace:GetServerTimeNow()
                    local day = shopCfg.GetDay(now)
                    local resetTime = shopCfg.GetResetTime(day)
                    local diff = math.max(0, math.floor(resetTime - now))
                    local h = diff // 3600
                    local m = (diff % 3600) // 60
                    local s = diff % 60
                    local timerStr = string.format("%02d:%02d:%02d", h, m, s)

                    onUi(function()
                        if ShopRestock then
                            ShopRestock:SetDesc(string.format("%s (Daily reset at 00:00 UTC / 07:00 AM ICT)", timerStr))
                        end
                    end)

                    local clockNow = os.clock()
                    if day ~= lastDay or (clockNow - lastRefreshClock >= 3) then
                        lastDay = day
                        lastRefreshClock = clockNow
                        if refreshShopData then refreshShopData() end
                    end
                end
            end)
            task.wait(1)
        end
    end)

    -- Auto buy worker loop
    task.spawn(function()
        while not ZeroX.Unloaded do
            local waitTime = tonumber(Options.AutoBuyDelay and Options.AutoBuyDelay.Value) or 5
            task.wait(waitTime)

            if not ZeroX.Unloaded and not buying then
                local isAutoBuy = Options.AutoBuy and Options.AutoBuy.Value
                local isAutoBuyAll = Options.AutoBuyAll and Options.AutoBuyAll.Value

                if isAutoBuyAll then
                    for _, info in ipairs(currentItemsList) do
                        if ZeroX.Unloaded or not (Options.AutoBuyAll and Options.AutoBuyAll.Value) then break end
                        if info.left > 0 then
                            local userMoney = getPlayerMoney()
                            if userMoney >= info.price then
                                local affordable = math.floor(userMoney / info.price)
                                local buyQty = math.min(info.left, affordable)
                                if buyQty > 0 then
                                    doBuy(info.id, buyQty, info.name, info.price, true)
                                    task.wait(0.5)
                                    if refreshShopData then refreshShopData() end
                                end
                            end
                        end
                    end
                elseif isAutoBuy then
                    local picked = tostring(Options.ShopBuyItem and Options.ShopBuyItem.Value or "")
                    local id = picked:match("^%[(%d+)%]")
                    local info = id and itemDataMap[id]
                    if info and info.left > 0 then
                        local reqQty = math.floor(tonumber(Options.ShopBuyAmount and Options.ShopBuyAmount.Value) or 1)
                        local userMoney = getPlayerMoney()
                        if userMoney >= info.price then
                            local affordable = math.floor(userMoney / info.price)
                            local buyQty = math.min(info.left, math.min(reqQty, affordable))
                            if buyQty > 0 then
                                doBuy(info.id, buyQty, info.name, info.price, true)
                                task.wait(0.5)
                                if refreshShopData then refreshShopData() end
                            end
                        end
                    end
                end
            end
        end
    end)
end

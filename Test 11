        Lib._tabStep = function(dt)
            local tab = W.active
            if not (tab and tab.pill and W.ix and gui.Enabled) then return end
            dt = math.min(dt, 1 / 30)
            local x, w = W.indTarget(tab)
            W.vx = W.vx + ((x - W.ix) * 420 - W.vx * 41) * dt
            W.vw = W.vw + ((w - W.iw) * 420 - W.vw * 41) * dt
            W.ix = W.ix + W.vx * dt
            W.iw = W.iw + W.vw * dt

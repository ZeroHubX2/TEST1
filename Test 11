    local function openPopup(anchor, w, h)
        closePopup()
        local s = Lib._fit and Lib._fit.Scale or 1
        local vp = viewport()
        local f = inst("Frame", {
            Name = "Popup", BackgroundColor3 = Color3.fromRGB(26, 30, 50), BorderSizePixel = 0,
            Size = UDim2.fromOffset(w, h), ZIndex = 51, Active = true,
        }, nil)
        if anchor then
            local ap, as = anchor.AbsolutePosition, anchor.AbsoluteSize
            local down, up = vp.Y - 10 - (ap.Y + as.Y + 6), ap.Y - 16
            local below = h * s <= down or down >= up
            h = math.min(h, math.max((below and down or up) / s, 60))
            w = math.min(w, (vp.X - 16) / s)
            f.Size = UDim2.fromOffset(w, h)
            local x = math.clamp(ap.X + as.X, w * s + 8, math.max(w * s + 8, vp.X - 8))
            f.AnchorPoint = Vector2.new(1, below and 0 or 1)
            f.Position = UDim2.fromOffset(x, below and (ap.Y + as.Y + 6) or (ap.Y - 6))
        else
            f.AnchorPoint = Vector2.new(0.5, 0.5)
            f.Position = UDim2.fromScale(0.5, 0.5)
        end
        round(f, 16)
        stroke(f, 0.88)
        local pscale = inst("UIScale", { Scale = s }, f)
        f.Parent = overlay
        Pop.frame = f
        overlay.Visible = true
        if Lib.FX then
            pscale.Scale = s * 0.88
            ease(pscale, 0.25, { Scale = s }, Enum.EasingStyle.Back)
        end
        return f
    end

    local function makeSwitch(parent, on, changed)
        local hit = inst("TextButton", { Name = "Switch", Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.fromOffset(56, 40) }, parent)
        local trk = inst("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(54, 30),
            BackgroundColor3 = C.Track, BorderSizePixel = 0,
        }, hit)
        round(trk)
        local knob = inst("Frame", {
            AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 4, 0.5, 0), Size = UDim2.fromOffset(22, 22),
            BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
        }, trk)
        round(knob)
        local sw = { Value = on and true or false }
        local function paint(anim)
            local pos = sw.Value and UDim2.new(1, -26, 0.5, 0) or UDim2.new(0, 4, 0.5, 0)
            local col = sw.Value and accent() or C.Track
            if anim then
                if Lib.FX then knob.Size = UDim2.fromOffset(30, 22) end
                ease(knob, 0.3, { Position = pos, Size = UDim2.fromOffset(22, 22) }, Enum.EasingStyle.Back)
                tw(trk, 0.2, { BackgroundColor3 = col })
            else
                knob.Position = pos
                trk.BackgroundColor3 = col
            end
        end
        function sw.set(v)
            v = v and true or false
            if v == sw.Value then return end
            sw.Value = v
            paint(true)
        end
        onAccent(function() paint(false) end)
        connect(hit.MouseButton1Click, function()
            sw.Value = not sw.Value
            paint(true)
            changed(sw.Value)
        end)
        return sw
    end


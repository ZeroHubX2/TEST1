                    local have = tonumber(t.material and t.material[id]) or 0
                    table.insert(list, { name = def and def.Name or id, have = have, need = tonumber(amt) or 0 })
                end
            end
            for _, c in ipairs(cfg.currencies or {}) do
                local have = tonumber(t.currencies and t.currencies[c.currency]) or 0
                local name = c.currency == "gems" and "Gems" or (c.currency == "money" and "Coins" or c.currency)
                table.insert(list, { name = name, have = have, need = tonumber(c.amount) or 0, currency = true })
            end
            return list
        end


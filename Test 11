local Flying = false
local FlyBodyVel, FlyBodyGyro
local function updateFly()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (Options.Fly and Options.Fly.Value and hrp and hum and hum.Health > 0 and not ZeroX.Unloaded) then
        if Flying then
            Flying = false
            if FlyBodyVel then FlyBodyVel:Destroy(); FlyBodyVel = nil end
            if FlyBodyGyro then FlyBodyGyro:Destroy(); FlyBodyGyro = nil end
            if hum then hum.PlatformStand = false end
        end
        return
    end

    if not Flying then
        Flying = true
        FlyBodyVel = Instance.new("BodyVelocity")
        FlyBodyVel.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        FlyBodyVel.Velocity = Vector3.zero
        FlyBodyVel.Parent = hrp

        FlyBodyGyro = Instance.new("BodyGyro")
        FlyBodyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
        FlyBodyGyro.P = 10000
        FlyBodyGyro.CFrame = hrp.CFrame
        FlyBodyGyro.Parent = hrp
    end

    hum.PlatformStand = true
    local cam = workspace.CurrentCamera
    local speed = (Options.FlySpeed and Options.FlySpeed.Value) or 50
    local moveDir = hum.MoveDirection
    local vel = Vector3.zero

    if moveDir.Magnitude > 0.05 and cam then
        local camCFrame = cam.CFrame
        local relMove = camCFrame:VectorToObjectSpace(moveDir)
        local flightDir = camCFrame.LookVector * (-relMove.Z) + camCFrame.RightVector * relMove.X
        if flightDir.Magnitude > 0.01 then
            vel = flightDir.Unit * speed
        end
    end

    if hum.Jump or UIS:IsKeyDown(Enum.KeyCode.Space) then
        vel = vel + Vector3.new(0, speed, 0)
    end
    if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
        vel = vel - Vector3.new(0, speed, 0)
    end

    if FlyBodyVel then FlyBodyVel.Velocity = vel end
    if FlyBodyGyro and cam then FlyBodyGyro.CFrame = cam.CFrame end
end


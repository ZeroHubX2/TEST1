        goal = RetreatPoint
    elseif Target and (Target.point or (Target.part and Target.part.Parent)) then
        OrbitAngle = (OrbitAngle + Options.OrbitSpeed.Value * dt) % 360
        goal = goalFor(Target)
        faceTowards = (not Target.waypoint) and Target.part.Position or goal
        HoldPos = nil
    elseif RunActive then
        if not HoldPos then
            HoldPos = hrp.Position
            if HoldPos.Y < -3000 then
                local spawns = workspace:FindFirstChild("World") and workspace.World:FindFirstChild("Spawns")
                local sp = spawns and spawns:GetChildren()[1]
                HoldPos = (sp and sp:IsA("BasePart")) and (sp.Position + Vector3.new(0, 4, 0)) or HoldPos
            end
        end
        goal = HoldPos
    else
        HoldPos = nil
        return
    end

    local cur = hrp.Position
    local delta = goal - cur
    local step = Options.TweenSpeed.Value * dt
    local newPos = (delta.Magnitude <= step) and goal or (cur + delta.Unit * step)
    if delta.Magnitude > 1500 or cur.Y < -3000 then newPos = goal end

    local look = hrp.CFrame.LookVector
    if Target and Target.rubble and not Retreating then
        look = -Target.face
    elseif faceTowards then
        local flat = Vector3.new(faceTowards.X - newPos.X, 0, faceTowards.Z - newPos.Z)
        if flat.Magnitude > 0.1 then look = flat.Unit end
    end
    look = Vector3.new(look.X, 0, look.Z)
    if look.Magnitude < 0.01 then look = Vector3.new(0, 0, -1) end
    look = look.Unit

    local aimAt = not Retreating and Target and not Target.waypoint and not Target.rubble
        and Options.AimAtTarget.Value and faceTowards
    if aimAt and (faceTowards - newPos).Magnitude > 0.5 then
        local dir = (faceTowards - newPos).Unit
        local up = math.abs(dir.Y) > 0.98 and look or Vector3.yAxis
        hrp.CFrame = CFrame.lookAt(newPos, faceTowards, up)
    else
        hrp.CFrame = CFrame.lookAt(newPos, newPos + look)
    end
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
end)

local function combatTick(hrp)
    if not Target or Target.waypoint or Retreating then
        setAttack(false)
        return
    end
    if Options.AutoAim.Value then releaseAim() end

    local maxDist = Options.CastRange.Value
    if Target.gateDefend or (Stage and Stage.floodEscape) then
        maxDist = math.max(maxDist, 45)
    end
    local dist = targetDistance(Target, hrp.Position)
    if dist > maxDist then
        setAttack(false)
        return
    end

    setAttack(true)

    -- boss immune: keep pressing skills 1-3 (no waiting); only hold the ultimate back
    local bossImmuneNow = Target.boss and isBossImmune()
    if not Options.AutoSkills.Value then return end
    if os.clock() - LastSkillAt < Options.SkillInterval.Value then return end
    LastSkillAt = os.clock()

    local selected = Options.Skills.Value
    local function skillOn(name)
        if not selected then return false end
        if selected[name] == true then return true end
        for k, v in pairs(selected) do
            if v == name or k == name then return true end
        end
        return false
    end

    local ultReady = skillOn("Ultimate")
        and ultProgress() >= 100
        and not LocalPlayer:GetAttribute("UltimateLocked")
    local ultAllowed = ultReady and not bossImmuneNow and (not Options.UltBossOnly.Value or Target.boss)

    local ultFirst = ultAllowed and Options.UltPriority.Value and Target.boss
    if ultFirst and cast(4) then
        addLog("Ultimate on " .. displayName(Target.name))
        return
    end

    local order = {}
    for i = 1, 3 do
        if skillOn("Skill " .. i) then table.insert(order, i) end
    end
    if ultAllowed and not ultFirst then table.insert(order, 4) end
    if #order == 0 then return end

    SkillCursor = SkillCursor % #order + 1
    local slot = order[SkillCursor]
    if cast(slot) and slot == 4 then
        addLog("Ultimate on " .. displayName(Target.name))
    end
end

local function failsafeTick(hum, hrp)
    if not Options.AutoFarm.Value then
        Retreating = false
        return
    end
    local pct = hum.Health / math.max(hum.MaxHealth, 1) * 100
    if not Retreating and Options.Retreat.Value and pct < Options.RetreatBelow.Value then
        Retreating = true
        RetreatStartedAt = os.clock()
        RetreatPoint = hrp.Position + Vector3.new(0, Options.RetreatHeight.Value, 0)
        setAttack(false)
        addLog(string.format("HP %d%%, retreating", pct))
    elseif Retreating then
        local timedOut = os.clock() - RetreatStartedAt > Options.MaxRetreat.Value
        if pct >= Options.BackAt.Value or timedOut or not Options.Retreat.Value then
            Retreating = false
            addLog(timedOut and "Retreat timed out, back to fight" or string.format("HP %d%%, back to fight", pct))
        end
    end
end

local function runTick(st)
    local pg = LocalPlayer.PlayerGui

    local sv = pg:FindFirstChild("StartVote")
    local voteOpen = sv and sv.Enabled and sv:FindFirstChild("Holder") and sv.Holder.Visible
    if Options.AutoStart.Value and voteOpen and os.clock() - LastStartVote > 1.5 then
        LastStartVote = os.clock()
        manualActions.start()
    end

    local es = pg:FindFirstChild("EndScreen")
    if es and es.Enabled then
        EndSeenAt = EndSeenAt or os.clock()
        if os.clock() - EndSeenAt >= Options.EndDelay.Value and os.clock() - LastEndAction > 3 then
            local code
            if Options.AutoNext.Value and st.canNext then
                code = 2
            elseif Options.AutoRetry.Value then
                code = 1
            elseif Options.AutoLeave.Value then
                code = 3
            end
            if code then
                LastEndAction = os.clock()
                manualActions.endAction(code)
            end
        end
    else
        EndSeenAt = nil
    end
end

local StatusColors = {
    active = UC.Good, victory = UC.Good, voting = UC.Warn, vote = UC.Warn,
    defeat = UC.Bad, failed = UC.Bad, lost = UC.Bad,
}
local LastCharName = nil
local function dashboardApply(s)
    local status = s.status
    local live = status == "active"
    local main
    if live and s.trials then
        main = string.format("Floor %d  ·  Wave %s/%s", s.trials.room, s.wave, s.waveCount)
    elseif live and s.floodEscape then
        local fl = tonumber(workspace:GetAttribute("FloodFloor")) or 0
        local ph = tostring(workspace:GetAttribute("FloodPhase") or "fight"):upper()
        local gt = tonumber(workspace:GetAttribute("FloodGate")) or 0
        if workspace:GetAttribute("FloodRoof") == true or fl > 11 then
            main = string.format("Roof (Bosses)  ·  Left %s", s.remaining)
        elseif ph == "BLOCK" then
            main = string.format("Floor %d/11  ·  Gate %d%%", fl, math.floor(gt * 100))
        elseif ph == "DRAIN" then
            main = string.format("Floor %d/11  ·  Climb!", fl)
        else
            main = string.format("Floor %d/11  ·  Enemies %s", fl, s.remaining)
        end
    elseif live and s.infinite then
        main = "Wave " .. s.wave
    elseif live then
        main = string.format("Area %s/%s  ·  Wave %s/%s", s.area, s.areaCount, s.wave, s.waveCount)
    else
        main = status:sub(1, 1):upper() .. status:sub(2)
    end
    local sub
    if s.retreating then
        sub = "Retreating until HP recovers"
    elseif Options.AutoFarm.Value and live then
        sub = string.format("Target: %s  ·  Enemies left %s", s.target, s.remaining)
    elseif Options.AutoFarm.Value then
        sub = "Auto Farm is on, waiting for the run to start"
    else
        sub = "Auto Farm is off"
    end
    if s.trials then sub = string.format("Cleared %d  ·  Best %d  ·  ", s.trials.cleared, s.trials.best) .. sub end
    Hero:Set({ main = main, sub = s.stage .. "  ·  " .. sub, badge = string.upper(status), badgeColor = StatusColors[status] or UC.Sub })
    local hp = s.hp
    local hpCol = hp < Options.RetreatBelow.Value and UC.Bad or (hp < Options.BackAt.Value and UC.Warn or UC.Good)
    Hero:SetBar(1, "Health", hp, hpCol)
    Hero:SetBar(2, "Ultimate", math.clamp(s.ult, 0, 100), nil)

    if s.charName ~= LastCharName then
        LastCharName = s.charName
        Window:SetProfile(s.charName and ("Playing " .. s.charName) or ("@" .. LocalPlayer.Name))
    end
end

local LastStatusAt = 0
local function statusTick(st, hum)
    if os.clock() - LastStatusAt < 0.5 then return end
    LastStatusAt = os.clock()

    local hp = hum and math.floor(hum.Health / math.max(hum.MaxHealth, 1) * 100) or 0
    local ult = ultProgress()
    local charName = currentCharacterName()
    local tgt = "none"
    if Target then
        tgt = Target.waypoint and ("walking to " .. Target.name) or displayName(Target.name)
        if Target.boss then tgt = tgt .. " [BOSS]" end
        if Target.rubble then tgt = "rubble wall" end
        if Target.gateDefend then tgt = displayName(Target.name) .. " [DEFEND GATE]" end
        if not Target.waypoint and Target.maxHealth and Target.maxHealth > 1 then
            tgt = tgt .. string.format(" %d/%d", Target.health, Target.maxHealth)
        end
    end
    local aimList = {}
    for slot in pairs(AimSkills) do table.insert(aimList, slot == 4 and "Ult" or ("Skill " .. slot)) end
    table.sort(aimList)
    local statusText = string.format(
        "HP %d%%%s | Ult %d%%\nTarget: %s\nMouse-aim skills: %s",
        hp, Retreating and " (retreating)" or "", ult, tgt,
        #aimList > 0 and table.concat(aimList, ", ") or "none yet")
    local runText = string.format(
        "Status: %s | Area %s/%s | Wave %s/%s | Enemies left %s | Next allowed: %s",
        tostring(st.status), tostring(st.area), tostring(st.areaCount),
        tostring(st.wave), tostring(st.waveCount), tostring(st.remaining),
        st.canNext and "yes" or "no")
    local logText = #LogBuffer > 0 and table.concat(LogBuffer, "\n", 1, math.min(25, #LogBuffer)) or nil
    local stageText = describeStage()
    local snap = {
        stage = Stage.name .. " · " .. Stage.kind, infinite = Stage.kind == "Infinite",
        trials = Stage.trials and trialsInfo() or nil,
        floodEscape = Stage.floodEscape,
        status = tostring(st.status or "idle"),
        area = tostring(st.area), areaCount = tostring(st.areaCount),
        wave = tostring(st.wave), waveCount = tostring(st.waveCount),
        remaining = tostring(st.remaining or 0),
        retreating = Retreating, target = tgt, hp = hp, ult = tonumber(ult) or 0,
        charName = charName and tostring(charName) or nil,
    }

    onUi(function()
        StatusParagraph:SetDesc(statusText)
        StageParagraph:SetDesc(stageText)
        RunParagraph:SetDesc(runText)
        if logText then LogParagraph:SetDesc(logText) end
        dashboardApply(snap)
    end)
end


        }, hit)
        round(track)
        local fill = inst("Frame", { Name = "Fill", BorderSizePixel = 0, BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.fromScale(0, 1) }, track)
        round(fill)
        local grad = inst("UIGradient", {}, fill)
        local knob = inst("Frame", {
            Name = "Knob", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5),
            Size = UDim2.fromOffset(16, 16), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 3,

    local function makeOption(id, kind, cfg)
        local opt = { Type = kind, Value = nil, _cbs = {}, Title = cfg.Title }
        function opt:OnChanged(fn) table.insert(self._cbs, fn) end
        function opt:_fire()
            if cfg.Callback then task.spawn(safe, cfg.Callback, self.Value) end
            for _, fn in ipairs(self._cbs) do task.spawn(safe, fn, self.Value) end
            if not self.NoSave and Lib.QueueSave then Lib:QueueSave() end
        end
        if id then Lib.Options[id] = opt end
        return opt
    end


    -- Read shop data directly from memory/config
    refreshShopData = function()
        if not getModules() then return end
        local store = acc.getLocalPlayerAccount()
        pcall(function() if restoreIdentity then restoreIdentity() end end)
        local state = store and store.state
        if not state then return end

        local now = workspace:GetServerTimeNow()
        local day = shopCfg.GetDay(now)
        local stockIds = shopCfg.GetStock(day)
        if not stockIds or #stockIds == 0 then return end

        local lines = {}
        local dropdownList = {}
        local newMap = {}
        local newList = {}

        for _, rawId in ipairs(stockIds) do
            local sId = tostring(rawId)
            local def = matCfg[sId]
            local tier = (def and def.Tier) or shopCfg.GetTier(sId) or "1"
            local cap = shopCfg.GetCap(sId) or 0
            local price = shopCfg.GetPrice(sId) or 0
            local rarity = (rBox and rBox.Resolve and rBox.Resolve("material", sId)) or ("Tier " .. tostring(tier))

            local key = shopCfg.GetKey(day, sId)
            local bought = 0
            if state.achievements and state.achievements.progress then
                local pNode = state.achievements.progress:get(key)
                if pNode then
                    bought = (typeof(pNode) == "table" and pNode.get and pNode:get()) or (typeof(pNode) == "number" and pNode) or (pNode.current) or 0
                end
            end
            local left = math.max(0, cap - (tonumber(bought) or 0))

            local owned = 0
            if state.material then
                local mNode = state.material:get(sId)
                if mNode then
                    owned = (typeof(mNode) == "table" and mNode.get and mNode:get()) or (typeof(mNode) == "number" and mNode) or (mNode.current) or 0
                end
            end

            local itemName = def and def.Name or sId
            local itemInfo = {
                id = sId,
                name = itemName,
                tier = tier,
                rarity = rarity,
                cap = cap,
                bought = bought,
                left = left,
                price = price,
                owned = owned
            }
            newMap[sId] = itemInfo
            table.insert(newList, itemInfo)

            local statusStr = left > 0 and string.format("Stock: %d/%d", left, cap) or "[Sold Out] 0/" .. tostring(cap)
            local line = string.format("• %s [%s] — %s ($%s) | Owned: %s", itemName, rarity, statusStr, formatNumber(price), formatNumber(owned))
            table.insert(lines, line)

            local optStr = string.format("[%s] %s [%s] - Stock: %d/%d ($%s)", sId, itemName, rarity, left, cap, formatNumber(price))
            table.insert(dropdownList, optStr)

            -- Sync legacy tables
            ZeroX.ShopIds[itemName] = sId
            ZeroX.ShopStock[itemName] = string.format("%d/%d", left, cap)
        end

        itemDataMap = newMap
        currentItemsList = newList

        onUi(function()
            if ShopItems then
                ShopItems:SetDesc(#lines > 0 and table.concat(lines, "\n") or "No items on sale")
            end

            if Options.ShopBuyItem and #dropdownList > 0 then
                local curVal = tostring(Options.ShopBuyItem.Value or "")
                local curId = curVal:match("^%[(%d+)%]")

                Options.ShopBuyItem:SetValues(dropdownList)

                -- Preserve selected item by ID if possible
                local matchedOpt = nil
                if curId then
                    for _, opt in ipairs(dropdownList) do
                        if opt:match("^%[" .. curId .. "%]") then
                            matchedOpt = opt
                            break
                        end
                    end
                end
                if matchedOpt then
                    if Options.ShopBuyItem.Value ~= matchedOpt then
                        Options.ShopBuyItem:SetValue(matchedOpt)
                    end
                else
                    Options.ShopBuyItem:SetValue(dropdownList[1])
                end
            end

            updateSelectedInfo()
        end)
    end

    Options.ShopBuyItem:OnChanged(function(v)

        Lib.WinState = {}
        local function refit()
            local vp = viewport()
            local w, h = math.max(body.Size.X.Offset, 1), math.max(body.Size.Y.Offset, 1)
            Lib._baseScale = math.clamp(math.min((vp.X - 24) / w, (vp.Y - 24) / h, 1), 0.35, 1)
            if not Lib._animWin then fit.Scale = Lib._baseScale end
        end
        local function clampPos()
            local vp = viewport()
            local p = body.Position
            local cx, cy = p.X.Scale * vp.X + p.X.Offset, p.Y.Scale * vp.Y + p.Y.Offset
            local hw, hh = body.AbsoluteSize.X / 2, body.AbsoluteSize.Y / 2
            local nx = (hw * 2 >= vp.X) and vp.X / 2 or math.clamp(cx, hw, vp.X - hw)
            local ny = (hh * 2 >= vp.Y) and vp.Y / 2 or math.clamp(cy, hh, vp.Y - hh)
            if math.abs(nx - cx) > 0.5 or math.abs(ny - cy) > 0.5 then
                body.Position = UDim2.fromOffset(nx, ny)
            end
        end
        local function snapshot()
            local sz, p = body.Size, body.Position
            Lib.WinState.size = { sz.X.Offset, sz.Y.Offset }
            Lib.WinState.pos = { p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset }
        end
        task.delay(1.5, function() W.ready = true end)
        local function track()
            if not W.ready or Lib._folding then return end
            snapshot()
            if Lib.QueueSave then Lib:QueueSave() end
        end
        connect(body:GetPropertyChangedSignal("Size"), function()
            refit()
            layoutHeader()
            if W.active then queue(W.active) end
            track()
        end)
        connect(body:GetPropertyChangedSignal("Position"), track)
        if workspace.CurrentCamera then
            connect(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"), function()
                refit()
                task.defer(clampPos)
            end)
        end
        Lib.ApplyWindowState = function(data)
            task.delay(0.1, function()
                if type(data.__size) == "table" then
                    local w, h = tonumber(data.__size[1]), tonumber(data.__size[2])
                    if w and h then body.Size = UDim2.fromOffset(math.max(w, 420), math.max(h, 280)) end
                end
                if type(data.__pos) == "table" then
                    local a = data.__pos
                    body.Position = UDim2.new(tonumber(a[1]) or 0.5, tonumber(a[2]) or 0, tonumber(a[3]) or 0.5, tonumber(a[4]) or 0)
                end
                if type(data.__btn) == "table" and Lib.PlaceToggleButton then Lib.PlaceToggleButton(data.__btn) end
                refit()
                task.defer(clampPos)
                snapshot()
            end)
        end


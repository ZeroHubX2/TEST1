local function normalizeBranch(val)
    if not val or val == "None" then return nil end
    if string.find(val, "ATK") then return "ATK" end
    if string.find(val, "CRIT") then return "CRIT" end
    if string.find(val, "DEF") then return "DEF" end
    if string.find(val, "SPD") then return "SPD" end
    return val
end

local function getSkillPriorities()
    local p = {}
    local seen = {}
    for _, opt in ipairs({ Options.SkillPrio1, Options.SkillPrio2, Options.SkillPrio3, Options.SkillPrio4 }) do
        local val = opt and opt.Value
        local b = normalizeBranch(val)
        if b and not seen[b] then
            table.insert(p, b)
            seen[b] = true
        end
    end
    if #p == 0 then p = { "ATK", "CRIT", "DEF", "SPD" } end
    return p
end

local function updateSkillTreeStatus(optSelected)
    restoreIdentity()
    local RS = game:GetService("ReplicatedStorage")
    local acc, clp, charsMod
    pcall(function() acc = require(RS.global.stores.accountNamespace) end)
    pcall(function() clp = require(RS.global.utils.characterLevelProgression) end)
    pcall(function() charsMod = require(RS.global.constants.characters) end)
    local charsByName = charsMod and charsMod.charactersByName
    local store = acc and acc.getLocalPlayerAccount()
    restoreIdentity()
    local state = store and store.state
    if not (state and state.CharactersData and clp) then
        if SkillStatus then SkillStatus:SetDesc("Loading account data...") end
        return
    end

    local selected = optSelected or (Options.SkillTargetChar and Options.SkillTargetChar.Value) or "Equipped (Active)"
    local targetId = getTargetCharId(selected)
    restoreIdentity()

    if targetId == "ALL" then
        local totalTokens = 0
        local totalChars = 0
        local owned = getOwnedCharacterIds(state)
        for _, cid in ipairs(owned) do
            local data = state.CharactersData and state.CharactersData[cid]
            if data and data.Progression then
                totalChars = totalChars + 1
                local xp = data.Progression.Xp and (data.Progression.Xp.get and data.Progression.Xp:get() or data.Progression.Xp.current) or 0
                local s = {}
                for _, b in ipairs({ "ATK", "CRIT", "DEF", "SPD" }) do
                    local sv = data.Progression.Skills and data.Progression.Skills[b]
                    s[b] = (sv and (sv.get and sv:get() or sv.current)) or 1
                end
                totalTokens = totalTokens + clp.getAvailableTokens(cid, xp, s)
            end
        end
        local cur = state.character and (state.character.get and state.character:get() or state.character.current or state.character) or "?"
        local def = charsByName and charsByName[cur]
        local dname = def and def.displayName or cur
        local desc = string.format("All Characters | Total Tokens: %d | Owned: %d\nEquipped: %s (%s)", totalTokens, totalChars, dname, cur)
        if SkillStatus then SkillStatus:SetDesc(desc) end
    else
        local charId = targetId
        local data = charId and state.CharactersData and state.CharactersData[charId]
        if data and data.Progression then
            local def = charsByName and charsByName[charId]
            local dname = def and def.displayName or charId
            local xp = data.Progression.Xp and (data.Progression.Xp.get and data.Progression.Xp:get() or data.Progression.Xp.current) or 0
            local s = {}
            for _, b in ipairs({ "ATK", "CRIT", "DEF", "SPD" }) do
                local sv = data.Progression.Skills and data.Progression.Skills[b]
                s[b] = (sv and (sv.get and sv:get() or sv.current)) or 1
            end
            local tok = clp.getAvailableTokens(charId, xp, s)
            local desc = string.format("Hero: %s (%s) | Tokens: %d\nATK: T%d | CRIT: T%d | DEF: T%d | SPD: T%d",
                dname, charId, tok, s.ATK, s.CRIT, s.DEF, s.SPD)
            if SkillStatus then SkillStatus:SetDesc(desc) end
        else
            if SkillStatus then SkillStatus:SetDesc("Character not found: " .. tostring(charId)) end
        end
    end
    restoreIdentity()
end

local function getTierCost(cid, branch, tier)
    local RS = game:GetService("ReplicatedStorage")
    local ok, cfg = pcall(function() return require(RS.assets.config.characterSkillTreeConfig) end)
    if ok and cfg and cfg.characters and cfg.characters[cid] and cfg.characters[cid].branches and cfg.characters[cid].branches[branch] then
        local t = cfg.characters[cid].branches[branch].tiers[tier]
        if t and t.cost then return t.cost end
    end
    local defaultCosts = { [1] = 0, [2] = 1, [3] = 5, [4] = 9, [5] = 11 }
    return defaultCosts[tier] or 999
end

local function runSkillTreeUpgrade()
    local RS = game:GetService("ReplicatedStorage")
    local acc, clp, packets
    local ok1 = pcall(function() acc = require(RS.global.stores.accountNamespace) end)
    local ok2 = pcall(function() clp = require(RS.global.utils.characterLevelProgression) end)
    local ok3 = pcall(function() packets = require(RS.lobby.modules.skillTree.skillTreePackets) end)
    restoreIdentity()
    if not (ok1 and ok2 and ok3 and acc and clp and packets and packets.purchaseCharacterSkill) then
        updateSkillTreeStatus()
        return
    end

    local store = acc.getLocalPlayerAccount()
    restoreIdentity()
    local state = store and store.state
    if not (state and state.CharactersData) then return end

    local selected = Options.SkillTargetChar and Options.SkillTargetChar.Value
    local targetId = getTargetCharId(selected)
    if not targetId then return end

    local targets = {}
    if targetId == "ALL" then
        local owned = getOwnedCharacterIds(state)
        for _, cid in ipairs(owned) do
            table.insert(targets, cid)
        end
    else
        table.insert(targets, targetId)
    end

    local prios = getSkillPriorities()

    local function upgradeChar(cid)
        for _ = 1, 100 do
            local data = state.CharactersData and state.CharactersData[cid]
            if not data or not data.Progression then break end
            local xp = data.Progression.Xp and (data.Progression.Xp.get and data.Progression.Xp:get() or data.Progression.Xp.current) or 0
            local s = {}
            for _, b in ipairs({ "ATK", "CRIT", "DEF", "SPD" }) do
                local sv = data.Progression.Skills and data.Progression.Skills[b]
                s[b] = (sv and (sv.get and sv:get() or sv.current)) or 1
            end
            local avail = clp.getAvailableTokens(cid, xp, s)
            if avail <= 0 then break end

            local upgraded = false
            for _, branch in ipairs(prios) do
                local curTier = s[branch] or 1
                if curTier < 5 then
                    local cost = getTierCost(cid, branch, curTier + 1)
                    if cost and avail >= cost then
                        local req = {
                            character = cid,
                            branch = branch,
                            tier = curTier + 1,
                            requestId = math.random(1, 65535),
                        }
                        pcall(function() packets.purchaseCharacterSkill:fire(req) end)
                        restoreIdentity()
                        
                        local oldTier = curTier
                        for _ = 1, 10 do
                            task.wait(0.1)
                            local sv = data.Progression.Skills and data.Progression.Skills[branch]
                            local checkedTier = (sv and (sv.get and sv:get() or sv.current)) or 1
                            if checkedTier > oldTier then break end
                        end
                        upgraded = true
                        break
                    end
                end
            end
            if not upgraded then break end
        end
    end

    for _, cid in ipairs(targets) do
        upgradeChar(cid)
    end

    updateSkillTreeStatus()
end
upgradeSkillsNow.fn = function() task.spawn(runSkillTreeUpgrade) end


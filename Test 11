            local col = ncfg.Color or accent()
            local key = tostring(ncfg.Group or Lib._activeTab or Lib.Name)
            if key == "" then key = Lib.Name end
            local g = getGroup(key, ncfg.Icon or "info", col)
            local card = inst("CanvasGroup", {
                BackgroundColor3 = Color3.fromRGB(22, 22, 27), BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0),
                Size = UDim2.new(1, 0, 0, CH), Position = UDim2.new(0.5, 0, 0, Lib.FX and CH + 40 or 0), GroupTransparency = Lib.FX and 1 or 0, ZIndex = 20,
            }, g.stack)
            round(card, 18)
            local cst = stroke(card, 0.85)
            local cscale = inst("UIScale", { Scale = Lib.FX and 0.9 or 1 }, card)
            local tile = inst("Frame", { BackgroundColor3 = col, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 14, 0.5, 0), Size = UDim2.fromOffset(40, 40) }, card)
            round(tile, 12)
            inst("UIGradient", { Rotation = 45, Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 170)) }, tile)
            local ti = icon(ncfg.Icon or "info", 19, tile, Color3.new(1, 1, 1))
            ti.AnchorPoint = Vector2.new(0.5, 0.5)
            ti.Position = UDim2.fromScale(0.5, 0.5)
            text({
                Text = tostring(ncfg.Title or Lib.Name), FontFace = F.Bold, TextSize = 15, TextColor3 = Color3.new(1, 1, 1),
                Position = UDim2.fromOffset(66, 14), Size = UDim2.new(1, -120, 0, 19), TextTruncate = Enum.TextTruncate.AtEnd,
            }, card)
            text({
                Text = "now", FontFace = F.Med, TextSize = 11, TextColor3 = C.Dim, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 16),
                Size = UDim2.fromOffset(50, 14), TextXAlignment = Enum.TextXAlignment.Right,
            }, card)
            text({
                Text = tostring(ncfg.Content or ""), FontFace = F.Med, TextSize = 13, TextColor3 = Color3.fromRGB(175, 175, 185),
                Position = UDim2.fromOffset(66, 36), Size = UDim2.new(1, -82, 0, 17), TextTruncate = Enum.TextTruncate.AtEnd,
            }, card)
            local bar = inst("Frame", { BackgroundColor3 = col, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 18, 1, -1), Size = UDim2.new(1, -36, 0, 2) }, card)
            round(bar)
            local hit = inst("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 5 }, card)
            local c = { frame = card, scale = cscale }
            table.insert(g.cards, c)
            while #g.cards > 6 do removeCard(g, g.cards[1]) end
            hit.MouseButton1Click:Connect(function() removeCard(g, c) end)
            hit.MouseEnter:Connect(function() tw(cst, 0.15, { Color = col, Transparency = 0.4 }) end)
            hit.MouseLeave:Connect(function() tw(cst, 0.2, { Color = C.Line, Transparency = 0.85 }) end)
            relayoutGroup(g)
            if Lib.FX then
                ease(card, 0.55, { Position = UDim2.new(0.5, 0, 0, 0), GroupTransparency = 0 }, Enum.EasingStyle.Back)
                ease(cscale, 0.55, { Scale = 1 }, Enum.EasingStyle.Back)
                local ts = inst("UIScale", { Scale = 0.4 }, tile)
                task.delay(0.15, function() ease(ts, 0.45, { Scale = 1 }, Enum.EasingStyle.Back) end)
            end
            local dur = tonumber(ncfg.Duration) or 4
            TweenService:Create(bar, TweenInfo.new(dur, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 2) }):Play()
            task.delay(dur, function() removeCard(g, c) end)
        end)
    end

    function Lib:Destroy()
        if Lib.Unloaded then return end
        Lib.Unloaded = true
        for _, c in ipairs(Lib.Conns) do pcall(function() c:Disconnect() end) end
        Lib.Conns = {}
        pcall(function() gui:Destroy() end)
        pcall(function() top:Destroy() end)
        pcall(function() if sfxFolder then sfxFolder:Destroy() end end)
        if Lib.OnDestroy then pcall(Lib.OnDestroy) end
    end

    return Lib
end)()


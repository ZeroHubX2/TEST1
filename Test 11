    local function getOwnedCharacterEntries(st)
        local entries = {}
        local seen = {}
        if not st then return entries end

        if st.UnlockedCharacters then
            for slotName, slotData in pairs(st.UnlockedCharacters) do
                local slotNum = tonumber(slotName:match("Slot(%d+)"))
                if slotNum and type(slotData) == "table" then
                    local isUnlocked = slotData.Unlocked
                    if type(isUnlocked) == "table" then
                        isUnlocked = isUnlocked.get and isUnlocked:get() or isUnlocked.current
                    end
                    local charId = slotData.Character
                    if type(charId) == "table" then
                        charId = charId.get and charId:get() or charId.current
                    end
                    if isUnlocked and type(charId) == "string" and charId ~= "" and charId ~= "_order" and charId ~= "_dirty" then
                        table.insert(entries, {
                            slotNum = slotNum,
                            cid = charId,
                            source = "slot"
                        })
                        seen[charId] = true
                    end
                end
            end
        end

        table.sort(entries, function(a, b) return a.slotNum < b.slotNum end)

        if st.items and st.items.entries then
            for _, itemData in pairs(st.items.entries) do
                local itemObj = itemData.Item
                local itemVal = itemObj and (itemObj.get and itemObj:get() or itemObj.current or itemObj)
                if type(itemVal) == "string" and itemVal:sub(1, 5) == "unit." then
                    local cid = itemVal:sub(6)
                    if cid ~= "" and not seen[cid] then
                        table.insert(entries, {
                            slotNum = 9999,
                            cid = cid,
                            source = "storage"
                        })
                        seen[cid] = true
                    end
                end
            end
        end

        local cur = st.character and (st.character.get and st.character:get() or st.character.current or st.character)
        if type(cur) == "string" and cur ~= "" and not seen[cur] then
            table.insert(entries, {
                slotNum = 99999,
                cid = cur,
                source = "equipped"
            })
            seen[cur] = true
        end

        return entries
    end

    local function getOwnedCharacterIds(st)
        local entries = getOwnedCharacterEntries(st)
        local ids = {}
        for _, e in ipairs(entries) do
            table.insert(ids, e.cid)
        end
        return ids
    end

    local function getOwnedCharacterOptions()
        local opts = { "Equipped (Active)", "All Characters" }
        local RS = game:GetService("ReplicatedStorage")
        local acc, charsMod
        pcall(function() acc = require(RS.global.stores.accountNamespace) end)
        pcall(function() charsMod = require(RS.global.constants.characters) end)
        local charsByName = charsMod and charsMod.charactersByName
        local store = acc and acc.getLocalPlayerAccount()
        restoreIdentity()
        local state = store and store.state
        if state then
            local entries = getOwnedCharacterEntries(state)
            for _, e in ipairs(entries) do
                local def = charsByName and charsByName[e.cid]
                local dname = def and def.displayName or e.cid
                local label
